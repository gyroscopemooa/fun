---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Category = 'personality' | 'love' | 'looks' | 'fortune' | 'fun';

const filters: { id: 'all' | Category; label: string }[] = [
  { id: 'all', label: '✨ 전체' },
  { id: 'personality', label: '🧠 성격' },
  { id: 'love', label: '💞 연애·궁합' },
  { id: 'looks', label: '🎨 외모·컬러' },
  { id: 'fortune', label: '🔮 운세' },
  { id: 'fun', label: '🎉 재미' }
];

const tests: { href: string; title: string; desc: string; icon: string; tags: Category[]; accent: string; badge?: string }[] = [
  { href: '/mbti-test', title: 'MBTI 테스트', desc: '20문항으로 알아보는 나의 성향과 연애 스타일', icon: '🧠', tags: ['personality'], accent: '#8B5CF6', badge: '인기' },
  { href: '/love-compatibility', title: '연애 궁합 테스트', desc: '이름·별자리·MBTI로 보는 우리 둘의 궁합', icon: '💞', tags: ['love'], accent: '#F43F5E', badge: '인기' },
  { href: '/love-type-test', title: '연애 유형 테스트', desc: '직진 불도저? 츤데레 고양이? 8가지 연애 유형', icon: '💘', tags: ['love', 'personality'], accent: '#EC4899', badge: 'NEW' },
  { href: '/office-type-test', title: '직장인 유형 테스트', desc: '칼퇴 요정부터 엑셀 장인까지, 나의 일하는 스타일', icon: '💼', tags: ['personality', 'fun'], accent: '#0EA5E9', badge: 'NEW' },
  { href: '/mbti-game-character', title: 'MBTI 게임 캐릭터 궁합', desc: 'MBTI로 찾는 롤·발로란트·오버워치 찰떡 캐릭터', icon: '🎮', tags: ['personality', 'fun'], accent: '#6366F1' },
  { href: '/name-compatibility', title: '이름 궁합 테스트', desc: '두 사람 이름으로 보는 궁합 점수', icon: '📝', tags: ['love'], accent: '#E11D48' },
  { href: '/friend-type-test', title: '친구 유형 테스트', desc: '친구들 사이에서 나는 어떤 역할일까?', icon: '🤝', tags: ['personality', 'fun'], accent: '#F59E0B' },
  { href: '/personal-color', title: '퍼스널컬러 자가진단', desc: '사진 한 장으로 12톤 중 가까운 톤 찾기', icon: '🎨', tags: ['looks'], accent: '#F97316' },
  { href: '/ai-personal-color', title: 'AI 퍼스널컬러 분석', desc: '베스트 컬러·메이크업·헤어까지 정밀 리포트', icon: '📷', tags: ['looks'], accent: '#DB2777' },
  { href: '/lip-color-simulator', title: '립 컬러 시뮬레이터', desc: '카메라로 립 컬러를 가상으로 발라 보기', icon: '💄', tags: ['looks'], accent: '#BE123C' },
  { href: '/animal-test', title: '동물상 테스트', desc: '사진 한 장으로 보는 나의 동물상', icon: '🐶', tags: ['looks', 'fun'], accent: '#A16207' },
  { href: '/face-shape-test', title: '얼굴형 테스트', desc: '간단한 체크로 내 얼굴형 알아보기', icon: '🙂', tags: ['looks'], accent: '#0D9488' },
  { href: '/today-lucky-color', title: '오늘의 행운 컬러', desc: '날짜·생일로 보는 오늘의 행운 색', icon: '🍀', tags: ['fortune', 'looks'], accent: '#16A34A' },
  { href: '/today-fortune', title: '오늘의 운세', desc: '가볍게 확인하는 오늘 하루 운세', icon: '🔮', tags: ['fortune'], accent: '#7C3AED' },
  { href: '/fortune-card', title: '오늘의 운세 카드', desc: '카드 한 장으로 뽑는 오늘의 메시지', icon: '🃏', tags: ['fortune'], accent: '#9333EA' },
  { href: '/fortune-cookie-2026', title: '올해 포츈쿠키', desc: '쿠키를 깨서 올해의 한마디 받기', icon: '🥠', tags: ['fortune', 'fun'], accent: '#D97706' },
  { href: '/past-life-test', title: '전생 직업 테스트', desc: '전생에 나는 어떤 일을 했을까?', icon: '⏳', tags: ['fun'], accent: '#78716C' },
  { href: '/villain-test', title: '영화 속 악역 테스트', desc: '내가 영화 속 악역이라면 어떤 스타일일까?', icon: '🦹', tags: ['fun', 'personality'], accent: '#DC2626' },
  { href: '/food-taste-test', title: '음식 취향 테스트', desc: '입맛으로 보는 나의 음식 성향', icon: '🍜', tags: ['fun'], accent: '#EA580C' },
  { href: '/name-character', title: '이름 캐릭터 생성기', desc: '이름으로 만드는 나만의 캐릭터', icon: '🧙', tags: ['fun'], accent: '#2563EB' },
  { href: '/balance-game', title: '밸런스 게임', desc: '둘 중 하나만 고른다면?', icon: '⚖️', tags: ['fun'], accent: '#475569' },
  { href: '/ideal-world-cup', title: '음식 이상형 월드컵', desc: '토너먼트로 찾는 최애 음식', icon: '🏆', tags: ['fun'], accent: '#CA8A04' }
];

const flow = [
  { href: '/mbti-test', step: '1', title: 'MBTI 테스트', desc: '나의 유형 알아보기' },
  { href: '/love-compatibility', step: '2', title: '연애 궁합 보기', desc: '결과가 자동으로 채워져요' },
  { href: '/mbti-game-character', step: '3', title: 'MBTI 게임 캐릭터', desc: '찰떡 캐릭터까지 확인' }
];
---

<Layout
  title="무료 온라인 테스트 모음 | MBTI, 동물상, 궁합 테스트 | ManyTool"
  description="MBTI 테스트, 동물상 테스트, 퍼스널컬러 테스트, 궁합 테스트처럼 무료로 바로 할 수 있는 온라인 테스트를 모아둔 페이지입니다."
  keywords="무료 온라인 테스트, MBTI 테스트, 동물상 테스트, 궁합 테스트, 퍼스널컬러 테스트, 심리 테스트, 연애 유형 테스트, 직장인 유형 테스트"
  image="/og/tests.jpg"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] p-6 text-white shadow-sm sm:p-8" style="background: radial-gradient(circle at 90% 0%, rgba(245,158,11,0.5), transparent 45%), radial-gradient(circle at 0% 100%, rgba(139,92,246,0.5), transparent 50%), #1e1b4b">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">ManyTool Tests</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">무료 온라인 테스트 모음</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-indigo-100 sm:text-base">MBTI, 동물상, 퍼스널컬러, 궁합 테스트를 한 곳에서 제공합니다. 설치 없이 바로 할 수 있는 무료 테스트를 찾는 사용자를 위한 카테고리 페이지입니다.</p>
      <div class="mt-6 grid gap-2 sm:grid-cols-3">
        {flow.map((item) => (
          <a href={item.href} class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/5 p-3 transition hover:bg-white/10">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-sm font-black text-indigo-950">{item.step}</span>
            <span>
              <span class="block text-sm font-black">{item.title}</span>
              <span class="block text-xs text-white/60">{item.desc}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="mt-2 text-xs text-white/50">MBTI 결과는 이 기기에 기억돼서 궁합 테스트에 바로 이어져요. 모든 결과는 링크로 친구에게 공유할 수 있어요.</p>
    </section>
    <AdsterraBanner placement="top" />

    <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-xl font-bold">추천 테스트</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-3">
        <li><a href="/mbti-test" class="flex items-center gap-3 rounded-2xl bg-violet-50 p-4 font-black text-violet-900 transition hover:bg-violet-100"><span class="text-2xl">🧠</span><span class="underline">MBTI 테스트</span></a></li>
        <li><a href="/animal-test" class="flex items-center gap-3 rounded-2xl bg-amber-50 p-4 font-black text-amber-900 transition hover:bg-amber-100"><span class="text-2xl">🐶</span><span class="underline">동물상 테스트</span></a></li>
        <li><a href="/love-compatibility" class="flex items-center gap-3 rounded-2xl bg-rose-50 p-4 font-black text-rose-900 transition hover:bg-rose-100"><span class="text-2xl">💞</span><span class="underline">연애 궁합 테스트</span></a></li>
      </ul>
    </section>

    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-violet-600">All Tests</p>
          <h2 class="mt-1 text-xl font-black text-slate-950">전체 테스트 <span class="text-base text-slate-400">{tests.length}개</span></h2>
        </div>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="테스트 분류">
          {filters.map((f, i) => (
            <button type="button" data-filter={f.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'} class:list={['test-filter-btn rounded-full border px-3.5 py-2 text-sm font-bold transition', i === 0 ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-200 bg-white text-slate-700 hover:border-slate-400']}>
              {f.label}
            </button>
          ))}
        </div>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {tests.map((test) => (
          <a href={test.href} data-tags={test.tags.join(' ')} class="test-card group relative flex gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-2xl" style={`background: ${test.accent}1f`}>{test.icon}</span>
            <span class="min-w-0">
              <span class="block font-black text-slate-950 group-hover:underline">{test.title}</span>
              <span class="mt-0.5 block text-sm leading-5 text-slate-500">{test.desc}</span>
            </span>
            {test.badge ? <span class="absolute right-3 top-3 rounded-full px-2 py-0.5 text-[10px] font-black text-white" style={`background: ${test.badge === 'NEW' ? '#10B981' : test.accent}`}>{test.badge}</span> : null}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-5 text-sm leading-7 text-slate-700 sm:p-6">
      <h2 class="text-lg font-black text-slate-900">테스트를 더 재밌게 즐기는 법</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li>친구와 같은 테스트를 하고 결과 링크를 서로 보내 보세요. 카톡·디스코드에 붙이면 결과 카드가 미리보기로 떠요.</li>
        <li>MBTI 테스트 → 연애 궁합 → MBTI 게임 캐릭터 순서로 하면 결과가 자동으로 이어져요.</li>
        <li>모든 테스트는 로그인 없이 브라우저에서 계산되고, 답변은 서버로 보내지 않아요.</li>
      </ul>
    </section>
    <AdsterraBanner placement="bottom" />
  </main>
  <Footer />
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.test-filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.test-card'));
  const active = 'border-slate-950 bg-slate-950 text-white';
  const idle = 'border-slate-200 bg-white text-slate-700 hover:border-slate-400';
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      buttons.forEach((b) => {
        const on = b === button;
        b.setAttribute('aria-selected', String(on));
        b.className = `test-filter-btn rounded-full border px-3.5 py-2 text-sm font-bold transition ${on ? active : idle}`;
      });
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && !(card.dataset.tags ?? '').split(' ').includes(filter);
      });
    });
  });
</script>
