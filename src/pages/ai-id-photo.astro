---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const apiBase = import.meta.env.PUBLIC_NODE_API_BASE ?? 'http://127.0.0.1:8787';

// Illustrated sample person for the before/after explainer (no real photo needed).
const portrait = ({ bg, tilt = 0, dx = 0, outfit, frame = false }: { bg: string; tilt?: number; dx?: number; outfit: 'casual' | 'suit'; frame?: boolean }) => `
  <svg viewBox="0 0 120 160" xmlns="http://www.w3.org/2000/svg" class="block h-full w-full" preserveAspectRatio="xMidYMid slice">
    ${bg}
    <g transform="translate(${dx} 0) rotate(${tilt} 60 80)">
      ${outfit === 'suit'
        ? '<path d="M14 160 Q16 118 60 112 Q104 118 106 160Z" fill="#1e293b"/><path d="M48 113 L60 140 L72 113 Q60 118 48 113Z" fill="#fff"/><path d="M57 118 L63 118 L62 142 L60 146 L58 142Z" fill="#1d4ed8"/>'
        : '<path d="M14 160 Q16 118 60 112 Q104 118 106 160Z" fill="#f59e0b"/><path d="M50 113 Q60 124 70 113" fill="none" stroke="#b45309" stroke-width="3"/>'}
      <rect x="51" y="92" width="18" height="22" rx="7" fill="#e8b48f"/>
      <ellipse cx="60" cy="70" rx="24" ry="29" fill="#f1c7a5"/>
      <path d="M35 66 Q34 36 60 36 Q87 36 85 66 Q80 50 60 49 Q42 50 35 66Z" fill="#3f2a1d"/>
      <circle cx="51" cy="72" r="2.6" fill="#1f2937"/><circle cx="69" cy="72" r="2.6" fill="#1f2937"/>
      <path d="M53 86 Q60 90 67 86" fill="none" stroke="#b45309" stroke-width="2" stroke-linecap="round"/>
    </g>
    ${frame ? '<rect x="30" y="28" width="60" height="78" rx="26" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-dasharray="5 4"/><line x1="60" y1="20" x2="60" y2="112" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="3 3"/>' : ''}
  </svg>`;

const samples = [
  { label: 'Before', tone: 'text-slate-500', box: 'bg-slate-50', caption: '일반 셀카', svg: portrait({ bg: '<rect width="120" height="160" fill="#c7d2fe"/><rect x="0" y="96" width="120" height="64" fill="#a5b4fc"/><circle cx="98" cy="26" r="14" fill="#fde68a"/><rect x="6" y="18" width="26" height="34" rx="3" fill="#818cf8"/>', tilt: -8, dx: 10, outfit: 'casual' }) },
  { label: 'Step', tone: 'text-sky-700', box: 'bg-sky-50', caption: '배경 정리 + 얼굴 정렬', svg: portrait({ bg: '<rect width="120" height="160" fill="#e0f2fe"/>', outfit: 'casual', frame: true }) },
  { label: 'After', tone: 'text-emerald-700', box: 'bg-emerald-50', caption: '증명사진 규격 결과', svg: portrait({ bg: '<rect width="120" height="160" fill="#ffffff"/>', outfit: 'suit' }) }
];

// Physical sizes in cm; the download converter in the page script renders them at 300 dpi with the same ids.
const sizePresets = [
  { id: 'half', label: '반명함', size: '3×4cm', use: '이력서·학생증·자격증', w: 3, h: 4 },
  { id: 'id', label: '신분증', size: '3.5×4.5cm', use: '주민등록증·운전면허', w: 3.5, h: 4.5 },
  { id: 'card', label: '명함판', size: '5×7cm', use: '사원증·액자', w: 5, h: 7 },
  { id: 'square', label: '정사각', size: '5×5cm', use: '미국 비자 규격 참고', w: 5, h: 5 }
];
---

<Layout
  title="AI 증명사진 생성기 | 셀카로 증명사진 만들기, 온라인 증명사진 편집 | ManyTool"
  description="셀카 업로드 또는 카메라 촬영으로 AI 증명사진 후보 3장을 만들고 비교한 뒤 원하는 1장을 다운로드하는 온라인 증명사진 생성 페이지입니다."
  keywords="AI 증명사진, 증명사진 만들기, 온라인 증명사진, 셀카 증명사진, 3x4 증명사진, 증명사진 편집"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8 pb-28 md:pb-8">
    <section class="overflow-hidden rounded-[28px] border border-sky-100 p-6 sm:p-8" style="background: radial-gradient(circle at 92% 0%, rgba(56,189,248,0.28), transparent 45%), radial-gradient(circle at 0% 100%, rgba(16,185,129,0.18), transparent 45%), #ffffff">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
        <div>
          <p class="inline-flex rounded-full bg-sky-600 px-3 py-1 text-xs font-bold text-white">셀카 → 증명사진</p>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">AI 증명사진 생성기</h1>
          <p class="mt-2 text-slate-600">사진 한 장으로 증명사진 후보를 만들고, 비교해서 원하는 1장을 다운로드할 수 있습니다.</p>
          <div class="mt-4 flex flex-wrap gap-1.5 text-xs font-bold">
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm">📸 업로드·카메라</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm">🧍 얼굴 자동 정렬</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm">⬜ 흰 배경 정리</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm">📐 규격·인화 시트</span>
          </div>
        </div>
        <div class="mx-auto flex items-end gap-3" aria-hidden="true">
          <div class="aspect-[3/4] w-24 -rotate-3 overflow-hidden rounded-2xl border-4 border-white shadow-lg sm:w-28" set:html={samples[0].svg} />
          <span class="mb-10 text-2xl font-black text-sky-500">→</span>
          <div class="aspect-[3/4] w-28 rotate-2 overflow-hidden rounded-2xl border-4 border-white shadow-xl ring-2 ring-emerald-300 sm:w-32" set:html={samples[2].svg} />
        </div>
      </div>
      <div class="mt-5 grid gap-3 text-sm sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <p class="font-bold text-slate-900">기본 상품</p>
          <p class="mt-1 text-slate-600">$9.90 / 후보 3장 / 최종 1장 다운로드</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <p class="font-bold text-slate-900">추가 생성</p>
          <p class="mt-1 text-slate-600">+2($3.90) / +3($4.90) / +7($5.90)</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
          <p class="font-bold text-slate-900">의상 옵션</p>
          <p class="mt-1 text-slate-600">현재 옷 / 정장(무료)</p>
        </div>
      </div>
    </section>
    <AdsterraBanner placement="top" />

    <section class="mt-6 grid gap-4 lg:grid-cols-2">
      <article id="candidate-section" class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-900">1) 사진 입력</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          <label class="cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white">
            사진 업로드
            <input id="file-input" type="file" accept="image/*" class="hidden" />
          </label>
          <button id="camera-start" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700">
            카메라 시작
          </button>
          <button id="camera-capture" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700" disabled>
            촬영
          </button>
          <button id="reset-all" class="rounded-md border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700">
            초기화
          </button>
        </div>
        <label class="mt-2 inline-flex items-center gap-2 text-xs text-slate-600">
          <input id="camera-mirror-fix" type="checkbox" class="h-4 w-4" checked />
          카메라 좌우반전 보정(헷갈리면 ON 유지)
        </label>

        <div class="relative mt-4 overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-3">
          <video id="camera" class="hidden h-64 w-full rounded-lg bg-black object-cover" autoplay playsinline></video>
          <img id="source-preview" alt="원본 미리보기" class="hidden h-64 w-full rounded-lg object-contain" />
          <p id="source-empty" class="text-sm text-slate-500">아직 사진이 선택되지 않았습니다.</p>
          <div class="pointer-events-none absolute inset-3 hidden items-center justify-center" data-guide-overlay>
            <div class="relative h-full w-full rounded-lg">
              <div class="absolute left-1/2 top-[12%] h-[62%] w-[54%] -translate-x-1/2 rounded-[32px] border-2 border-white/95 shadow-[0_0_0_9999px_rgba(15,23,42,0.26)]"></div>
              <div class="absolute left-1/2 top-[28%] h-[8%] w-[38%] -translate-x-1/2 rounded-full border border-dashed border-white/80"></div>
              <div class="absolute left-1/2 top-[12%] h-[62%] -translate-x-1/2 border-l border-dashed border-white/45"></div>
              <div class="absolute left-1/2 top-[31%] w-[54%] -translate-x-1/2 border-t border-dashed border-white/45"></div>
              <div data-live-face-box class="absolute hidden rounded-[26px] border-2 border-emerald-300/95 bg-emerald-400/10 shadow-[0_0_0_1px_rgba(255,255,255,0.18)_inset]"></div>
              <div data-live-face-centerline class="absolute hidden border-l-2 border-dashed border-emerald-200/80"></div>
              <div data-live-eye-line class="absolute hidden border-t-2 border-dashed border-emerald-200/80"></div>
              <div class="absolute inset-x-0 top-3 flex justify-center">
                <span data-live-face-status class="hidden rounded-full bg-slate-900/78 px-3 py-1 text-[10px] font-bold tracking-[0.18em] text-white shadow-sm"></span>
              </div>
              <div class="absolute inset-x-0 bottom-3 flex justify-center">
                <span class="rounded-full bg-slate-900/70 px-3 py-1 text-[10px] font-bold tracking-[0.22em] text-white">얼굴을 프레임 안에 맞춰주세요</span>
              </div>
            </div>
          </div>
        </div>
        <div id="upload-guidance" class="mt-3 hidden rounded-xl border p-3 text-xs"></div>
        <div id="pc-adjust-panel" class="mt-3 hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="font-bold text-slate-900">PC 업로드 위치 조절</p>
              <p class="mt-1 text-[11px] text-slate-500">얼굴이 치우치면 먼저 위치를 맞춘 뒤 생성하세요.</p>
            </div>
            <button id="pc-adjust-reset" type="button" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-[11px] font-semibold text-slate-700">초기화</button>
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="text-[11px] font-semibold text-slate-600">좌우 이동</span>
              <input id="pc-adjust-x" type="range" min="-120" max="120" value="0" class="mt-2 w-full accent-sky-600" />
            </label>
            <label class="block">
              <span class="text-[11px] font-semibold text-slate-600">상하 이동</span>
              <input id="pc-adjust-y" type="range" min="-160" max="160" value="0" class="mt-2 w-full accent-sky-600" />
            </label>
          </div>
        </div>

        <div class="mt-4">
          <label class="text-sm font-semibold text-slate-700" for="outfit">의상 옵션</label>
          <select id="outfit" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="current">현재 옷</option>
            <option value="suit">정장</option>
          </select>
        </div>

        <div class="mt-4" data-dev-only>
          <label class="text-sm font-semibold text-slate-700" for="provider-select">AI 처리 엔진</label>
          <select id="provider-select" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            <option value="auto">Auto</option>
            <option value="openai_image">ManyTool AI (gpt-image)</option>
            <option value="local_sharp">Local Sharp</option>
            <option value="remove_bg">remove.bg</option>
            <option value="photoroom">PhotoRoom</option>
          </select>
          <p id="provider-help" class="mt-1 text-xs text-slate-500">기본은 Auto입니다. OpenAI 키가 있으면 ManyTool AI(gpt-image)로, 외부 키가 없으면 local_sharp로 생성합니다.</p>
        </div>

        <button id="generate" class="mt-4 w-full rounded-xl bg-sky-600 px-4 py-3 text-sm font-bold text-white shadow-[0_10px_30px_rgba(2,132,199,0.28)] transition hover:-translate-y-0.5 hover:bg-sky-500 active:translate-y-0 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none" disabled>
          증명사진 만들기
        </button>
        <div id="blocking-cta" class="mt-3 hidden rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900"></div>
        <div id="generate-ready" class="mt-3 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-900"></div>
        <div id="assessment-score" class="mt-3 hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-800"></div>

        <section class="mt-4 rounded-2xl border border-sky-100 bg-[linear-gradient(135deg,#eff6ff_0%,#f8fafc_55%,#fefce8_100%)] p-4 text-sm text-slate-700">
          <p class="font-bold text-slate-900">개떡같이 찍어도 최대한 예쁘게 정리되는 방향으로 설계했습니다</p>
          <p class="mt-1">셀카나 업로드 사진을 기준으로 얼굴 위치를 최대한 맞춰 후보를 정리합니다. 원본 구도가 많이 벗어나면 결과 차이가 작을 수 있습니다.</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>모바일/PC 업로드 + 카메라 촬영 지원</li>
            <li>3x4 비율 기준 자동 정렬</li>
            <li>후보 3장 비교 후 1장씩 다운로드</li>
          </ul>
        </section>

        <section class="mt-4 rounded-xl border border-rose-100 bg-rose-50 p-4">
          <h3 class="text-sm font-bold text-slate-900">이런 사진도 먼저 시도해보세요</h3>
          <div class="mt-2 flex flex-wrap gap-2 text-xs font-semibold">
            <span class="rounded-full bg-white px-3 py-1 text-slate-700">정면 셀카</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700">전신 사진</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700">저해상도 사진</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700">스크린샷</span>
          </div>
          <p class="mt-2 text-xs text-slate-600">얼굴이 너무 가려졌거나 옆얼굴이면 품질이 떨어질 수 있습니다. 정면에 가깝고 얼굴이 또렷할수록 더 예쁘게 나옵니다.</p>
        </section>

        <section class="mt-4 rounded-lg border border-slate-200 bg-white p-4">
          <h3 class="text-base font-bold text-slate-900">셀카가 증명사진으로 바뀌는 방식</h3>
          <p class="mt-1 text-xs text-slate-600">아래 예시는 홍보용 샘플 일러스트입니다. 실제 결과는 원본 상태에 따라 달라질 수 있습니다.</p>
          <div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3">
            {samples.map((sample, i) => (
              <article class={`relative rounded-lg border border-slate-200 p-2 sm:p-3 ${sample.box}`}>
                <p class={`text-[11px] font-semibold ${sample.tone}`}>{sample.label}</p>
                <div class="mt-2 aspect-[3/4] overflow-hidden rounded-md border border-black/5 bg-white shadow-sm" set:html={sample.svg} />
                <p class="mt-2 text-[11px] text-slate-600">{sample.caption}</p>
                {i < samples.length - 1 ? <span class="absolute -right-2.5 top-1/2 z-10 hidden h-5 w-5 items-center justify-center rounded-full bg-white text-[11px] font-black text-sky-600 shadow sm:flex">→</span> : null}
              </article>
            ))}
          </div>
          <ol class="mt-3 list-decimal space-y-1 pl-5 text-xs text-slate-700">
            <li>정면 얼굴 자동 감지</li>
            <li>흰 배경/규격 비율 자동 적용</li>
            <li>밝기/톤 미세 보정 후보 3장 생성</li>
          </ol>
        </section>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold text-slate-900">2) 후보 선택</h2>
        <p class="mt-2 text-sm text-slate-600">후보 중 1장을 선택하면 다운로드가 활성화됩니다. 생성 후 바로 비교해서 고르면 됩니다.</p>
        <div id="candidate-grid" class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <div class="col-span-full flex flex-col items-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center">
            <div class="flex gap-2" aria-hidden="true">
              {[0, 1, 2].map((n) => <span class={`block aspect-[3/4] w-[3.75rem] overflow-hidden rounded-xl border-2 border-white bg-white shadow-sm ${n === 1 ? '-translate-y-1.5 ring-2 ring-emerald-200' : 'opacity-60'}`} set:html={samples[2].svg} />)}
            </div>
            <p class="mt-3 text-sm font-bold text-slate-700">생성 결과가 여기에 표시됩니다.</p>
            <p class="mt-1 text-xs text-slate-500">후보 3장을 나란히 비교하고 마음에 드는 1장을 골라요.</p>
          </div>
        </div>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-3">
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-black text-slate-900">📐 받을 사진 규격</p>
            <p id="size-summary" class="text-[11px] font-semibold text-slate-500">반명함 3×4cm · 1장</p>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2" role="radiogroup" aria-label="사진 규격">
            {sizePresets.map((preset, i) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white p-2 transition has-[:checked]:border-sky-500 has-[:checked]:ring-2 has-[:checked]:ring-sky-200">
                <input type="radio" name="size-preset" value={preset.id} checked={i === 0} data-label={`${preset.label} ${preset.size}`} class="sr-only" />
                <span class="flex h-9 w-9 shrink-0 items-center justify-center">
                  <span class="block rounded-[3px] border-2 border-sky-500 bg-sky-50" style={`width:${preset.w * 6}px;height:${preset.h * 6}px`}></span>
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-black text-slate-900">{preset.label} <span class="font-semibold text-slate-400">{preset.size}</span></span>
                  <span class="block truncate text-[10px] text-slate-500">{preset.use}</span>
                </span>
              </label>
            ))}
          </div>
          <label class="mt-2 flex items-start gap-2 text-xs text-slate-700">
            <input id="print-sheet" type="checkbox" class="mt-0.5 h-4 w-4 accent-sky-600" />
            <span><strong>4×6 인화용 시트로 받기</strong> · 선택한 규격을 여러 장 배치해 사진관·편의점 인화기로 한 번에 뽑을 수 있어요.</span>
          </label>
          <p class="mt-1 text-[11px] text-slate-400">여권사진은 얼굴 크기 규정이 엄격하니 <a href="/online-passport-photo" class="underline">여권사진 전용 페이지</a>를 권장해요.</p>
        </div>
        <button id="download-selected" class="mt-4 w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-bold text-white shadow-[0_10px_30px_rgba(5,150,105,0.28)] transition hover:-translate-y-0.5 hover:bg-emerald-500 active:translate-y-0 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none" disabled>
          선택한 1장 다운로드
        </button>
        <div class="mt-3 grid gap-2 sm:grid-cols-3">
