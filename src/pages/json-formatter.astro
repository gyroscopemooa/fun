---
import ToolGuide from '../components/ToolGuide.astro';
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="JSON 정리·검증기 | JSON Formatter | ManyTool" description="JSON 데이터를 보기 좋게 정리하고 문법 오류를 확인하는 무료 JSON 포맷터입니다." keywords="JSON 정리, JSON 포맷터, JSON 검증, JSON 보기 좋게"><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Developer Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">JSON 정리·검증기</h1><p class="mt-3 text-sm leading-7 text-slate-300">JSON을 붙여넣고 포맷팅하거나 문법 오류를 빠르게 확인하세요.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><textarea id="input" rows="14" placeholder='{"name":"ManyTool","free":true}' class="w-full rounded-2xl border border-slate-300 p-4 font-mono text-sm"></textarea><div class="mt-4 flex flex-wrap gap-3"><button id="format" class="rounded-xl bg-cyan-500 px-4 py-3 font-bold">정리하기</button><button id="minify" class="rounded-xl bg-slate-200 px-4 py-3 font-bold">한 줄로 줄이기</button><button id="clear" class="rounded-xl border px-4 py-3 font-bold">지우기</button></div><p id="status" class="mt-4 min-h-6 text-sm font-semibold"></p></section><ToolGuide />
<AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const i=document.getElementById('input'),s=document.getElementById('status');const run=(space)=>{try{i.value=JSON.stringify(JSON.parse(i.value),null,space);s.textContent='올바른 JSON입니다.';s.className='mt-4 min-h-6 text-sm font-semibold text-emerald-600'}catch(e){s.textContent=`JSON 오류: ${e.message}`;s.className='mt-4 min-h-6 text-sm font-semibold text-rose-600'}};document.getElementById('format').onclick=()=>run(2);document.getElementById('minify').onclick=()=>run(0);document.getElementById('clear').onclick=()=>{i.value='';s.textContent=''};</script>
