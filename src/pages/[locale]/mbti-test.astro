---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: { title: 'MBTI 性格测试', intro: '回答四个问题，获得一个轻量的性格类型结果。', start: '开始测试', next: '下一题', result: '你的类型', questions: ['独处后你会恢复能量吗？', '你更关注事实还是可能性？', '做决定时你更看重逻辑吗？', '你喜欢提前计划吗？'], yes: '是', no: '否' }, es: { title: 'Test de personalidad MBTI', intro: 'Responde cuatro preguntas para obtener un tipo de personalidad sencillo.', start: 'Comenzar', next: 'Siguiente', result: 'Tu tipo', questions: ['¿Recuperas energía estando a solas?', '¿Te centras más en hechos o posibilidades?', '¿Priorizas la lógica al decidir?', '¿Te gusta planificar con antelación?'], yes: 'Sí', no: 'No' }, de: { title: 'MBTI-Persönlichkeitstest', intro: 'Beantworte vier Fragen und erhalte einen einfachen Persönlichkeitstyp.', start: 'Starten', next: 'Weiter', result: 'Dein Typ', questions: ['Lädst du allein deine Energie auf?', 'Achtest du mehr auf Fakten oder Möglichkeiten?', 'Ist dir Logik bei Entscheidungen wichtig?', 'Planst du gerne im Voraus?'], yes: 'Ja', no: 'Nein' }, fr: { title: 'Test de personnalité MBTI', intro: 'Répondez à quatre questions pour obtenir un type de personnalité simple.', start: 'Commencer', next: 'Suivant', result: 'Votre type', questions: ['Récupérez-vous votre énergie seul ?', 'Vous concentrez-vous sur les faits ou les possibilités ?', 'Privilégiez-vous la logique pour décider ?', 'Aimez-vous planifier à l’avance ?'], yes: 'Oui', no: 'Non' }, pt: { title: 'Teste de personalidade MBTI', intro: 'Responda a quatro perguntas para obter um tipo de personalidade simples.', start: 'Começar', next: 'Próxima', result: 'Seu tipo', questions: ['Você recupera energia ficando sozinho?', 'Foca mais em fatos ou possibilidades?', 'Valoriza a lógica ao decidir?', 'Gosta de planejar com antecedência?'], yes: 'Sim', no: 'Não' }, vi: { title: 'Trắc nghiệm tính cách MBTI', intro: 'Trả lời bốn câu hỏi để nhận kết quả tính cách cơ bản.', start: 'Bắt đầu', next: 'Tiếp theo', result: 'Kiểu của bạn', questions: ['Bạn hồi phục năng lượng khi ở một mình?', 'Bạn chú ý sự thật hay khả năng hơn?', 'Bạn coi trọng logic khi quyết định?', 'Bạn thích lên kế hoạch trước?'], yes: 'Có', no: 'Không' }, id: { title: 'Tes kepribadian MBTI', intro: 'Jawab empat pertanyaan untuk mendapatkan tipe kepribadian sederhana.', start: 'Mulai', next: 'Berikutnya', result: 'Tipe kamu', questions: ['Apakah kamu mengisi energi saat sendirian?', 'Kamu lebih fokus pada fakta atau kemungkinan?', 'Apakah logika penting saat mengambil keputusan?', 'Apakah kamu suka merencanakan sebelumnya?'], yes: 'Ya', no: 'Tidak' } };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? copy.zh;
---
<Layout title={`${text.title} | ManyTool`} description={text.intro} keywords={`${text.title}, personality test, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-black text-slate-950">{text.title}</h1><p class="mt-3 text-sm leading-7 text-slate-600">{text.intro}</p><div id="stage" class="mt-6 rounded-2xl bg-slate-50 p-6"><button id="start" class="rounded-xl bg-fuchsia-700 px-5 py-3 text-sm font-bold text-white">{text.start}</button></div></section></main><Footer /></Layout>
<script is:inline define:vars={{ text }}>
  const stage = document.querySelector('#stage'); const scores = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 }; let index = 0;
  const pairs = [['E','I'], ['S','N'], ['T','F'], ['J','P']];
  const render = () => { if (index >= text.questions.length) { const type = `${scores.E >= scores.I ? 'E' : 'I'}${scores.S >= scores.N ? 'S' : 'N'}${scores.T >= scores.F ? 'T' : 'F'}${scores.J >= scores.P ? 'J' : 'P'}`; stage.innerHTML = `<p class="text-sm font-bold text-fuchsia-700">${text.result}</p><p class="mt-3 text-6xl font-black text-slate-950">${type}</p>`; return; } stage.innerHTML = `<p class="text-lg font-black text-slate-950">${index + 1}. ${text.questions[index]}</p><div class="mt-5 flex gap-3"><button id="yes" class="flex-1 rounded-xl bg-slate-950 px-4 py-3 font-bold text-white">${text.yes}</button><button id="no" class="flex-1 rounded-xl border border-slate-300 px-4 py-3 font-bold text-slate-700">${text.no}</button></div>`; document.querySelector('#yes').onclick = () => { scores[pairs[index][0]] += 1; index += 1; render(); }; document.querySelector('#no').onclick = () => { scores[pairs[index][1]] += 1; index += 1; render(); }; };
  document.querySelector('#start').onclick = () => { index = 0; Object.keys(scores).forEach((key) => scores[key] = 0); render(); };
</script>
