---
import { createTranslator, detectLocale, rolloutLocales, seoLocaleCodes, stripLocale, withLocalePath } from '../lib/i18n';
import FamilyPromo from './FamilyPromo.astro';

const pathname = Astro.url.pathname;
const locale = detectLocale(pathname);
const strippedPath = stripLocale(pathname);
const t = await createTranslator(locale);

const navItems = [
  { href: '/', label: t('common.home') },
  { href: '/today-fortune', label: t('header.fortune') },
  { href: '/games', label: t('header.game') },
  { href: '/tests', label: locale === 'ko' ? '테스트' : locale === 'ja' ? 'テスト' : 'Tests' },
  { href: '/maps/fishbread', label: t('header.fishbreadMap') },
  { href: '/contact', label: t('header.contact') }
];

const langLinks = [
  ...rolloutLocales.map((lang) => ({
    code: lang.code,
    name: lang.nativeName,
    href: lang.code === 'ko'
      ? `${strippedPath}`.replace(/\/{2,}/g, '/') || '/'
      : `/${lang.code}${strippedPath}`.replace(/\/{2,}/g, '/') || `/${lang.code}`
  }))
];
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href={withLocalePath(locale, '/')} class="text-xl font-bold tracking-tight">ManyTool</a>
    <div class="flex items-center gap-2">
      <nav class="hidden items-center gap-2 text-sm md:flex">
        {navItems.map((item) => (
          <a class="rounded-md px-2 py-1 whitespace-nowrap hover:bg-slate-100" href={withLocalePath(locale, item.href)}>{item.label}</a>
        ))}
      </nav>
      <details class="relative">
        <summary class="cursor-pointer list-none rounded-md border border-slate-200 px-2 py-1 text-xs font-bold uppercase text-slate-700">{locale}</summary>
        <div class="absolute right-0 z-20 mt-2 grid min-w-44 grid-cols-2 gap-1 rounded-xl border border-slate-200 bg-white p-2 text-xs shadow-lg">
        {langLinks.map((lang) => (
          <a
            href={lang.href}
            class:list={[
              'rounded px-2 py-2 font-semibold',
              lang.code === locale ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            ]}
          >
            {lang.name}
          </a>
        ))}
        </div>
      </details>
    </div>
  </div>
</header>
<FamilyPromo />

<script is:inline define:vars={{ locale, strippedPath, supportedLocales: seoLocaleCodes }}>
  const languageStorageKey = 'manytool-locale';
  const localePrefixPattern = new RegExp(`^/(${supportedLocales.filter((code) => code !== 'ko').join('|')})(?:/|$)`);
  const localePath = (nextLocale) => {
    const path = strippedPath === '/' ? '' : strippedPath;
    return nextLocale === 'ko' ? (path || '/') : `/${nextLocale}${path || '/'}`;
  };

  // Manual language selection wins and is remembered for later visits.
  document.querySelectorAll('header a[href]').forEach((link) => {
    const href = link.getAttribute('href') || '';
    const match = href.match(localePrefixPattern);
    const nextLocale = match ? match[1] : href.startsWith('/') ? 'ko' : null;
    if (nextLocale && supportedLocales.includes(nextLocale)) {
      link.addEventListener('click', () => {
        localStorage.setItem(languageStorageKey, nextLocale);
      });
    }
  });

  // Only auto-switch the canonical Korean URL. Localized SEO URLs remain stable.
  const isCanonicalKoreanPath = locale === 'ko' && !location.pathname.match(localePrefixPattern);
  if (isCanonicalKoreanPath && !localStorage.getItem(languageStorageKey)) {
    const browserLocale = (navigator.languages || [navigator.language || 'ko'])
      .map((value) => value.toLowerCase().split('-')[0])
      .find((value) => supportedLocales.includes(value));
    if (browserLocale && browserLocale !== 'ko') {
      location.replace(localePath(browserLocale));
    } else {
      fetch('/api/locale', { headers: { Accept: 'application/json' } })
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          const detectedLocale = data?.locale;
          if (detectedLocale && supportedLocales.includes(detectedLocale) && detectedLocale !== 'ko') {
            location.replace(localePath(detectedLocale));
          }
        })
        .catch(() => undefined);
    }
  }
</script>
