---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const tools = [
  ['/fps-sensitivity-converter', 'FPS 감도 변환기', '게임별 감도 변환과 cm/360'],
  ['/crosshair-generator', '크로스헤어 생성기', '조준선 설정과 복사'],
  ['/reaction-test', '반응속도 테스트', '클릭 반응시간 측정'],
  ['/fov-calculator', 'FOV·해상도 계산기', '화면비율별 FOV 비교'],
  ['/dpi-edpi-calculator', 'DPI·eDPI 계산기', '마우스 실제 감도 계산'],
  ['/fps-aim-trainer', 'FPS 조준 훈련', '타겟 클릭 훈련'],
  ['/team-split', '게임 팀 랜덤 배정기', '친구 팀 자동 나누기'],
  ['/game-damage-calculator', '게임 데미지 계산기', '공격력과 방어력 계산'],
  ['/game-keybinds', '게임 키 세팅 시각화', '키 설정을 키보드로 확인'],
  ['/game-session-tracker', '게임 세션 기록기', '플레이 기록 저장'],
  ['/lol-champion-recommender', '롤 챔피언 추천기', '포지션별 챔피언 랜덤 추천']
];
---
<Layout title="신규 업데이트 | 게임 도구 모음 | ManyTool" description="ManyTool에 새로 개발된 게임 관련 도구를 모아둔 신규 업데이트 목록입니다.">
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">New Updates</p><h1 class="mt-2 text-3xl font-black">신규 업데이트</h1><p class="mt-3 text-sm leading-7 text-slate-300">최근 개발된 게임 도구를 한 곳에서 확인하세요.</p></section><AdsterraBanner placement="top" /><section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{tools.map(([href, title, desc]) => <a href={href} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-cyan-300"><span class="text-xs font-bold text-cyan-600">NEW</span><h2 class="mt-2 font-bold text-slate-950">{title}</h2><p class="mt-2 text-sm text-slate-500">{desc}</p></a>)}</section><AdsterraBanner placement="bottom" /></main>
  <Footer />
</Layout>
