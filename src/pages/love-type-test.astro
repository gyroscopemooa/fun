---
import TypeTestPage from '../components/tests/TypeTestPage.astro';

const faq = [
  { q: '결과는 몇 가지인가요?', a: '직진 불도저부터 집콕 힐링러까지 8가지 연애 유형 중 하나가 나와요.' },
  { q: '연인과 같이 해도 되나요?', a: '네. 각자 테스트한 뒤 결과 링크를 서로 보내면 찰떡 연애 상대인지 바로 비교할 수 있어요.' },
  { q: '답변이 저장되나요?', a: '아니요. 답변은 브라우저 안에서만 계산되고 어디에도 보내지 않아요.' }
];
---

<TypeTestPage
  slug="love-type-test"
  description="12개의 연애 상황 질문으로 직진 불도저, 츤데레 고양이, 다정 강아지 등 8가지 연애 유형 중 나의 스타일을 알려 주는 무료 테스트입니다."
  keywords="연애 유형 테스트, 연애 스타일 테스트, 연애 성향 테스트, 무료 심리 테스트, 커플 테스트"
  faq={faq}
/>
