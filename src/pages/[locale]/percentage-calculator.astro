---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['百分比计算器','快速计算一个数的百分比','数值','百分比','计算'],es:['Calculadora de porcentajes','Calcula porcentajes rápidamente','Valor','Porcentaje','Calcular'],de:['Prozentrechner','Prozente schnell berechnen','Wert','Prozent','Berechnen'],fr:['Calculateur de pourcentage','Calculez rapidement un pourcentage','Valeur','Pourcentage','Calculer'],pt:['Calculadora de porcentagem','Calcule porcentagens rapidamente','Valor','Porcentagem','Calcular'],vi:['Máy tính phần trăm','Tính phần trăm nhanh chóng','Giá trị','Phần trăm','Tính'],id:['Kalkulator persentase','Hitung persentase dengan cepat','Nilai','Persentase','Hitung']}; const t=c[locale]??['Percentage Calculator','Calculate percentages quickly','Value','Percent','Calculate'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="grid gap-4 sm:grid-cols-2"><label>{t[2]}<input id="value" type="number" value="100" class="mt-1 w-full rounded-lg border p-3"/></label><label>{t[3]}<input id="percent" type="number" value="10" class="mt-1 w-full rounded-lg border p-3"/></label></div><button id="calc" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t[4]}</button><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 text-xl font-semibold">10</output></section></main><Footer/></Layout>
<script>const v=document.querySelector('#value'),p=document.querySelector('#percent'),r=document.querySelector('#result');function calc(){r.textContent=String((Number(v.value)||0)*(Number(p.value)||0)/100)}[v,p].forEach((e)=>e.addEventListener('input',calc));</script>
