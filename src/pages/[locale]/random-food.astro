---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['随机美食推荐', '不知道吃什么？随机获得一个菜单建议。', '推荐食物', '开始推荐', ['拉面', '寿司', '披萨', '汉堡', '炒饭', '饺子']], es: ['Comida aleatoria', '¿No sabes qué comer? Obtén una sugerencia al azar.', 'Comida recomendada', 'Recomendar', ['ramen', 'sushi', 'pizza', 'hamburguesa', 'arroz frito', 'tacos']], de: ['Zufällige Essenswahl', 'Du weißt nicht, was du essen sollst? Lass dich überraschen.', 'Empfehlung', 'Empfehlen', ['Ramen', 'Sushi', 'Pizza', 'Burger', 'Gebratener Reis', 'Tacos']], fr: ['Suggestion de repas', 'Vous ne savez pas quoi manger ? Obtenez une idée au hasard.', 'Suggestion', 'Suggérer', ['ramen', 'sushi', 'pizza', 'burger', 'riz sauté', 'tacos']], pt: ['Comida aleatória', 'Sem ideia do que comer? Receba uma sugestão aleatória.', 'Comida sugerida', 'Recomendar', ['ramen', 'sushi', 'pizza', 'hambúrguer', 'arroz frito', 'tacos']], vi: ['Gợi ý món ăn', 'Không biết ăn gì? Nhận một gợi ý ngẫu nhiên.', 'Món được gợi ý', 'Gợi ý', ['ramen', 'sushi', 'pizza', 'burger', 'cơm chiên', 'bánh taco']], id: ['Rekomendasi makanan acak', 'Bingung mau makan apa? Dapatkan saran acak.', 'Rekomendasi', 'Rekomendasikan', ['ramen', 'sushi', 'pizza', 'burger', 'nasi goreng', 'taco']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Random food picker', 'Not sure what to eat? Get a random menu suggestion.', 'Recommended food', 'Recommend', ['ramen', 'sushi', 'pizza', 'burger', 'fried rice', 'tacos']];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, random food, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><div id="food" class="mt-8 min-h-24 rounded-3xl bg-orange-50 p-6 text-4xl font-black text-orange-900">🍽️</div><button id="pick" class="mt-6 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white">{text[3]}</button><p class="mt-4 text-sm font-bold text-slate-700">{text[2]}</p></section></main><Footer /></Layout>
<script is:inline define:vars={{ foods: text[4] }}>
  const food = document.querySelector('#food'); document.querySelector('#pick').addEventListener('click', () => { food.textContent = foods[Math.floor(Math.random() * foods.length)]; });
</script>
