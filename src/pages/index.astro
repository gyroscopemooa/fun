<Layout
  title="ManyTool | 무료 온라인 도구, 테스트, 게임, 쇼핑몰 툴 모음"
  description="무료 온라인 도구, 테스트, 브라우저 게임, 지도 서비스, 스마트스토어와 쇼핑몰 운영에 활용할 수 있는 도구를 카드형으로 탐색하는 ManyTool 메인 페이지입니다."
  keywords="무료 온라인 도구, 무료 웹툴, 무료 테스트, 무료 게임, 스마트스토어 툴, 쇼핑몰 툴, 상세페이지 생성기, 지도 도구, 랜덤 도구"
>
  <main class="min-h-screen bg-slate-100">
    <div class="mx-auto max-w-6xl">
      <header class="flex items-center justify-between gap-2 border-b border-sky-100 px-4 py-3 lg:px-10">
        <a href={withLocale('/')} class="flex min-w-0 items-center gap-2">
          <img src="/favicon.svg" alt="ManyTool 로고" class="h-7 w-7 rounded-lg bg-sky-100 p-1 sm:h-8 sm:w-8" loading="eager" decoding="async" />
          <h2 class="truncate text-base font-bold tracking-tight text-slate-900 sm:text-xl">ManyTool</h2>
        </a>
        <div class="flex shrink-0 items-center gap-1 sm:gap-2">
          <button
            id="favorite-filter-button"
            type="button"
            class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-1.5 text-[11px] font-semibold text-amber-700 transition hover:bg-amber-100 sm:gap-2 sm:px-3 sm:py-2 sm:text-xs"
          >
            <span aria-hidden="true">★</span>
            <span class="hidden sm:inline">{t.favoriteOnly}</span>
            <span id="favorite-filter-count" class="rounded-full bg-white px-2 py-0.5 text-[11px] font-bold text-amber-700">0</span>
          </button>
          <details class="relative">
            <summary class="cursor-pointer list-none rounded-md border border-slate-200 bg-white px-2 py-1.5 text-[11px] font-bold text-slate-700 shadow-sm sm:px-3 sm:text-xs">
              {langLinks.find((lang) => lang.code === locale)?.label ?? locale.toUpperCase()}
            </summary>
            <div class="absolute right-0 z-30 mt-2 max-h-80 w-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
              <div class="grid grid-cols-2 gap-1">
                {langLinks.map((lang) => (
                  <a
                    href={lang.href}
                    class:list={[
                      'rounded-md px-2 py-2 text-xs font-semibold transition',
                      lang.code === locale ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
                    ]}
                  >
                    <span class="mr-1 text-[10px] uppercase opacity-60">{lang.code}</span>{lang.label}
                  </a>
                ))}
              </div>
            </div>
          </details>
        </div>
      </header>

      <section class="px-4 py-5 lg:px-10">
        <div class="mx-auto max-w-md">
          <input
            id="tool-search"
            aria-label={t.searchPlaceholder}
            class="w-full rounded-full border border-sky-100 bg-white px-4 py-3 text-sm outline-none focus:border-sky-400"
            placeholder={t.searchPlaceholder}
            type="text"
          />
        </div>

        <div class="mt-5 text-center">
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.heroTitle}</h1>
          <p class="mt-1 text-slate-500">{t.heroDesc}</p>
        </div>

        <div class="mt-4 overflow-x-auto pb-2">
          <div class="mx-auto flex w-max gap-2">
          {t.tabs.map((tab, idx) => (
            <button
              data-tab={idx === 0 ? 'all' : idx === 1 ? 'games' : idx === 2 ? 'tools' : idx === 3 ? 'art' : idx === 4 ? 'etc' : 'new'}
              class:list={[
                'tab-chip whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium transition',
                'whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium',
                idx === 0
                  ? 'bg-sky-500 text-white'
                  : 'border border-sky-100 bg-white text-slate-600'
              ]}
            >
              {tab}
            </button>
          ))}
          </div>
        </div>

        <AdsterraBanner placement="home" class="mt-4" />
      </section>

      <HomeFamilyShowcase />

      <!-- 양쪽 여백 광고: 도구 카드부터 운영 기준 섹션까지 스크롤을 따라 내려온다 -->
      <div class="relative">
      <AdsterraRail side="left" />
      <AdsterraRail side="right" />
      <div class="px-4 pb-4 lg:px-10">
        <div id="home-card-rows">
          <div class="mb-3 flex justify-end">
            <button id="home-motion-toggle" type="button" aria-pressed="true" data-play={locale === 'ko' ? '자동 이동 시작' : 'Play cards'} data-pause={locale === 'ko' ? '자동 이동 일시정지' : 'Pause cards'} class="rounded-full border border-sky-100 bg-white px-3 py-2 text-xs text-slate-600">{locale === 'ko' ? '자동 이동 일시정지' : 'Pause cards'}</button>
          </div>
          <section class="space-y-4" aria-label={locale === 'ko' ? '도구 카드' : 'Tool cards'}>
            {rows.map((row, idx) => (
              <div class="flex items-center gap-2" data-slider data-row={idx}>
                <button class="home-card-nav" data-nav="prev" aria-label={t.prevCard}>‹</button>
                <div class="min-w-0 flex-1 overflow-hidden">
                  <div class="home-card-track" data-track>
                    {row.map(card => <HomeToolCard card={{ ...card, soon: tRaw('common.soon') }} favoriteLabel={t.favorite} />)}
                  </div>
                </div>
                <button class="home-card-nav" data-nav="next" aria-label={t.nextCard}>›</button>
              </div>
            ))}
          </section>
        </div>
        <section id="home-search-results" class="hidden" aria-label={locale === 'ko' ? '전체 도구 검색 결과' : 'All tool search results'}>
          <p class="mb-3 text-sm text-slate-600" role="status">{locale === 'ko' ? '전체 도구 검색 결과' : 'All tool search results'} <strong id="home-search-count">0</strong></p>
          <div class="home-search-layout" id="home-search-layout">
            <button type="button" class="home-search-nav" data-search-nav="prev" aria-controls="home-search-track" aria-label={locale === 'ko' ? '이전 검색 결과' : 'Previous search result'}>‹</button>
            <div id="home-search-track" class="home-search-track">
            {searchEntries.map(entry => (
              <article hidden data-search-result data-search={`${entry.title} ${entry.desc} ${entry.keywords ?? ''} ${entry.href}`} class="rounded-xl border border-sky-100 bg-white p-4">
                <a href={entry.disabled ? undefined : entry.href} aria-disabled={entry.disabled ? 'true' : undefined} class="block h-full">
                  <h2 class="font-bold text-slate-900">{entry.title}</h2>
                  <p class="mt-2 text-sm text-slate-500">{entry.desc}</p>
                  {entry.disabled && <span class="mt-2 block text-xs text-slate-500">{tRaw('common.soon')}</span>}
                </a>
              </article>
            ))}
            </div>
            <button type="button" class="home-search-nav" data-search-nav="next" aria-controls="home-search-track" aria-label={locale === 'ko' ? '다음 검색 결과' : 'Next search result'}>›</button>
          </div>
        </section>
      </div>
      <p id="search-empty" class="hidden px-4 pb-4 text-sm text-slate-500 lg:px-10">{t.noResult}</p>
      <p id="favorite-empty" class="hidden px-4 pb-4 text-sm text-slate-500 lg:px-10">{t.favoriteEmpty}</p>

      <div class="px-4 pb-6 lg:px-10">
        <AdsterraBanner placement="home" class="mt-2" />
      </div>

      <section class="px-4 pb-2 lg:px-10">
        <article class="rounded-xl border border-slate-200 bg-white p-5">
          <h2 class="text-xl font-semibold">{t.guideTitle}</h2>
          <p class="mt-2 text-slate-700">
            {t.guideP1}
          </p>
          <p class="mt-2 text-slate-700">
            {t.guideP2}
          </p>
          <div class:list={['mt-5 rounded-2xl bg-slate-50 p-4', !showDonate && 'hidden']}>
            <p class="text-sm text-slate-600">{t.guideDonateHint}</p>
            <button
              id="home-donate-button"
              type="button"
              class="mt-3 w-full rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
