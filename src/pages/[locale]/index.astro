---
import Page from '../../pages/index.astro';
import { seoLocaleCodes } from '../../lib/i18n';

export function getStaticPaths() {
  return seoLocaleCodes.filter((locale) => locale !== 'ko' && locale !== 'en' && locale !== 'ja').map((locale) => ({ params: { locale }, props: { locale } }));
}

---
<Page />
