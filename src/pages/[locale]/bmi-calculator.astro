---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['BMI计算器','输入身高和体重计算身体质量指数','身高(cm)','体重(kg)','计算BMI'],es:['Calculadora de IMC','Calcula tu índice de masa corporal con altura y peso','Altura (cm)','Peso (kg)','Calcular IMC'],de:['BMI-Rechner','Berechne deinen Body-Mass-Index mit Größe und Gewicht','Größe (cm)','Gewicht (kg)','BMI berechnen'],fr:['Calculateur d’IMC','Calculez votre indice de masse corporelle','Taille (cm)','Poids (kg)','Calculer l’IMC'],pt:['Calculadora de IMC','Calcule seu índice de massa corporal','Altura (cm)','Peso (kg)','Calcular IMC'],vi:['Tính chỉ số BMI','Tính chỉ số khối cơ thể từ chiều cao và cân nặng','Chiều cao (cm)','Cân nặng (kg)','Tính BMI'],id:['Kalkulator BMI','Hitung indeks massa tubuh dari tinggi dan berat badan','Tinggi (cm)','Berat (kg)','Hitung BMI']}; const t=c[locale]??['BMI Calculator','Calculate your body mass index','Height (cm)','Weight (kg)','Calculate BMI'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="grid gap-4 sm:grid-cols-2"><label>{t[2]}<input id="height" type="number" min="1" class="mt-1 w-full rounded-lg border p-3"/></label><label>{t[3]}<input id="weight" type="number" min="1" class="mt-1 w-full rounded-lg border p-3"/></label></div><button id="calc" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t[4]}</button><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 text-xl font-semibold">—</output></section></main><Footer/></Layout>
<script>const h=document.querySelector('#height'),w=document.querySelector('#weight'),r=document.querySelector('#result');document.querySelector('#calc').addEventListener('click',()=>{const height=Number(h.value)/100,weight=Number(w.value);r.textContent=height>0&&weight>0?`BMI: ${(weight/(height*height)).toFixed(1)}`:'—'});</script>
