const humanizeCardPath = (href: string) => href
  .split('/').filter(Boolean).pop()!
  .split('-')
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(' ');

const cards = cardSeed.filter((card) => import.meta.env.DEV || !('localOnly' in card && card.localOnly)).map((card) => {
  const i18n = cardTitleI18n[card.href];
  const title = locale === 'ko'
    ? card.title
    : locale === 'ja'
      ? i18n?.ja ?? i18n?.en ?? humanizeCardPath(card.href)
      : i18n?.en ?? humanizeCardPath(card.href);
  const desc = locale === 'ko'
    ? card.desc
    : locale === 'en'
      ? `${title} tool`
      : locale === 'ja'
        ? `${title}ツール`
        : `${title} tool`;
  return { ...card, sourceHref: card.href, title, desc, href: localizedHrefOrOriginal(locale, card.href), disabled: (card.disabled ?? false) && !import.meta.env.DEV };
});

const searchEntries = getHomeSearchEntries(cards.map((card) => ({ ...card, keywords: `${cardSeed.find(seed => localizedHrefOrOriginal(locale, seed.href) === card.href)?.title ?? ''} ${cardTitleI18n[card.href]?.en ?? ''}` })), locale);

const rowCount = 5;
const rowSize = Math.ceil(cards.length / rowCount);
const rows = Array.from({ length: rowCount }, (_, rowIndex) =>
  cards.slice(rowIndex * rowSize, (rowIndex + 1) * rowSize)
).filter((row) => row.length > 0);
