---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { communityPosts, relatedPosts } from '../../lib/community';
import { GUIDES } from '../../lib/guides';
export async function getStaticPaths() {
  return (await communityPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const related = relatedPosts(post, await communityPosts());
const guides = GUIDES.filter((guide) => guide.tools.some((tool) => post.data.tools.some((link) => link.href === tool.href))).slice(0, 3);
---
<Layout title={`${post.data.title} | ManyTool 커뮤니티`} description={post.data.description}>
  <Header preserveCurrentRoute />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <a href="/community/" class="text-sm font-bold text-cyan-800">← 커뮤니티 전체 글</a>
    <article class="mt-6">
      <p class="text-sm font-bold text-cyan-700">{post.data.category}</p>
      <h1 class="mt-3 text-3xl font-black leading-tight sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-sm text-slate-500">매니툴 운영팀 · 작성 <time datetime={post.data.published}>{post.data.published}</time>{post.data.updated && <> · 수정 <time datetime={post.data.updated}>{post.data.updated}</time></>}</p>
      <p class="mt-6 rounded-2xl bg-cyan-50 p-5 leading-7"><strong>이 글이 답하는 질문</strong><br />{post.data.question}</p>
      <div class="community-body mt-8"><Content /></div>
    </article>
    {post.data.tools.length > 0 && <section class="mt-10 rounded-2xl bg-slate-950 p-6 text-white"><h2 class="text-xl font-bold">직접 해결해 보세요</h2><div class="mt-4 flex flex-wrap gap-3">{post.data.tools.map((tool) => <a href={tool.href} class="rounded-xl bg-cyan-300 px-4 py-3 font-bold text-slate-950">{tool.label} →</a>)}</div></section>}
    {guides.length > 0 && <section class="mt-8"><h2 class="text-xl font-bold">함께 읽으면 좋은 가이드</h2><ul class="mt-3 space-y-3">{guides.map((guide) => <li><a class="text-cyan-800 underline" href={`/guides/${guide.slug}/`}>{guide.title}</a></li>)}</ul></section>}
    {related.length > 0 && <section class="mt-8 border-t border-slate-200 pt-6"><h2 class="text-xl font-bold">같은 주제의 최근 글</h2><ul class="mt-4 space-y-4">{related.map((entry) => <li><a href={`/community/${entry.id}/`} class="font-bold hover:underline">{entry.data.title}</a><p class="mt-1 text-sm text-slate-500">{entry.data.description}</p></li>)}</ul></section>}
    <p class="mt-10 text-sm text-slate-600">해결되지 않았나요? <a href="/contact" class="underline">사용 환경과 함께 문의해 주세요.</a></p>
  </main><Footer />
</Layout>
<style>
  .community-body { color: #334155; line-height: 1.9; overflow-wrap: anywhere; }
  .community-body :global(h2) { margin: 2rem 0 .8rem; color: #0f172a; font-size: 1.4rem; font-weight: 800; }
  .community-body :global(h3) { margin: 1.5rem 0 .5rem; font-weight: 700; }
  .community-body :global(p) { margin: 1rem 0; }
  .community-body :global(ul), .community-body :global(ol) { padding-left: 1.5rem; margin: 1rem 0; }
  .community-body :global(ul) { list-style: disc; }
  .community-body :global(ol) { list-style: decimal; }
  .community-body :global(a) { color: #0e7490; text-decoration: underline; }
  .community-body :global(img) { max-width: 100%; height: auto; }
  .community-body :global(pre) { overflow-x: auto; padding: 1rem; border-radius: .75rem; }
</style>
