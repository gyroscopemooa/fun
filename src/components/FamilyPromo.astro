---
const services = [
  { eyebrow: 'LIVE · LANGUAGE', name: 'TranStream', copy: '방송·회의를 실시간 자막과 번역으로', href: 'https://transtream.app/', accent: '#b7ff3c' },
  { eyebrow: 'HEALTH', name: '헬띠루틴', copy: '운동 기록과 루틴 관리를 한곳에서', href: 'https://live-sub.com/healthyroutine/', accent: '#55f0a5' },
  { eyebrow: 'PROMOTION', name: '더홍보', copy: '앱·상품·서비스를 자유롭게 알리는 홍보 플랫폼', href: 'https://thehongbo.com/', accent: '#ff9d45' },
  { eyebrow: 'COMMUNITY', name: 'SSRRR', copy: '유머부터 이슈·경제까지 가볍게 보는 커뮤니티', href: 'https://ssrrr.net/', accent: '#ff68bd' },
  { eyebrow: 'MATCHING', name: '맡다', copy: '업체·전문가 견적을 비교하는 업무 매칭', href: 'https://matda.net/', accent: '#53d9ff' },
  { eyebrow: 'HIRING', name: 'HireRoom', copy: '중소기업도 쉽게 만드는 우리 회사 채용 페이지', href: 'https://hireroom.net/', accent: '#ffe04f' },
  { eyebrow: 'GROUP BUYING', name: '인플공구', copy: '인플루언서와 팬을 잇는 검증된 공동구매', href: 'https://infl09.com/', accent: '#ff784f' },
  { eyebrow: 'EDU · AI', name: 'TranStream EduAI', copy: '영화·드라마를 AI와 같이 보며 배우는 신개념 언어 공부', href: 'https://transtream.app/edu', accent: '#a78bfa' }
];
---

<aside class="family-promo" aria-label="live sub 패밀리 서비스" data-family-promo>
  <div class="family-promo__rail">
    {services.map((service, index) => (
      <a
        href={service.href}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['family-promo__slide', index === 0 && 'is-active']}
        data-family-slide
        aria-hidden={index === 0 ? 'false' : 'true'}
        style={`--promo-accent:${service.accent}`}
      >
        <span class="family-promo__label">LIVE SUB FAMILY · {service.eyebrow}</span>
        <span class="family-promo__name">{service.name}</span>
        <span class="family-promo__copy">{service.copy}</span>
        <span class="family-promo__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</aside>

<script>
  document.querySelectorAll('[data-family-promo]').forEach((promo) => {
    const slides = Array.from(promo.querySelectorAll('[data-family-slide]'));
    if (slides.length < 2) return;
    let current = 0;
    let timer;

    const showNext = () => {
      slides[current]?.classList.remove('is-active');
      slides[current]?.setAttribute('aria-hidden', 'true');
      current = (current + 1) % slides.length;
      slides[current]?.classList.add('is-active');
      slides[current]?.setAttribute('aria-hidden', 'false');
    };
    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(showNext, 7000);
    };
    const stop = () => window.clearInterval(timer);

    promo.addEventListener('mouseenter', stop);
    promo.addEventListener('mouseleave', start);
    promo.addEventListener('focusin', stop);
    promo.addEventListener('focusout', start);
    start();
  });
</script>

<style>
  .family-promo { border-bottom: 1px solid rgb(30 41 59); background: #090b11; color: white; }
  .family-promo__rail { position: relative; height: 64px; max-width: 1024px; margin: 0 auto; overflow: hidden; }
  .family-promo__slide { position: absolute; inset: 0; display: flex; align-items: center; gap: 14px; padding: 0 16px; color: white; opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity 700ms ease, transform 700ms ease; }
  .family-promo__slide.is-active { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .family-promo__label { color: var(--promo-accent); font: 700 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .11em; white-space: nowrap; }
  .family-promo__name { font-size: 17px; font-weight: 900; white-space: nowrap; }
  .family-promo__copy { min-width: 0; overflow: hidden; color: rgb(203 213 225); font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .family-promo__arrow { display: grid; flex: 0 0 30px; height: 30px; margin-left: auto; place-items: center; border: 1px solid rgb(255 255 255 / .2); border-radius: 999px; color: var(--promo-accent); transition: transform 200ms ease, background 200ms ease; }
  .family-promo__slide:hover .family-promo__arrow, .family-promo__slide:focus-visible .family-promo__arrow { transform: translate(2px, -2px); background: rgb(255 255 255 / .08); }
  .family-promo__slide:focus-visible { outline: 2px solid var(--promo-accent); outline-offset: -3px; }
  @media (max-width: 640px) {
    .family-promo__rail { height: 70px; }
    .family-promo__slide { display: grid; grid-template-columns: 1fr auto; gap: 3px 10px; padding: 9px 14px; }
    .family-promo__label { grid-column: 1; }
    .family-promo__name { grid-column: 1; font-size: 16px; }
    .family-promo__copy { display: none; }
    .family-promo__arrow { grid-column: 2; grid-row: 1 / 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .family-promo__slide { transition: none; }
  }
</style>
