---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../ads/AdsterraBanner.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Recommend from '../Recommend.astro';
import ToolGuide from '../ToolGuide.astro';

interface Props {
  title: string;
  description: string;
  keywords: string;
  eyebrow: string;
  heading: string;
  intro: string;
  accent: string;
  howTo: string;
  related?: { href: string; label: string }[];
  /** Show the game hub link (off for non-game tools sharing this frame). */
  hub?: boolean;
  /** Link-preview image, e.g. /og/game-team-balancer.jpg. */
  image?: string;
}

const { title, description, keywords, eyebrow, heading, intro, accent, howTo, related = [], hub = true, image } = Astro.props;
const locale = Astro.url.pathname.split('/')[1] || 'ko';
const pageUi = {
  ko: { hub: '게임 허브', how: '사용 방법' },
  en: { hub: 'Game hub', how: 'How to use' },
  zh: { hub: '游戏中心', how: '使用方法' },
  es: { hub: 'Centro de juegos', how: 'Cómo usarlo' },
  de: { hub: 'Spiele-Hub', how: 'So funktioniert es' },
  fr: { hub: 'Hub de jeux', how: 'Mode d’emploi' },
  pt: { hub: 'Central de jogos', how: 'Como usar' },
  vi: { hub: 'Trung tâm game', how: 'Cách sử dụng' },
  id: { hub: 'Hub game', how: 'Cara menggunakan' }
} as const;
const ui = pageUi[locale as keyof typeof pageUi] ?? pageUi.en;
---

<Layout title={title} description={description} keywords={keywords} image={image}>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] p-6 text-white shadow-sm sm:p-8" style={`background: radial-gradient(circle at 85% 0%, ${accent}66, transparent 50%), #020617`}>
      <p class="text-sm font-semibold uppercase tracking-[0.2em]" style={`color: ${accent}`}>{eyebrow}</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">{heading}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">{intro}</p>
      {related.length ? (
        <div class="mt-5 flex flex-wrap gap-2">
          {hub ? <a href="/games" class="rounded-full border border-white bg-white px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-white/90">🎮 {ui.hub}</a> : null}
          {related.map((item) => (
            <a href={item.href} class="rounded-full border border-white/20 px-4 py-2 text-sm font-bold text-white/80 transition hover:border-white/60 hover:text-white">{item.label}</a>
          ))}
        </div>
      ) : null}
    </section>
    <AdsterraBanner placement="top" />
    <section class="mt-6">
      <slot />
    </section>
    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 text-sm leading-7 text-slate-600 shadow-sm">
      <h2 class="text-lg font-bold text-slate-950">{ui.how}</h2>
      <p class="mt-1">{howTo}</p>
    </section>
    <ToolGuide />
    <AdsterraBanner placement="bottom" />
    <Recommend />
  </main>
  <Footer />
</Layout>
