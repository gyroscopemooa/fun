---
import AiImageGenerator from '../../components/home/AiImageGenerator';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { seoLocaleCodes } from '../../lib/i18n';

const locales = {
  zh: { title: 'AI 图片生成器 | ManyTool', description: '使用照片生成 AI 风格图片、旅行背景、头像和服装变化。', heading: 'AI 图片风格工具', body: '上传一张照片，选择想要的风格并生成新的 AI 图片。' },
  es: { title: 'Generador de imágenes con IA | ManyTool', description: 'Crea imágenes con IA, fondos de viaje, retratos y cambios de ropa a partir de una foto.', heading: 'Herramientas de estilos con IA', body: 'Sube una foto, elige un estilo y genera una nueva imagen con IA.' },
  de: { title: 'KI-Bildgenerator | ManyTool', description: 'Erstelle KI-Bilder, Reisehintergründe, Profilbilder und Outfit-Varianten aus einem Foto.', heading: 'KI-Bildstile', body: 'Lade ein Foto hoch, wähle einen Stil und erstelle ein neues KI-Bild.' },
  fr: { title: "Générateur d'images IA | ManyTool", description: "Créez des images IA, des arrière-plans de voyage, des portraits et des changements de tenue à partir d'une photo.", heading: 'Styles d’images IA', body: 'Importez une photo, choisissez un style et créez une nouvelle image avec l’IA.' },
  pt: { title: 'Gerador de imagens com IA | ManyTool', description: 'Crie imagens com IA, fundos de viagem, retratos e mudanças de roupa a partir de uma foto.', heading: 'Estilos de imagem com IA', body: 'Envie uma foto, escolha um estilo e gere uma nova imagem com IA.' },
  vi: { title: 'Trình tạo ảnh AI | ManyTool', description: 'Tạo ảnh AI, ảnh du lịch, ảnh đại diện và thay đổi trang phục từ một bức ảnh.', heading: 'Công cụ phong cách ảnh AI', body: 'Tải ảnh lên, chọn phong cách và tạo ảnh mới bằng AI.' },
  id: { title: 'Generator Gambar AI | ManyTool', description: 'Buat gambar AI, latar perjalanan, foto profil, dan perubahan pakaian dari satu foto.', heading: 'Gaya gambar AI', body: 'Unggah foto, pilih gaya, lalu buat gambar baru dengan AI.' },
  en: { title: 'AI image generator | ManyTool', description: 'Create AI images, travel backgrounds, portraits, and outfit variations from a photo.', heading: 'AI image styles', body: 'Upload a photo, choose a style, and generate a new AI image.' },
};

export function getStaticPaths() {
  return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const copy = locales[locale as keyof typeof locales] ?? locales.en;
const styleLinks = ['figure', 'body-profile', 'travel-background', 'snapshot', 'instagram-photo', 'outfit-change', 'hairstyle', 'interior', 'free-style'];
const styleLabelSets: Record<string, string[]> = {
  zh: ['AI 手办','AI 健身写真','AI 旅行背景','AI 随拍','AI 聊天头像','AI 社交照片','AI 换装','AI 发型','AI 室内设计','AI 自由风格'],
  es: ['Figura IA','Foto fitness IA','Fondo de viaje IA','Foto casual IA','Perfil social IA','Foto para Instagram IA','Cambio de ropa IA','Peinado IA','Interior IA','Estilo libre IA'],
  de: ['KI-Figur','KI-Fitnessfoto','KI-Reisehintergrund','KI-Schnappschuss','KI-Profilbild','KI-Instagram-Foto','KI-Outfitwechsel','KI-Frisur','KI-Innenraum','Freier KI-Stil'],
  fr: ['Figurine IA','Photo fitness IA','Arrière-plan voyage IA','Instantané IA','Profil social IA','Photo Instagram IA','Changement de tenue IA','Coiffure IA','Intérieur IA','Style libre IA'],
  pt: ['Figura IA','Foto fitness IA','Fundo de viagem IA','Foto casual IA','Perfil social IA','Foto para Instagram IA','Troca de roupa IA','Penteado IA','Interior IA','Estilo livre IA'],
  vi: ['Mô hình AI','Ảnh thể hình AI','Nền du lịch AI','Ảnh tự nhiên AI','Ảnh đại diện AI','Ảnh Instagram AI','Đổi trang phục AI','Kiểu tóc AI','Nội thất AI','Phong cách tự do AI'],
  id: ['Figur AI','Foto kebugaran AI','Latar perjalanan AI','Foto spontan AI','Profil sosial AI','Foto Instagram AI','Ganti pakaian AI','Gaya rambut AI','Interior AI','Gaya bebas AI']
};
const styleLabels = styleLabelSets[locale] ?? styleLinks.map((style) => `AI ${style.replaceAll('-', ' ')}`);
---

<Layout title={copy.title} description={copy.description} keywords={`${copy.title}, AI image generator, ManyTool`}>
  <Header />
  <main>
    <section class="mx-auto max-w-6xl px-4 pt-8">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-black tracking-tight text-slate-900">{copy.heading}</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">{copy.body}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {styleLinks.map((style, index) => <a href={`/${locale}/ai-image-generator/${style}`} class="rounded-full border border-slate-300 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-slate-900 hover:bg-white">{styleLabels[index]}</a>)}
        </div>
      </div>
    </section>
    <AiImageGenerator client:load locale={locale} />
  </main>
  <Footer />
</Layout>
