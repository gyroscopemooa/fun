---
import SharedResultLayout from '../share/SharedResultLayout.astro';
import TypeResultCard from './TypeResultCard';
import { TYPE_TESTS } from '../../lib/type-tests';

interface Props {
  slug: string;
  id: string;
}

const { slug, id } = Astro.props;
const test = TYPE_TESTS[slug];
const result = test.results.find((r) => r.id === id)!;
const best = test.results.find((r) => r.id === result.best);
---

<SharedResultLayout
  title={`${result.emoji} ${result.name} | ${test.title} 결과 | ManyTool`}
  description={`${result.summary} 나는 어떤 유형일까? 12문항 ${test.title}로 확인해 보세요.`}
  image={`/og/${slug}/${id}.jpg`}
  ctaHref={`/${slug}`}
  ctaLabel={`나도 ${test.title} 하기 →`}
  testName={test.title}
  accent={result.color}
>
  <div slot="card" class="mx-auto max-w-full overflow-auto rounded-[22px] shadow-xl max-[419px]:[zoom:0.8]">
    <TypeResultCard test={test} result={result} />
  </div>
  <h1 class="text-2xl font-black text-slate-900">{result.emoji} {result.name}</h1>
  <p class="leading-6">{result.summary}</p>
  <div class="rounded-2xl border border-slate-200 bg-white p-3">
    <p class="font-black text-slate-900">💡 한 줄 조언</p>
    <p class="mt-1">{result.tip}</p>
  </div>
  {best ? (
    <a href={`/${slug}/result/${best.id}`} class="block rounded-2xl border border-slate-200 bg-white p-3 hover:bg-slate-50">
      <p class="font-black text-slate-900">🤝 {test.bestLabel}</p>
      <p class="mt-1">{best.emoji} <strong>{best.name}</strong> · {best.traits.join(', ')}</p>
    </a>
  ) : null}
  <div slot="after">
    <p class="text-xs font-bold text-slate-500">다른 결과도 구경하기</p>
    <div class="mt-1.5 flex flex-wrap gap-1.5">
      {test.results.filter((r) => r.id !== id).map((r) => (
        <a href={`/${slug}/result/${r.id}`} class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 hover:bg-slate-100">{r.emoji} {r.name}</a>
      ))}
    </div>
  </div>
</SharedResultLayout>
