---
import Layout from '../layouts/PrivateToolLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SelectionWorkbench from '../components/SelectionWorkbench';
---
<Layout title="선택한 글 도구 | ManyTool" description="선택한 글의 핵심 문장 추출, 공백 정리, 오류 코드 안내와 표 CSV 변환을 브라우저에서 처리합니다.">

  <main class="mx-auto max-w-5xl px-4 py-10">
    <a href="/tools/" class="text-sm font-bold text-teal-800">← 매니툴 도구</a>
    <h1 class="mt-5 text-3xl font-black">선택한 글 도구</h1>
    <p class="mt-3 leading-7 text-slate-600">필요한 부분만 가져와 처리하세요. 기본 기능은 무료·로컬 처리이며, 생성형 AI 연결은 준비 중입니다.</p>
    <SelectionWorkbench client:load />
    <noscript>이 도구를 사용하려면 JavaScript를 켜 주세요.</noscript>
  </main>

</Layout>
