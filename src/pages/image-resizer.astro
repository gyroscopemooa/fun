---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="이미지 사이즈 변경기 | 사진 크기 조절 | ManyTool" description="가로세로 크기를 입력해 사진과 이미지 사이즈를 간단히 변경하세요. 브라우저에서 안전하게 처리합니다." keywords="이미지 사이즈 변경, 사진 크기 조절, 이미지 리사이즈"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Image Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">이미지 사이즈 변경기</h1><p class="mt-3 text-sm leading-7 text-slate-300">원하는 가로·세로 픽셀을 입력해 이미지 크기를 변경합니다.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><input id="file" type="file" accept="image/*" class="block w-full rounded-2xl border border-slate-300 p-4 text-sm" /><div class="mt-5 grid grid-cols-2 gap-3"><label class="text-sm font-bold">가로<input id="w" type="number" class="mt-2 w-full rounded-xl border p-3" /></label><label class="text-sm font-bold">세로<input id="h" type="number" class="mt-2 w-full rounded-xl border p-3" /></label></div><label class="mt-4 flex gap-2 text-sm"><input id="ratio" type="checkbox" checked /> 비율 유지</label><button id="run" class="mt-6 rounded-2xl bg-cyan-500 px-5 py-3 font-bold">변경하고 다운로드</button><p id="result" class="mt-5 text-sm text-slate-600"></p></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const f=document.getElementById('file'),w=document.getElementById('w'),h=document.getElementById('h'),r=document.getElementById('ratio'),out=document.getElementById('result');f.addEventListener('change',()=>{const x=f.files?.[0];if(!x)return;const i=new Image();i.onload=()=>{w.value=i.width;h.value=i.height};i.src=URL.createObjectURL(x)});w.addEventListener('input',()=>{if(r.checked&&f.files?.[0]){const i=new Image();i.onload=()=>h.value=Math.round(Number(w.value)*i.height/i.width);i.src=URL.createObjectURL(f.files[0])}});document.getElementById('run').addEventListener('click',()=>{const x=f.files?.[0];if(!x){out.textContent='이미지를 먼저 선택해주세요.';return}const i=new Image();i.onload=()=>{const c=document.createElement('canvas');c.width=Number(w.value);c.height=Number(h.value);c.getContext('2d').drawImage(i,0,0,c.width,c.height);const a=document.createElement('a');a.href=c.toDataURL('image/png');a.download='resized-image.png';a.click();out.textContent=`${c.width} × ${c.height}px 이미지가 다운로드되었습니다.`};i.src=URL.createObjectURL(x)});</script>
