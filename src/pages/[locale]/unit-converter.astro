---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['单位换算器','长度、重量和温度快速换算','数值','从','到','换算'],es:['Conversor de unidades','Convierte longitud, peso y temperatura rápidamente','Valor','De','A','Convertir'],de:['Einheitenumrechner','Länge, Gewicht und Temperatur schnell umrechnen','Wert','Von','Nach','Umrechnen'],fr:['Convertisseur d’unités','Convertissez longueur, poids et température','Valeur','De','Vers','Convertir'],pt:['Conversor de unidades','Converta comprimento, peso e temperatura rapidamente','Valor','De','Para','Converter'],vi:['Công cụ đổi đơn vị','Đổi nhanh chiều dài, khối lượng và nhiệt độ','Giá trị','Từ','Sang','Đổi'],id:['Konverter satuan','Konversi panjang, berat, dan suhu dengan cepat','Nilai','Dari','Ke','Konversi']}; const t=c[locale]??['Unit Converter','Convert length, weight and temperature quickly','Value','From','To','Convert'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><label class="block">{t[2]}<input id="value" type="number" value="1" class="mt-1 w-full rounded-lg border p-3"/></label><div class="mt-4 grid grid-cols-2 gap-3"><label>{t[3]}<select id="from" class="mt-1 w-full rounded-lg border p-3"><option value="m">m</option><option value="km">km</option><option value="cm">cm</option><option value="kg">kg</option><option value="c">°C</option></select></label><label>{t[4]}<select id="to" class="mt-1 w-full rounded-lg border p-3"><option value="cm">cm</option><option value="m">m</option><option value="km">km</option><option value="kg">kg</option><option value="c">°C</option></select></label></div><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 text-xl font-semibold">1</output></section></main><Footer/></Layout>
<script>
const value=document.querySelector('#value'),from=document.querySelector('#from'),to=document.querySelector('#to'),result=document.querySelector('#result'); const factors={cm:0.01,m:1,km:1000,kg:1}; function calc(){const n=Number(value.value)||0;let out=n;if(from.value!==to.value&&factors[from.value]&&factors[to.value])out=n*factors[from.value]/factors[to.value];result.textContent=String(Number(out.toFixed(6)))+' '+to.value} [value,from,to].forEach((el)=>el.addEventListener('input',calc));calc();
</script>
