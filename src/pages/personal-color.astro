---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import Recommend from '../components/Recommend.astro';
---

<Layout title="퍼스널컬러 자가진단 | ManyTool" description="사진 업로드 기반 퍼스널컬러 자가진단. 얼굴 사진으로 계절 톤을 빠르게 추정해보세요.">
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold">퍼스널컬러 자가진단</h1>
    <p class="mt-3 text-slate-700">얼굴 사진을 올리면 빠르게 봄/여름/가을/겨울 톤을 추정해서 확인할 수 있습니다.</p>
    <AdSense slotName="본문 상단" />

    <AdsterraBanner placement="top" />
    <section class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
      <input id="color-file" accept="image/*" class="block w-full text-sm" type="file" />
      <img id="color-preview" class="mt-3 hidden max-h-72 w-full rounded-lg object-contain" alt="미리보기" />
      <button id="color-run" class="mt-3 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white">분석하기</button>
      <p id="color-result" class="mt-3 rounded-md bg-slate-100 px-3 py-3 text-sm text-slate-700">이미지를 올리고 분석 버튼을 눌러주세요.</p>
      <div id="color-card" class="mt-3 hidden rounded-2xl border border-slate-200 p-4">
        <div class="flex items-center gap-3">
          <span id="color-skin" class="h-12 w-12 shrink-0 rounded-full border-4 border-white shadow"></span>
          <div>
            <p class="text-xs font-semibold text-slate-500">추정 피부색 <span id="color-skin-hex" class="font-mono"></span></p>
            <p id="color-tone" class="text-xl font-black text-slate-900"></p>
          </div>
        </div>
        <p id="color-tagline" class="mt-2 text-sm text-slate-600"></p>
        <div id="color-palette" class="mt-3 grid grid-cols-4 gap-2"></div>
        <div class="mt-3 grid grid-cols-2 gap-2">
          <a id="color-detail" href="/personal-color/result/spring-light" class="rounded-xl bg-slate-900 px-3 py-2.5 text-center text-xs font-bold text-white hover:bg-slate-700">내 톤 자세히 보기</a>
          <button id="color-share" type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-xs font-bold text-slate-800 hover:bg-slate-50">결과 링크 공유</button>
        </div>
      </div>
      <canvas id="color-canvas" class="hidden"></canvas>
    </section>

    <AdsterraBanner placement="bottom" />
    <section class="mt-5 rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-700">
      <h2 class="text-lg font-semibold text-slate-900">퍼스널컬러 자가진단이란?</h2>
      <p class="mt-1">사진 가운데 얼굴 피부 영역의 색만 골라 웜/쿨, 명도, 채도를 계산하고 12톤 중 가까운 톤을 재미형으로 안내합니다.</p>
      <h2 class="mt-4 text-lg font-semibold text-slate-900">사용 방법</h2>
      <p class="mt-1">얼굴 사진 업로드 후 분석하기를 누르면 결과를 바로 확인할 수 있습니다.</p>
      <h2 class="mt-4 text-lg font-semibold text-slate-900">FAQ</h2>
      <p class="mt-1">Q. 정확한 추천까지 보고 싶어요. A. 아래 AI 퍼스널컬러 분석 페이지에서 더 자세한 추천 결과를 확인할 수 있습니다.</p>
    </section>

    <section class="mt-5 rounded-2xl border border-rose-200 bg-[linear-gradient(135deg,#fff1f2_0%,#fff7ed_55%,#fefce8_100%)] p-5">
      <p class="inline-flex rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-rose-700">업그레이드 버전</p>
      <h2 class="mt-3 text-xl font-bold text-slate-900">AI 퍼스널컬러 자가진단으로 더 자세한 추천 받기</h2>
      <p class="mt-2 text-sm text-slate-700">단순 톤 추정만 보는 대신, 어울리는 컬러군과 메이크업 톤, 헤어 컬러, 스타일링 방향까지 AI 분석으로 더 자세히 볼 수 있게 준비합니다.</p>
      <a
        href="/ai-personal-color"
        class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800 sm:w-auto"
      >
        AI 퍼스널컬러 자가진단 보러가기
      </a>
    </section>

    <AdSense slotName="본문 하단" />
    <Recommend />
  </main>
  <Footer />

  <script>
    import { TONE_MAP, type ToneId } from '../lib/personal-color-tones';
    import { shareResult } from '../lib/share-result';

    const fileEl = document.getElementById('color-file') as HTMLInputElement | null;
    const previewEl = document.getElementById('color-preview') as HTMLImageElement | null;
    const runEl = document.getElementById('color-run');
    const resultEl = document.getElementById('color-result');
    const canvasEl = document.getElementById('color-canvas') as HTMLCanvasElement | null;
    const cardEl = document.getElementById('color-card');

    let ready = false;

    fileEl?.addEventListener('change', () => {
      const file = fileEl.files?.[0];
      if (!file || !previewEl) return;
      previewEl.src = URL.createObjectURL(file);
      previewEl.classList.remove('hidden');
      ready = true;
    });

    // Samples only skin-like pixels from the centre of the frame so background and clothes don't skew the tone.
    const sampleSkin = (img: HTMLImageElement, canvas: HTMLCanvasElement) => {
      const size = 128;
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return null;
      const side = Math.min(img.naturalWidth, img.naturalHeight);
      ctx.drawImage(img, (img.naturalWidth - side) / 2, (img.naturalHeight - side) / 2, side, side, 0, 0, size, size);
      const data = ctx.getImageData(0, 0, size, size).data;
      let r = 0; let g = 0; let b = 0; let n = 0;
      for (let y = 0; y < size; y += 1) {
        for (let x = 0; x < size; x += 1) {
          const dx = (x - size / 2) / (size * 0.22);
          const dy = (y - size * 0.45) / (size * 0.28);
          if (dx * dx + dy * dy > 1) continue;
          const i = (y * size + x) * 4;
          const [pr, pg, pb] = [data[i], data[i + 1], data[i + 2]];
          if (pr < 70 || pr <= pg || pg < pb * 0.85 || pr - pb < 12) continue;
          r += pr; g += pg; b += pb; n += 1;
        }
      }
      return n > 80 ? { r: r / n, g: g / n, b: b / n } : null;
    };

    const classify = ({ r, g, b }: { r: number; g: number; b: number }): ToneId => {
      const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      const sat = (Math.max(r, g, b) - Math.min(r, g, b)) / Math.max(r, g, b);
      // Skin hue sits around 0-40deg: pinker (cool) skin is near red, yellower (warm) skin drifts toward orange.
      const hue = (60 * (g - b)) / Math.max(1, Math.max(r, g, b) - Math.min(r, g, b));
      if (hue >= 19) {
        if (lum > 0.8) return 'spring-light';
        if (sat > 0.4 && lum > 0.62) return 'spring-bright';
        if (lum > 0.66) return 'spring-true';
        if (lum < 0.5) return 'autumn-deep';
        return sat < 0.26 ? 'autumn-mute' : 'autumn-true';
      }
      if (lum > 0.8) return 'summer-light';
      if (sat < 0.24) return 'summer-mute';
      if (lum < 0.5) return 'winter-deep';
      if (sat > 0.4) return 'winter-bright';
      return lum > 0.66 ? 'summer-true' : 'winter-true';
    };

    const toHex = (v: number) => Math.round(v).toString(16).padStart(2, '0');

    runEl?.addEventListener('click', () => {
      if (!ready || !previewEl || !canvasEl || !previewEl.complete) {
        if (resultEl) resultEl.textContent = '먼저 이미지를 업로드해 주세요.';
        return;
      }
      const skin = sampleSkin(previewEl, canvasEl);
      if (!skin) {
        cardEl?.classList.add('hidden');
        if (resultEl) resultEl.textContent = '얼굴 피부 영역을 찾지 못했어요. 얼굴이 가운데 오도록 정면 사진을 올려 주세요.';
        return;
      }
      const tone = TONE_MAP[classify(skin)];
      const hex = `#${toHex(skin.r)}${toHex(skin.g)}${toHex(skin.b)}`.toUpperCase();
      if (resultEl) resultEl.textContent = `분석 결과: ${tone.label} (재미용 간이 추정)`;
      const set = (id: string, text: string) => { const el = document.getElementById(id); if (el) el.textContent = text; };
      set('color-tone', tone.label);
      set('color-tagline', tone.tagline);
      set('color-skin-hex', hex);
      const skinEl = document.getElementById('color-skin');
      if (skinEl) skinEl.style.background = hex;
      const paletteEl = document.getElementById('color-palette');
      if (paletteEl) {
        paletteEl.replaceChildren(...tone.best.slice(0, 4).map((item) => {
          const cell = document.createElement('div');
          const chip = document.createElement('div');
          chip.className = 'h-10 rounded-lg border border-black/5';
          chip.style.background = item.hex;
          const label = document.createElement('p');
          label.className = 'mt-1 truncate text-[11px] font-semibold text-slate-600';
          label.textContent = item.name;
          cell.append(chip, label);
          return cell;
        }));
      }
      const detailEl = document.getElementById('color-detail') as HTMLAnchorElement | null;
      if (detailEl) detailEl.href = `/personal-color/result/${tone.id}`;
      sharedToneId = tone.id;
      cardEl?.classList.remove('hidden');
    });

    let sharedToneId = '';
    const shareEl = document.getElementById('color-share');
    shareEl?.addEventListener('click', async () => {
      if (!sharedToneId) return;
      const tone = TONE_MAP[sharedToneId as ToneId];
      const outcome = await shareResult({ url: `/personal-color/result/${tone.id}`, title: `내 퍼스널컬러는 ${tone.label}`, text: '나도 퍼스널컬러 진단해 보기' });
      if (outcome === 'copied') {
        shareEl.textContent = '링크를 복사했어요';
        window.setTimeout(() => { shareEl.textContent = '결과 링크 공유'; }, 2000);
      }
    });
  </script>
</Layout>
