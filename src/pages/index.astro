const rawApiBase = (import.meta.env.PUBLIC_NODE_API_BASE ?? '').trim();
// 기부하기: 운영에서는 PG 심사 전까지 숨기고, 로컬 개발 서버나 PUBLIC_SHOW_DONATE=true 일 때만 표시
const showDonate = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_DONATE === 'true';
const apiBase = rawApiBase.replace(/\/+$/, '');

const pathname = Astro.url.pathname;
const locale = detectLocale(pathname);
const tRaw = await createTranslator(locale);
const withLocale = (path: string) => localizedHrefOrOriginal(locale, path);
const strippedPath = stripLocale(pathname);
const langLinks = rolloutLocales.map((lang) => ({
  code: lang.code,
  label: lang.nativeName,
  href: lang.code === 'ko'
    ? `${strippedPath}`.replace(/\/{2,}/g, '/') || '/'
    : `/${lang.code}${strippedPath}`.replace(/\/{2,}/g, '/') || `/${lang.code}`
}));

const t = {
  tabs: [
    tRaw('home.tabs.all'),
    tRaw('home.tabs.games'),
    tRaw('home.tabs.tools'),
    tRaw('home.tabs.art'),
    tRaw('home.tabs.etc'),
