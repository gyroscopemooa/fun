---
import Layout from '../layouts/Layout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import Recommend from './Recommend.astro';
const { kind, title, description, keywords } = Astro.props;
---
<Layout title={`${title} | ManyTool`} description={description} keywords={keywords}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-fuchsia-300">Fun Lab</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">{title}</h1><p class="mt-3 text-sm leading-7 text-slate-300">{description}</p></section><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><div id="app"></div></section><Recommend /></main><Footer /></Layout>
<script is:inline define:vars={{ kind }}>
const app=document.getElementById('app'); let n=0,score=0,items=[],picked=[];
const quiz={
  choseong:[['ㄱㅂ','가방','고양이','김밥','기차'],['ㅂㄷ','바다','배달','보드','부동산'],['ㅅㄱ','사과','수건','사거리','생각'],['ㅋㅍ','커피','컴퓨터','카페','캠핑'],['ㅁㅅ','모자','미소','마술','미숫가루']],
  korean:[['대한민국의 수도는?','서울','부산','대전','인천'],['한글을 만든 왕은?','세종대왕','광개토대왕','정조','이순신'],['한국의 국화는?','무궁화','장미','벚꽃','해바라기'],['1년은 몇 개월일까?','12개월','10개월','11개월','13개월'],['한국에서 가장 높은 산은?','한라산','지리산','설악산','북한산']],
  song:[['ㅂㅇㄴ ㄴㄹ','벚꽃엔딩','밤양갱','비와 당신','붉은 노을'],['ㄴㅇ ㅇㄴ','너의 의미','내일의 나','나의 왕자님','눈의 여왕'],['ㅅㅂㄴ','슈퍼노바','사랑비','새벽녘','선물'],['ㅇㅅ','아이유','이승기','에일리','윤하']],
  logo:[['사과 모양으로 유명한 브랜드','Apple','Nike','Adidas','Samsung'],['세 줄의 산 모양 로고','Adidas','Puma','Google','Lego'],['초록색 원 안의 사이렌','Starbucks','Spotify','Target','Subway'],['빨간 원 안의 흰색 글자','YouTube','Netflix','Coca-Cola','Nintendo']]
};
const tests={
 friend:[['친구가 고민을 말하면?',['끝까지 듣는다',2],['해결책을 바로 말한다',3],['같이 화낸다',1]],['약속 시간에 늦은 친구에게?',['괜찮다고 한다',1],['왜 늦었는지 묻는다',2],['다음엔 내가 늦는다',3]],['여행 계획은?',['즉흥으로 간다',3],['꼼꼼히 짠다',1],['친구에게 맡긴다',2]],['단톡방에서 나는?',['읽고 조용히 있는 편',1],['대화를 이끄는 편',3],['짤을 보내는 편',2]],['친구와 싸우면?',['먼저 사과한다',2],['시간을 둔다',1],['끝까지 이야기한다',3]]],
 food:[['매운 음식은?',['없으면 서운하다',3],['적당히 좋다',2],['못 먹는다',1]],['탕수육은?',['찍먹',1],['부먹',3],['상관없다',2]],['야식으로 고른다면?',['치킨',3],['떡볶이',2],['아이스크림',1]],['카페에서 주문은?',['아메리카노',1],['달달한 음료',3],['신메뉴',2]],['밥친구는?',['국밥',2],['파스타',3],['샐러드',1]]],
 villain:[['주인공이 계획을 망쳤다면?',['다시 계획한다',1],['더 큰 계획을 세운다',3],['그냥 웃는다',2]],['나의 무기는?',['압도적인 힘',3],['치밀한 두뇌',2],['말빨',1]],['부하에게 원하는 것은?',['충성심',2],['실력',3],['재미',1]],['완벽한 은신처는?',['높은 탑',3],['지하 연구소',2],['평범한 카페',1]],['마지막 대사는?',['이건 시작일 뿐이다',3],['재미있었어',1],['다음엔 내가 이긴다',2]]]
};
function safe(x){return String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function shell(head,sub=''){app.innerHTML=`<div class="text-center"><p class="text-sm text-slate-500">${sub}</p><h2 class="mt-2 text-2xl font-black text-slate-950">${head}</h2></div><div id="stage" class="mt-7"></div>`}
function startQuiz(type){items=quiz[type];n=0;score=0;shell(type==='choseong'?'초성을 보고 단어를 맞혀보세요':type==='song'?'노래 제목 초성 퀴즈':'문제를 보고 정답을 골라보세요',`${items.length}문제`);drawQuiz(type)}
function drawQuiz(type){const q=items[n],answers=[q[1],q[2],q[3],q[4]].sort(()=>Math.random()-.5);document.getElementById('stage').innerHTML=`<p class="text-center text-5xl font-black text-fuchsia-600">${q[0]}</p><div class="mt-6 grid gap-3 sm:grid-cols-2">${answers.map((a,i)=>`<button data-a="${safe(a)}" class="ans rounded-2xl border bg-slate-50 p-4 text-left font-bold hover:border-fuchsia-400 hover:bg-fuchsia-50">${String.fromCharCode(65+i)}. ${safe(a)}</button>`).join('')}</div><p id="msg" class="mt-5 min-h-6 text-center text-sm font-bold"></p>`;document.querySelectorAll('.ans').forEach(b=>b.onclick=()=>{if(b.disabled)return;document.querySelectorAll('.ans').forEach(x=>x.disabled=true);const ok=b.dataset.a===q[1];if(ok){score++;b.classList.add('border-emerald-400','bg-emerald-50')}else b.classList.add('border-rose-400','bg-rose-50');document.getElementById('msg').textContent=ok?'정답!':'정답은 '+q[1]+'입니다.';setTimeout(()=>{n++;n<items.length?drawQuiz(type):finish(`${score} / ${items.length} 정답`,'다음 문제도 도전해보세요.')},700)})}
function startTest(type){items=tests[type];n=0;score=0;shell(type==='friend'?'나는 친구들 사이에서 어떤 타입일까?':type==='food'?'나의 음식 취향은?':'내가 영화 속 악역이라면?','5개의 질문');drawTest(type)}
function drawTest(type){const q=items[n];document.getElementById('stage').innerHTML=`<p class="text-center text-xl font-black">${q[0]}</p><div class="mt-6 grid gap-3">${q.slice(1).map((a,i)=>`<button class="test rounded-2xl border bg-slate-50 p-4 text-left font-bold hover:border-fuchsia-400 hover:bg-fuchsia-50" data-score="${a[1]}">${i+1}. ${a[0]}</button>`).join('')}</div><p class="mt-5 text-center text-xs text-slate-400">${n+1} / ${items.length}</p>`;document.querySelectorAll('.test').forEach(b=>b.onclick=()=>{score+=Number(b.dataset.score);n++;n<items.length?drawTest(type):finish(type==='friend'?(score>11?'든든한 리더형 친구':'배려 깊은 조율자'):type==='food'?(score>10?'자극적인 미식가':'담백한 취향파'):(score>10?'최종 보스형 악역':'매력적인 라이벌'),'당신의 선택을 바탕으로 한 결과입니다.')})}
function startBalance(){const qs=[['평생 치킨만 먹기','평생 피자만 먹기'],['여름만 살기','겨울만 살기'],['시간여행 하기','순간이동 하기'],['하루 종일 음악 듣기','하루 종일 영화 보기'],['바다에서 살기','산에서 살기']];n=0;shell('당신의 선택은?','밸런스 게임');const next=()=>{if(n===qs.length){finish('당신의 선택이 기록되었습니다','친구와 결과를 비교해보세요.');return}document.getElementById('stage').innerHTML=`<div class="grid gap-4 sm:grid-cols-2"><button class="bal rounded-3xl bg-fuchsia-100 p-8 text-lg font-black text-fuchsia-900">${qs[n][0]}</button><button class="bal rounded-3xl bg-cyan-100 p-8 text-lg font-black text-cyan-900">${qs[n][1]}</button></div><p class="mt-5 text-center text-xs text-slate-400">${n+1} / ${qs.length}</p>`;document.querySelectorAll('.bal').forEach(b=>b.onclick=()=>{n++;next()})};next()}
function worldCup(){let pool=['치킨','피자','햄버거','떡볶이','라면','초밥','삼겹살','파스타'];n=0;shell('이상형 월드컵','음식 최강자전');const next=()=>{if(pool.length===1){finish(`${pool[0]} 우승!`,'당신이 선택한 최고의 음식입니다.');return}const a=pool.shift(),b=pool.shift();document.getElementById('stage').innerHTML=`<div class="grid gap-4 sm:grid-cols-2"><button class="wc rounded-3xl bg-amber-100 p-10 text-2xl font-black">🍽️ ${a}</button><button class="wc rounded-3xl bg-rose-100 p-10 text-2xl font-black">🍽️ ${b}</button></div>`;document.querySelectorAll('.wc').forEach((x,i)=>x.onclick=()=>{pool.unshift(i?b:a);next()})};next()}
function randomPick(title,list){shell(title,'버튼을 누를 때마다 결과가 바뀝니다.');document.getElementById('stage').innerHTML=`<div class="text-center"><div id="pick" class="min-h-24 py-6 text-4xl font-black text-fuchsia-600">🎲</div><button id="roll" class="rounded-2xl bg-slate-950 px-6 py-4 font-bold text-white">랜덤 뽑기</button></div>`;document.getElementById('roll').onclick=()=>document.getElementById('pick').textContent=list[Math.floor(Math.random()*list.length)]}
function fortune(){shell('오늘의 운세 카드','카드를 눌러 오늘의 메시지를 확인하세요.');document.getElementById('stage').innerHTML='<button id="card" class="mx-auto block h-64 w-44 rounded-3xl bg-gradient-to-br from-fuchsia-600 to-indigo-700 text-6xl shadow-xl">🔮</button>';document.getElementById('card').onclick=()=>{const a=['새로운 기회가 찾아옵니다 ✨','작은 친절이 큰 행운이 됩니다 🍀','오늘은 천천히 가도 괜찮습니다 🌙','기대하지 않은 연락이 옵니다 📩'];document.getElementById('card').textContent=a[Math.floor(Math.random()*a.length)]}}
function character(){shell('이름 캐릭터 생성기','이름을 입력하면 나만의 캐릭터 카드가 만들어집니다.');document.getElementById('stage').innerHTML='<input id="name" placeholder="이름 입력" class="w-full rounded-2xl border p-4 text-center"/><button id="make" class="mt-4 w-full rounded-2xl bg-fuchsia-600 px-5 py-4 font-bold text-white">캐릭터 생성</button><div id="card" class="mt-6"></div>';document.getElementById('make').onclick=()=>{const name=document.getElementById('name').value.trim()||'이름 없는 모험가';const jobs=['시간을 다루는 마법사','행운을 훔치는 도적','마을을 지키는 기사','전설의 요리사'];document.getElementById('card').innerHTML=`<div class="rounded-3xl bg-gradient-to-br from-indigo-950 to-fuchsia-900 p-7 text-center text-white"><div class="text-6xl">⚔️</div><h3 class="mt-4 text-3xl font-black">${safe(name)}</h3><p class="mt-2 text-fuchsia-200">${jobs[Math.floor(Math.random()*jobs.length)]}</p><p class="mt-5 text-sm">공격력 ${50+Math.floor(Math.random()*51)} · 행운 ${50+Math.floor(Math.random()*51)}</p></div>`}}
function typing(){shell('타자속도 대결','아래 문장을 얼마나 빠르고 정확하게 입력할 수 있을까요?');const text='오늘도 재미있는 도구를 찾아 ManyTool에 방문했습니다.';document.getElementById('stage').innerHTML=`<p class="rounded-2xl bg-slate-50 p-5 font-medium">${text}</p><textarea id="type" rows="3" disabled placeholder="시작 버튼을 눌러주세요" class="mt-4 w-full rounded-2xl border p-4"></textarea><button id="go" class="mt-4 rounded-2xl bg-fuchsia-600 px-5 py-3 font-bold text-white">시작</button><p id="typing-result" class="mt-4 text-center font-bold"></p>`;let began=0;document.getElementById('go').onclick=()=>{began=Date.now();const t=document.getElementById('type');t.disabled=false;t.focus();t.oninput=()=>{if(t.value===text){const sec=(Date.now()-began)/1000;document.getElementById('typing-result').textContent=`완료! ${Math.round(text.length/sec*60)}타/분 · ${sec.toFixed(2)}초`;t.disabled=true}}}}
function finish(title,sub){app.innerHTML=`<div class="py-12 text-center"><div class="text-6xl">🎉</div><h2 class="mt-5 text-3xl font-black text-slate-950">${title}</h2><p class="mt-3 text-sm text-slate-500">${sub}</p><button id="restart" class="mt-7 rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white">다시 하기</button></div>`;document.getElementById('restart').onclick=boot}
function boot(){if(kind==='balance')startBalance();else if(kind==='worldcup')worldCup();else if(kind==='friend'||kind==='food'||kind==='villain')startTest(kind);else if(kind==='fortune')fortune();else if(kind==='character')character();else if(kind==='typing')typing();else if(kind==='penalty')randomPick('랜덤 벌칙 뽑기',['애교 3초 하기','다음 음료 쏘기','노래 한 소절 부르기','친구 칭찬 3개 하기','10초 동안 춤추기']);else if(kind==='menu')randomPick('오늘 메뉴 룰렛',['김치찌개','치킨','초밥','떡볶이','국밥','파스타','햄버거']);else if(kind==='pastlife')randomPick('전생 직업 테스트',['조선시대 선비','떠돌이 상인','왕실 요리사','바다를 누빈 항해사','마을의 약초꾼']);else if(kind==='choseong'||kind==='korean'||kind==='song'||kind==='logo')startQuiz(kind);else if(kind==='name')character();else if(kind==='typing')typing();else if(kind==='villain')startTest('villain')}
boot();
</script>
