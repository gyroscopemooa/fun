---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['小费计算器','计算小费并分摊账单','账单金额','小费比例','人数','计算'],es:['Calculadora de propinas','Calcula la propina y divide la cuenta','Total de la cuenta','Propina','Personas','Calcular'],de:['Trinkgeldrechner','Trinkgeld berechnen und Rechnung teilen','Rechnungsbetrag','Trinkgeld','Personen','Berechnen'],fr:['Calculateur de pourboire','Calculez le pourboire et partagez l’addition','Montant de l’addition','Pourboire','Personnes','Calculer'],pt:['Calculadora de gorjeta','Calcule a gorjeta e divida a conta','Valor da conta','Gorjeta','Pessoas','Calcular'],vi:['Tính tiền tip','Tính tiền tip và chia hóa đơn','Tổng hóa đơn','Tiền tip','Số người','Tính'],id:['Kalkulator tip','Hitung tip dan bagi tagihan','Total tagihan','Tip','Orang','Hitung']}; const t=c[locale]??['Tip Calculator','Calculate tip and split the bill','Bill total','Tip','People','Calculate'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="grid gap-4 sm:grid-cols-3"><label>{t[2]}<input id="bill" type="number" value="100" class="mt-1 w-full rounded-lg border p-3"/></label><label>{t[3]} (%)<input id="tip" type="number" value="15" class="mt-1 w-full rounded-lg border p-3"/></label><label>{t[4]}<input id="people" type="number" min="1" value="1" class="mt-1 w-full rounded-lg border p-3"/></label></div><button id="calc" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t[5]}</button><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 text-xl font-semibold"></output></section></main><Footer/></Layout>
<script>const b=document.querySelector('#bill'),t=document.querySelector('#tip'),p=document.querySelector('#people'),r=document.querySelector('#result');function calc(){const total=(Number(b.value)||0)*(1+(Number(t.value)||0)/100),each=total/Math.max(1,Number(p.value)||1);r.textContent=`Total: ${total.toFixed(2)} · Each: ${each.toFixed(2)}`}[b,t,p].forEach((e)=>e.addEventListener('input',calc));calc();</script>
