---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import VideoBrandIcon from './VideoBrandIcon.astro';
import Footer from './Footer.astro';
import VideoDownloader from './VideoDownloader';
import { videoTools } from '../data/video-tools';
const { slug } = Astro.props;
const tool = videoTools.find(item => item.slug === slug)!;
const faqs = [...tool.faq, ['파일은 얼마나 보관되나요?', '완료된 파일은 최대 10분 동안 임시 보관한 뒤 자동 삭제합니다. 서버 재시작 시 더 일찍 만료될 수 있으며, 만료된 링크는 다시 준비해야 합니다.']];
const faqSchema = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) };
---
<Layout title={`${tool.title} | 링크로 영상 저장 | ManyTool`} description={tool.description} keywords={`${tool.title}, ${tool.short} 저장, 영상 링크 다운로드`}><Header/><main class="mx-auto max-w-4xl px-4 py-10"><a href="/video-download-tools" class="text-sm font-bold text-cyan-700">← 영상 다운로드 도구 모음</a><section class="mt-5 rounded-[28px] bg-slate-950 p-7 text-white sm:p-10"><p class="text-xs font-bold tracking-[0.2em] text-cyan-300">MANYTOOL · VIDEO TOOLS</p><h1 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl"><span class="mr-3 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white align-middle"><VideoBrandIcon platform={tool.platform} size={28}/></span>{tool.title}</h1><p class="mt-4 max-w-2xl text-sm leading-7 text-slate-300">{tool.description}</p><p class="mt-5 break-all rounded-xl bg-white/10 px-4 py-3 text-xs text-cyan-100">지원 링크 · {tool.example}</p></section><VideoDownloader platform={tool.platform} placeholder={tool.placeholder} client:load/><section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 sm:p-8"><h2 class="text-xl font-bold">{tool.short} 영상 저장 방법</h2><ol class="mt-5 grid gap-4 sm:grid-cols-3">{tool.steps.map((step,index)=><li class="rounded-2xl bg-slate-50 p-4 text-sm leading-6"><span class="mb-3 flex h-7 w-7 items-center justify-center rounded-full bg-cyan-100 font-bold text-cyan-800">{index+1}</span>{step}</li>)}</ol><h2 class="mt-8 text-xl font-bold">지원 범위와 확인할 점</h2><p class="mt-4 text-sm leading-7 text-slate-600">{tool.details}</p></section><section class="mt-8"><h2 class="text-xl font-bold">자주 묻는 질문</h2><div class="mt-4 space-y-3">{faqs.map(([q,a])=><details class="rounded-2xl border border-slate-200 bg-white p-5"><summary class="cursor-pointer text-sm font-bold">{q}</summary><p class="mt-3 text-sm leading-7 text-slate-600">{a}</p></details>)}</div></section><nav aria-label="다른 영상 다운로드 도구" class="mt-8"><h2 class="text-xl font-bold">다른 서비스의 영상인가요?</h2><div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">{videoTools.filter(item=>item.slug!==slug).map(item=><a href={`/${item.slug}`} class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold hover:border-cyan-400"><span class="flex items-center gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-50"><VideoBrandIcon platform={item.platform} size={23}/></span><span>{item.short}</span></span><span class="mt-2 block text-xs font-normal text-slate-500">전용 도구 열기 →</span></a>)}</div></nav></main><Footer/><script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g,'\\u003c')}/></Layout>
