---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['字数统计器', '输入文字，实时统计字符数、单词数和行数。', '请输入文字', ['字符', '单词', '行']], es: ['Contador de caracteres', 'Escribe un texto para contar caracteres, palabras y líneas.', 'Escribe tu texto', ['Caracteres', 'Palabras', 'Líneas']], de: ['Zeichenzähler', 'Gib Text ein und zähle Zeichen, Wörter und Zeilen.', 'Text eingeben', ['Zeichen', 'Wörter', 'Zeilen']], fr: ['Compteur de caractères', 'Saisissez un texte pour compter caractères, mots et lignes.', 'Saisissez votre texte', ['Caractères', 'Mots', 'Lignes']], pt: ['Contador de caracteres', 'Digite um texto para contar caracteres, palavras e linhas.', 'Digite seu texto', ['Caracteres', 'Palavras', 'Linhas']], vi: ['Đếm ký tự', 'Nhập văn bản để đếm ký tự, từ và dòng.', 'Nhập văn bản', ['Ký tự', 'Từ', 'Dòng']], id: ['Penghitung karakter', 'Masukkan teks untuk menghitung karakter, kata, dan baris.', 'Masukkan teks', ['Karakter', 'Kata', 'Baris']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Text counter', 'Enter text to count characters, words, and lines in real time.', 'Enter your text', ['Characters', 'Words', 'Lines']];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, text counter, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><textarea id="input" rows="10" class="mt-6 w-full rounded-xl border border-slate-300 p-4" placeholder={text[2]}></textarea><div class="mt-5 grid grid-cols-3 gap-3 text-center">{text[3].map((label, index) => <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-500">{label}</p><p id={`value-${index}`} class="mt-1 text-2xl font-black text-slate-900">0</p></div>)}</div></section></main><Footer /></Layout>
<script is:inline>
  const input = document.querySelector('#input'); const update = () => { const value = input.value; document.querySelector('#value-0').textContent = value.length; document.querySelector('#value-1').textContent = value.trim() ? value.trim().split(/\s+/).length : 0; document.querySelector('#value-2').textContent = value ? value.split(/\r?\n/).length : 0; }; input.addEventListener('input', update); update();
</script>
