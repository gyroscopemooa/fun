---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['每日英语单词', '每天学习一个实用英语单词。', '下一个单词', ['serendipity','resilient','curious','delight','wander']], es: ['Palabra inglesa del día', 'Aprende una palabra útil en inglés cada día.', 'Siguiente palabra', ['serendipity','resilient','curious','delight','wander']], de: ['Englisches Wort des Tages', 'Lerne jeden Tag ein nützliches englisches Wort.', 'Nächstes Wort', ['serendipity','resilient','curious','delight','wander']], fr: ['Mot anglais du jour', 'Apprenez chaque jour un mot anglais utile.', 'Mot suivant', ['serendipity','resilient','curious','delight','wander']], pt: ['Palavra inglesa do dia', 'Aprenda uma palavra útil em inglês todos os dias.', 'Próxima palavra', ['serendipity','resilient','curious','delight','wander']], vi: ['Từ tiếng Anh hôm nay', 'Học một từ tiếng Anh hữu ích mỗi ngày.', 'Từ tiếp theo', ['serendipity','resilient','curious','delight','wander']], id: ['Kata bahasa Inggris hari ini', 'Pelajari satu kata bahasa Inggris yang berguna setiap hari.', 'Kata berikutnya', ['serendipity','resilient','curious','delight','wander']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Daily English word', 'Learn one useful English word each day.', 'Next word', ['serendipity', 'resilient', 'curious', 'delight', 'wander']];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, English vocabulary, ManyTool`}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><div id="word" class="mt-8 text-5xl font-black text-cyan-700"></div><button id="next" class="mt-8 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[2]}</button></section></main><Footer /></Layout>
<script is:inline define:vars={{ words: text[3] }}>
  let i = new Date().getDate() % words.length; const word = document.querySelector('#word'); const render = () => { word.textContent = words[i]; }; document.querySelector('#next').addEventListener('click', () => { i = (i + 1) % words.length; render(); }); render();
</script>
