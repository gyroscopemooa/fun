---
import Layout from '../../layouts/Layout.astro';
import AdsterraBanner from '../../components/ads/AdsterraBanner.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORY_LABEL, GUIDES, readMinutes, type GuideCategory } from '../../lib/guides';

const categories = (Object.keys(CATEGORY_LABEL) as GuideCategory[]).filter((c) => GUIDES.some((g) => g.category === c));
const guides = [...GUIDES].sort((a, b) => b.updated.localeCompare(a.updated));
---

<Layout
  title="ManyTool 가이드 | PDF·사진·퍼스널컬러·게임 사용법 모음"
  description="PDF 합치기·나누기, HEIC JPG 변환, 한글 HWP PDF 변환, 사진 용량 줄이기, 증명사진 규격, 퍼스널컬러 12톤, 내전 팀 나누기, FPS 감도까지 생활과 게임에 바로 쓰는 실용 가이드를 모았어요."
  keywords="사용법 가이드, PDF 합치기 방법, HEIC JPG 변환 방법, HWP PDF 변환 방법, 사진 용량 줄이기 방법, 증명사진 규격, 퍼스널컬러 12톤, 내전 팀 나누기, FPS 감도"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] p-6 text-white shadow-sm sm:p-8" style="background: radial-gradient(circle at 90% 0%, rgba(99,102,241,0.5), transparent 45%), radial-gradient(circle at 0% 100%, rgba(13,148,136,0.4), transparent 50%), #0f172a">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-200">ManyTool Guides</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">따라 하면 끝나는 실용 가이드</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">자주 막히는 작업을 순서대로 정리했어요. 왜 그런지 이유부터, 상황별 추천 방법, 주의할 점까지 읽고 나면 바로 관련 도구로 이어서 해 볼 수 있어요.</p>
    </section>

    <AdsterraBanner placement="top" />

    <section class="mt-6">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="가이드 분류">
        <button type="button" data-guide-filter="all" role="tab" aria-selected="true" class="guide-filter rounded-full border border-slate-950 bg-slate-950 px-3.5 py-2 text-sm font-bold text-white">전체 {guides.length}</button>
        {categories.map((c) => (
          <button type="button" data-guide-filter={c} role="tab" aria-selected="false" class="guide-filter rounded-full border border-slate-200 bg-white px-3.5 py-2 text-sm font-bold text-slate-700 hover:border-slate-400">{CATEGORY_LABEL[c]} {guides.filter((g) => g.category === c).length}</button>
        ))}
      </div>

      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {guides.map((g) => (
          <li data-guide-card data-category={g.category}>
            <a href={`/guides/${g.slug}`} class="group flex h-full flex-col rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-center gap-2">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-2xl">{g.emoji}</span>
                <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-bold text-indigo-700">{CATEGORY_LABEL[g.category]}</span>
              </div>
              <h2 class="mt-3 text-lg font-black leading-snug text-slate-950 group-hover:underline">{g.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{g.description}</p>
              <p class="mt-3 text-xs font-semibold text-slate-400">읽는 데 약 {readMinutes(g)}분 · 관련 도구 {g.tools.length}개</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8 rounded-[28px] border border-slate-200 bg-white p-5 text-sm leading-7 text-slate-700 shadow-sm sm:p-6">
      <h2 class="text-lg font-black text-slate-950">가이드는 이렇게 만들어요</h2>
      <p class="mt-2">ManyTool 가이드는 실제로 도구를 써 보며 확인한 순서와 결과를 바탕으로 작성합니다. 기관 규격이나 정책처럼 바뀔 수 있는 정보는 출처 기관의 최신 안내를 확인하도록 함께 적어 두고, 내용이 바뀌면 글 상단의 업데이트 날짜를 고칩니다. 잘못된 내용을 발견하면 <a href="/contact" class="font-bold text-indigo-700 underline underline-offset-4">문의하기</a>로 알려 주세요.</p>
    </section>

    <AdsterraBanner placement="bottom" />
  </main>
  <Footer />
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.guide-filter'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-card]'));
  const on = 'border-slate-950 bg-slate-950 text-white';
  const off = 'border-slate-200 bg-white text-slate-700 hover:border-slate-400';
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.guideFilter ?? 'all';
      buttons.forEach((b) => {
        const active = b === button;
        b.setAttribute('aria-selected', String(active));
        b.className = `guide-filter rounded-full border px-3.5 py-2 text-sm font-bold ${active ? on : off}`;
      });
      cards.forEach((card) => { card.hidden = filter !== 'all' && card.dataset.category !== filter; });
    });
  });
</script>
