---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['2026 幸运饼干', '点击卡片查看今天的鼓励语。', '点击打开', ['新的机会正在靠近。', '小小的善意会带来好运。', '慢慢来，也能到达目标。']], es: ['Galleta de la fortuna 2026', 'Haz clic en la tarjeta para ver un mensaje de ánimo.', 'Abrir', ['Una nueva oportunidad se acerca.', 'Un pequeño gesto traerá buena suerte.', 'Avanzar despacio también es avanzar.']], de: ['Glückskeks 2026', 'Klicke auf die Karte für eine ermutigende Botschaft.', 'Öffnen', ['Eine neue Chance kommt näher.', 'Eine kleine Freundlichkeit bringt Glück.', 'Auch langsames Vorankommen zählt.']], fr: ['Cookie de la fortune 2026', 'Cliquez sur la carte pour découvrir un message encourageant.', 'Ouvrir', ['Une nouvelle occasion approche.', 'Une petite gentillesse apportera de la chance.', 'Avancer lentement, c’est aussi avancer.']], pt: ['Biscoito da sorte 2026', 'Clique no cartão para ver uma mensagem de incentivo.', 'Abrir', ['Uma nova oportunidade está chegando.', 'Uma pequena gentileza trará sorte.', 'Avançar devagar também é avançar.']], vi: ['Bánh may mắn 2026', 'Bấm vào thẻ để xem lời nhắn động viên.', 'Mở', ['Một cơ hội mới đang đến gần.', 'Một việc tử tế nhỏ sẽ mang lại may mắn.', 'Tiến chậm vẫn là tiến lên.']], id: ['Kue keberuntungan 2026', 'Klik kartu untuk melihat pesan penyemangat.', 'Buka', ['Peluang baru sedang mendekat.', 'Kebaikan kecil akan membawa keberuntungan.', 'Berjalan pelan tetap berarti maju.']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Fortune cookie 2026', 'Click the card to reveal an encouraging message for today.', 'Open', ['A new opportunity is getting closer.', 'A small act of kindness will bring good luck.', 'Slow progress is still progress.']];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, fortune cookie, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><button id="cookie" class="mx-auto mt-8 flex h-64 w-44 items-center justify-center rounded-3xl bg-gradient-to-br from-amber-300 to-orange-500 text-6xl shadow-xl">🥠</button><p id="message" class="mx-auto mt-5 min-h-12 max-w-md rounded-xl bg-amber-50 p-4 text-sm font-bold text-amber-900">{text[2]}</p></section></main><Footer /></Layout>
<script is:inline define:vars={{ messages: text[3], open: text[2] }}>
  const button = document.querySelector('#cookie'); const message = document.querySelector('#message'); button.addEventListener('click', () => { message.textContent = messages[Math.floor(Math.random() * messages.length)]; button.textContent = '✨'; });
</script>
