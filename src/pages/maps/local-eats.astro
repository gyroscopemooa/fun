---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalEats from '../../components/LocalEats';
---
<Layout title="혼밥가능 / 맛집추천 지도 | 지역 맛집 찾기 | ManyTool" description="혼자 먹기 편한 동네 맛집을 찾아보세요. 혼밥 가능 여부, 1인석과 1인 주문 정보, 방문자 별점과 댓글을 지도에서 함께 확인합니다.">
  <Header />
  <main>
  <LocalEats client:load url={import.meta.env.PUBLIC_SUPABASE_URL ?? ''} apiKey={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''} />
  </main>
  <Footer />
</Layout>
