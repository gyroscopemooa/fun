---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['动物脸型测试', '回答几个轻松的问题，看看你更接近哪种动物气质。', ['你更喜欢安静的地方吗？', '你的朋友觉得你很亲切吗？', '你行动速度很快吗？', '你喜欢独立完成事情吗？'], ['是', '否'], ['猫系', '狗系', '狐狸系', '熊系'], '你的结果' ], es: ['Test de rostro animal', 'Responde unas preguntas y descubre tu energía animal.', ['¿Prefieres lugares tranquilos?', '¿Tus amigos te consideran amable?', '¿Actúas con mucha rapidez?', '¿Te gusta hacer las cosas de forma independiente?'], ['Sí', 'No'], ['Gato', 'Perro', 'Zorro', 'Oso'], 'Tu resultado'], de: ['Tiergesicht-Test', 'Beantworte Fragen und entdecke deine tierische Ausstrahlung.', ['Magst du ruhige Orte?', 'Halten dich Freunde für freundlich?', 'Handelst du sehr schnell?', 'Machst du Dinge gerne selbstständig?'], ['Ja', 'Nein'], ['Katze', 'Hund', 'Fuchs', 'Bär'], 'Dein Ergebnis'], fr: ['Test de visage animal', 'Répondez à quelques questions et découvrez votre énergie animale.', ['Préférez-vous les endroits calmes ?', 'Vos amis vous trouvent-ils sympathique ?', 'Agissez-vous rapidement ?', 'Aimez-vous faire les choses seul ?'], ['Oui', 'Non'], ['Chat', 'Chien', 'Renard', 'Ours'], 'Votre résultat'], pt: ['Teste de rosto animal', 'Responda a algumas perguntas e descubra sua energia animal.', ['Você prefere lugares tranquilos?', 'Seus amigos consideram você gentil?', 'Você age rapidamente?', 'Gosta de fazer as coisas sozinho?'], ['Sim', 'Não'], ['Gato', 'Cachorro', 'Raposa', 'Urso'], 'Seu resultado'], vi: ['Trắc nghiệm khuôn mặt động vật', 'Trả lời vài câu hỏi để khám phá khí chất động vật của bạn.', ['Bạn thích nơi yên tĩnh?', 'Bạn bè thấy bạn thân thiện?', 'Bạn hành động nhanh?', 'Bạn thích tự làm mọi việc?'], ['Có', 'Không'], ['Mèo', 'Chó', 'Cáo', 'Gấu'], 'Kết quả của bạn'], id: ['Tes wajah hewan', 'Jawab beberapa pertanyaan dan temukan aura hewanmu.', ['Apakah kamu suka tempat yang tenang?', 'Apakah teman menganggapmu ramah?', 'Apakah kamu bertindak cepat?', 'Apakah kamu suka melakukan sesuatu sendiri?'], ['Ya', 'Tidak'], ['Kucing', 'Anjing', 'Rubah', 'Beruang'], 'Hasil kamu'], en: ['Animal personality test', 'Answer a few questions to see which animal energy fits you.', ['Do you prefer quiet places?', 'Do friends find you friendly?', 'Do you act quickly?', 'Do you like doing things independently?'], ['Yes', 'No'], ['Cat', 'Dog', 'Fox', 'Bear'], 'Your result'] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? copy.en;
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, animal face test, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><div id="stage" class="mt-6 rounded-2xl bg-slate-50 p-6"><button id="start" class="rounded-xl bg-orange-600 px-5 py-3 font-bold text-white">Start</button></div></section></main><Footer /></Layout>
<script is:inline define:vars={{ text }}>
  const stage = document.querySelector('#stage'); let index = 0; const scores = [0,0,0,0]; const render = () => { if (index >= text[2].length) { const best = scores.indexOf(Math.max(...scores)); stage.innerHTML = `<p class="text-sm font-bold text-orange-700">${text[5]}</p><p class="mt-3 text-5xl font-black text-slate-950">${text[4][best]}</p>`; return; } stage.innerHTML = `<p class="text-lg font-black text-slate-950">${index + 1}. ${text[2][index]}</p><div class="mt-5 flex gap-3"><button id="yes" class="flex-1 rounded-xl bg-slate-950 px-4 py-3 font-bold text-white">${text[3][0]}</button><button id="no" class="flex-1 rounded-xl border border-slate-300 px-4 py-3 font-bold text-slate-700">${text[3][1]}</button></div>`; document.querySelector('#yes').onclick = () => { scores[index % 4] += 2; index += 1; render(); }; document.querySelector('#no').onclick = () => { scores[(index + 1) % 4] += 1; index += 1; render(); }; }; document.querySelector('#start').onclick = () => { index = 0; scores.fill(0); render(); };
</script>
