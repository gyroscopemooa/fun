---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="URL 인코더·디코더 | URL Encoding | ManyTool" description="한글 URL과 쿼리 문자열을 인코딩하거나 디코딩하는 무료 온라인 도구입니다." keywords="URL 인코딩, URL 디코딩, URL encoder, URL decoder"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Developer Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">URL 인코더·디코더</h1><p class="mt-3 text-sm leading-7 text-slate-300">URL에 사용할 수 있도록 문자열을 변환하거나 원래 문자열로 복원합니다.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><textarea id="input" rows="7" placeholder="한글, 공백, 특수문자를 입력하세요." class="w-full rounded-2xl border border-slate-300 p-4"></textarea><div class="mt-4 flex gap-3"><button id="enc" class="rounded-xl bg-cyan-500 px-4 py-3 font-bold">인코딩</button><button id="dec" class="rounded-xl bg-slate-200 px-4 py-3 font-bold">디코딩</button></div><textarea id="output" rows="7" readonly class="mt-4 w-full rounded-2xl border border-slate-200 bg-slate-50 p-4"></textarea></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const i=document.getElementById('input'),o=document.getElementById('output');document.getElementById('enc').onclick=()=>o.value=encodeURIComponent(i.value);document.getElementById('dec').onclick=()=>{try{o.value=decodeURIComponent(i.value)}catch(e){o.value='디코딩할 수 없는 문자열입니다.'}};</script>
