---
import { familyServices } from '../data/family-services';
---

<section class="px-4 pb-5 lg:px-10" aria-label="live sub 패밀리 서비스 광고">
  <div class="mx-auto max-w-[970px]">
    <p class="mb-1.5 text-center text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-400">Family promotion</p>
    <div class="home-family-ad" data-home-family-ad>
      {familyServices.map((service, index) => (
        <a href={service.href} target="_blank" rel="noopener noreferrer" class:list={['home-family-ad__slide', index === 0 && 'is-active']} data-home-family-slide aria-hidden={index === 0 ? 'false' : 'true'} style={`--ad-accent:${service.accent}`}>
          <span class="home-family-ad__index">{String(index + 1).padStart(2, '0')} / {String(familyServices.length).padStart(2, '0')}</span>
          <span class="home-family-ad__brand">{service.name}</span>
          <span class="home-family-ad__copy">{service.copy}</span>
          <span class="home-family-ad__cta">바로가기 <b aria-hidden="true">↗</b></span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-home-family-ad]').forEach((banner) => {
    const slides = Array.from(banner.querySelectorAll('[data-home-family-slide]'));
    if (slides.length < 2) return;
    let current = 0;
    let timer;
    const next = () => {
      slides[current]?.classList.remove('is-active');
      slides[current]?.setAttribute('aria-hidden', 'true');
      current = (current + 1) % slides.length;
      slides[current]?.classList.add('is-active');
      slides[current]?.setAttribute('aria-hidden', 'false');
    };
    const start = () => { window.clearInterval(timer); timer = window.setInterval(next, 6500); };
    const stop = () => window.clearInterval(timer);
    banner.addEventListener('mouseenter', stop);
    banner.addEventListener('mouseleave', start);
    banner.addEventListener('focusin', stop);
    banner.addEventListener('focusout', start);
    start();
  });
</script>

<style>
  .home-family-ad { position: relative; height: 92px; overflow: hidden; border: 1px solid rgb(30 41 59); border-radius: 14px; background: #090b11; box-shadow: 0 10px 28px rgb(15 23 42 / .1); }
  .home-family-ad::before { position: absolute; inset: 0; content: ''; background: linear-gradient(110deg, transparent 0%, rgb(255 255 255 / .035) 48%, transparent 72%); pointer-events: none; }
  .home-family-ad__slide { position: absolute; inset: 0; display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 18px; padding: 0 24px; color: white; opacity: 0; pointer-events: none; transform: translateX(28px); transition: opacity 700ms ease, transform 700ms ease; }
  .home-family-ad__slide.is-active { opacity: 1; pointer-events: auto; transform: translateX(0); }
  .home-family-ad__index { color: var(--ad-accent); font: 700 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; }
  .home-family-ad__brand { font-size: 21px; font-weight: 900; white-space: nowrap; }
  .home-family-ad__copy { overflow: hidden; color: rgb(203 213 225); font-size: 13px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .home-family-ad__cta { border: 1px solid rgb(255 255 255 / .16); border-radius: 999px; padding: 9px 13px; color: rgb(226 232 240); font-size: 11px; font-weight: 800; white-space: nowrap; transition: border-color 200ms, color 200ms; }
  .home-family-ad__slide:hover .home-family-ad__cta, .home-family-ad__slide:focus-visible .home-family-ad__cta { border-color: var(--ad-accent); color: var(--ad-accent); }
  .home-family-ad__slide:focus-visible { outline: 2px solid var(--ad-accent); outline-offset: -3px; }
  @media (max-width: 640px) {
    .home-family-ad { height: 86px; }
    .home-family-ad__slide { grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; padding: 0 14px; }
    .home-family-ad__index { display: none; }
    .home-family-ad__brand { font-size: 17px; }
    .home-family-ad__copy { font-size: 11px; }
    .home-family-ad__cta { padding: 8px; font-size: 0; }
    .home-family-ad__cta b { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .home-family-ad__slide { transition: none; } }
</style>
