---
// Shared "how to use" section for tool pages: what it is, steps, use cases, tips and FAQ (with FAQPage JSON-LD).
// Copy lives in src/lib/tool-guides; the guide is picked by the page path unless `slug` is passed.
import { getToolGuide } from '../lib/tool-guides';

interface Props {
  slug?: string;
}

const path = Astro.props.slug ?? Astro.url.pathname;
const guide = getToolGuide(path);
const faqJsonLd = guide
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: guide.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
    }
  : null;
---

{guide && (
  <section class="mt-8 overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm" aria-labelledby="tool-guide-title">
    <div class="border-b border-slate-100 bg-[linear-gradient(135deg,#f8fafc,#eef2ff)] px-5 py-6 sm:px-7">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-indigo-500">Guide</p>
      <h2 id="tool-guide-title" class="mt-1 text-xl font-black text-slate-950 sm:text-2xl">{guide.name}, 이렇게 활용하세요</h2>
      <div class="mt-3 space-y-2 text-sm leading-7 text-slate-700">
        {guide.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="grid gap-6 px-5 py-6 sm:px-7 md:grid-cols-2">
      <div>
        <h3 class="text-base font-black text-slate-900">사용 방법</h3>
        <ol class="mt-3 space-y-2.5">
          {guide.steps.map((step, i) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-700">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-black text-white">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h3 class="text-base font-black text-slate-900">이럴 때 써 보세요</h3>
        <ul class="mt-3 space-y-2">
          {guide.useCases.map(([title, text]) => (
            <li class="rounded-2xl bg-slate-50 px-4 py-3">
              <p class="text-sm font-bold text-slate-900">{title}</p>
              <p class="mt-0.5 text-sm leading-6 text-slate-600">{text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {guide.tips.length > 0 && (
      <div class="mx-5 mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-4 sm:mx-7">
        <h3 class="text-sm font-black text-amber-900">알아 두면 좋은 점</h3>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6 text-amber-900/90">
          {guide.tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </div>
    )}

    <div class="border-t border-slate-100 px-5 py-6 sm:px-7">
      <h3 class="text-base font-black text-slate-900">자주 묻는 질문</h3>
      <div class="mt-3 divide-y divide-slate-100 rounded-2xl border border-slate-200">
        {guide.faq.map(([q, a]) => (
          <details class="group px-4 py-3">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-slate-900">
              <span>Q. {q}</span>
              <span class="text-slate-400 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-2 text-sm leading-6 text-slate-600">{a}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </section>
)}
