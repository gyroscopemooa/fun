---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['个人色彩测试', '回答问题，获得一个轻量的色彩季型建议。', '开始测试', '你的色彩类型', ['春季暖色', '夏季柔色', '秋季深色', '冬季冷色']], es: ['Test de color personal', 'Responde unas preguntas para obtener una sugerencia de temporada de color.', 'Comenzar', 'Tu tipo de color', ['Primavera cálida', 'Verano suave', 'Otoño profundo', 'Invierno frío']], de: ['Personal-Farbtest', 'Beantworte Fragen und erhalte eine saisonale Farbanalyse.', 'Starten', 'Dein Farbtyp', ['Warmer Frühling', 'Sanfter Sommer', 'Tiefer Herbst', 'Kühler Winter']], fr: ['Test de colorimétrie', 'Répondez à quelques questions pour obtenir une suggestion de saison.', 'Commencer', 'Votre type de couleur', ['Printemps chaud', 'Été doux', 'Automne profond', 'Hiver froid']], pt: ['Teste de coloração pessoal', 'Responda a perguntas para receber uma sugestão de estação de cores.', 'Começar', 'Seu tipo de cor', ['Primavera quente', 'Verão suave', 'Outono profundo', 'Inverno frio']], vi: ['Trắc nghiệm màu cá nhân', 'Trả lời câu hỏi để nhận gợi ý nhóm màu theo mùa.', 'Bắt đầu', 'Nhóm màu của bạn', ['Xuân ấm', 'Hạ dịu', 'Thu trầm', 'Đông lạnh']], id: ['Tes warna personal', 'Jawab pertanyaan untuk mendapat saran musim warna.', 'Mulai', 'Tipe warna kamu', ['Musim semi hangat', 'Musim panas lembut', 'Musim gugur dalam', 'Musim đông lạnh']], en: ['Personal color test', 'Answer a few questions to get a light seasonal color suggestion.', 'Start test', 'Your color type', ['Warm spring', 'Soft summer', 'Deep autumn', 'Cool winter']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? copy.en;
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, personal color test, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><button id="run" class="mt-8 rounded-xl bg-rose-600 px-6 py-3 font-bold text-white">{text[2]}</button><div id="result" class="mt-6 hidden rounded-3xl bg-gradient-to-br from-rose-50 to-amber-50 p-8"><p class="text-sm font-bold text-rose-700">{text[3]}</p><p id="type" class="mt-3 text-4xl font-black text-slate-950"></p></div></section></main><Footer /></Layout>
<script is:inline define:vars={{ types: text[4] }}>
  document.querySelector('#run').addEventListener('click', () => { document.querySelector('#type').textContent = types[Math.floor(Math.random() * types.length)]; document.querySelector('#result').classList.remove('hidden'); });
</script>
