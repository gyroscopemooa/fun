---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageWorkshop from '../components/ImageWorkshop';
---
<Layout title="이미지 자르기 | ManyTool" description="사진에서 필요한 영역을 골라 원본 해상도의 PNG로 저장하세요. 사진은 서버로 전송되지 않습니다."><Header /><main class="mx-auto max-w-5xl px-4 py-10"><a href="/image-tools" class="text-sm font-bold text-violet-700">← 이미지 도구 모음</a><section class="mt-5 rounded-[28px] bg-slate-950 p-8 text-white"><p class="text-xs font-bold tracking-widest text-violet-300">MANYTOOL · IMAGE TOOLS</p><h1 class="mt-3 text-3xl font-black sm:text-4xl">이미지 자르기</h1><p class="mt-4 leading-7 text-slate-300">사진에서 필요한 영역을 골라 원본 해상도의 PNG로 저장하세요. 사진은 서버로 전송되지 않습니다.</p></section><ImageWorkshop mode="crop" client:load /></main><Footer /></Layout>
