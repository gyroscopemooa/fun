---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const apiBase = (import.meta.env.PUBLIC_NODE_API_BASE ?? 'http://127.0.0.1:8787').replace(/\/+$/, '');
---
<Layout title="크레딧 충전 | ManyTool" description="필요한 만큼 충전하고 여러 AI 도구에서 사용하세요. 1크레딧은 1,000원이며 대량 구매도 같은 단가입니다." noindex>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-10">
    {import.meta.env.DEV && apiBase === 'http://127.0.0.1:8788' && <aside class="mb-5 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm" role="note">
      <strong>로컬 로그인 테스트</strong>
      <p class="mt-2">이메일 입력 후 <a class="font-bold underline" href="http://127.0.0.1:8788/" target="_blank" rel="noopener noreferrer">로컬 메일함</a>에서 인증 링크를 눌러주세요. 실제 메일은 발송하지 않으며 충전·결제는 비활성 상태입니다. 서버를 종료하면 테스트 계정과 내역이 초기화됩니다.</p>
    </aside>}
    <section class="rounded-3xl bg-slate-950 p-8 text-white sm:p-12">
      <p class="text-sm font-bold tracking-widest text-cyan-300">MANYTOOL CREDITS</p>
      <h1 class="mt-3 text-3xl font-black sm:text-4xl">필요한 만큼 충전하고,<br/>쓸 때마다 간편하게.</h1>
      <p class="mt-5 leading-7 text-slate-300">1크레딧 = 1,000원. 10개부터 300개까지 같은 단가로 충전하세요.<br/>기존 개별구매도 계속 이용할 수 있습니다.</p>
    </section>
    <p id="credit-status" role="status" aria-live="polite" class="my-5 rounded-xl bg-slate-100 p-4 text-sm">충전 가능 여부를 확인하고 있습니다.</p>
    <section class="mb-8 rounded-2xl border border-slate-200 p-6">
      <div id="credit-login">
        <h2 class="text-xl font-bold">회원가입 · 로그인</h2>
        <p class="mt-2 text-sm text-slate-600">이메일 인증 링크로 처음 이용을 시작하거나 로그인하세요. 별도 비밀번호 없이 같은 이메일로 크레딧 잔액과 충전·사용 내역을 확인할 수 있어요.</p>
        <form id="credit-login-form" class="mt-4 flex flex-wrap gap-3">
          <label for="credit-email" class="sr-only">이메일 주소</label>
          <input id="credit-email" type="email" autocomplete="email" required placeholder="이메일 주소" class="min-w-0 flex-1 rounded-xl border border-slate-300 px-4 py-3" />
          <button id="credit-login-button" disabled class="rounded-xl bg-slate-900 px-5 py-3 font-bold text-white disabled:opacity-40">로그인 링크 받기</button>
        </form>
      </div>
      <div id="credit-wallet" hidden>
        <p id="credit-account" class="text-sm text-slate-500"></p>
        <p class="mt-2 text-3xl font-black">내 크레딧 <span id="credit-balance">0</span>개</p>
        <div class="mt-4 flex gap-4"><button id="credit-refresh" class="font-bold text-cyan-800">잔액 새로고침</button><button id="credit-logout" class="text-slate-500">로그아웃</button></div>
      </div>
    </section>
    <h2 class="mb-4 text-2xl font-bold">충전할 크레딧 선택</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {[10, 50, 300].map(count => <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-3xl font-black">{count}<span class="ml-1 text-base font-medium text-slate-500">크레딧</span></h3>
        <p class="mt-5 text-2xl font-bold">{(count * 1000).toLocaleString('ko-KR')}원</p>
        <p class="mt-2 text-sm text-slate-500">개당 1,000원 · 묶음 할인 없음</p>
        <button data-credit-pack={count} disabled class="mt-6 w-full rounded-xl bg-cyan-700 px-4 py-3 font-bold text-white disabled:opacity-40">충전 준비 중</button>
      </article>)}
    </div>
    <p class="mt-4 text-sm text-slate-500">자동충전·자동갱신 없이 선택한 수량만 1회 결제합니다. 적용 세금과 최종 결제액은 결제 화면에서 확인하세요.</p>
    <aside class="mt-4 rounded-xl border border-slate-200 p-4 text-sm leading-7">
      <p class="font-bold">충전 환불 기준</p>
      <p>고객 사유로 충전 잔액을 환불하는 경우, 사용한 크레딧은 구매 시 고지된 정상 단가인 개당 1,000원으로 정산합니다. 할인 충전 상품도 동일하며, 실제 충전 결제액에서 사용분을 공제합니다. 환불액은 최소 0원이고 추가 청구하지 않습니다.</p>
      <p>사용하지 않은 충전은 결제액 전액을 기준으로 검토합니다. 법령상 보장되는 권리와 서비스 장애 등 사업자 귀책 사유에 따른 환불은 별도로 처리합니다. 적용 세금은 결제사 기준으로 정산됩니다.</p>
      <label class="mt-3 flex items-start gap-2"><input id="credit-policy-accepted" type="checkbox" class="mt-2" /> <span><a href="/refund-policy#credits" class="underline">충전 환불 기준</a>을 확인했습니다.</span></label>
    </aside>
    <section class="mt-10 rounded-2xl bg-slate-50 p-6">
      <h2 class="text-xl font-bold">도구별 사용 크레딧</h2>
      <p class="mt-2 text-sm leading-7 text-slate-600">실행 전에 차감량을 확인하고 선택하세요. 예를 들어 단건 가격이 4,500원인 상품은 5크레딧으로 설정할 수 있어요. 개별구매 가격과 크레딧 가격은 다를 수 있습니다.</p>
      <div id="credit-tools" class="mt-4 divide-y divide-slate-200"><p class="py-3 text-sm text-slate-500">도구별 차감량을 준비하고 있습니다.</p></div>
    </section>
    <section id="credit-pending-section" hidden class="mt-8"><h2 class="text-xl font-bold">아직 사용하지 않은 주문</h2><p class="mt-2 text-sm text-slate-500">실행 전 주문을 취소하면 차감한 크레딧이 돌아옵니다.</p><div id="credit-pending" class="mt-3 space-y-2"></div></section>
    <section id="credit-history-section" hidden class="mt-8"><h2 class="text-xl font-bold">최근 충전·사용 내역</h2><ul id="credit-history" class="mt-3 divide-y divide-slate-200"></ul></section>
    <section id="credit-topups-section" hidden class="mt-8"><h2 class="text-xl font-bold">충전별 환불 확인</h2><p class="mt-2 text-sm text-slate-500">신청 전 사용분 공제액과 예상 환불액을 확인하세요. 신청한 충전의 잔액은 검토·환불 처리 중 사용할 수 없습니다.</p><div id="credit-topups" class="mt-3 space-y-3"></div></section>
    <p class="mt-8 text-sm leading-7 text-slate-500">처리 실패가 확인되면 사용 크레딧을 복구합니다. 충전 결제의 환불은 <a href="/refund-policy" class="underline">환불정책</a>과 <a href="/contact" class="underline">문의하기</a>를 통해 확인해주세요.</p>
  </main>
  <Footer />
  <script is:inline define:vars={{ apiBase }}>
    (() => {
      const $ = id => document.getElementById(id);
      let config = null, wallet = null, buying = false;
      const status = text => { $('credit-status').textContent = text; };
      const call = async (path, body) => {
        const response = await fetch(`${apiBase}/credits${path}`, { credentials: 'include', ...(body !== undefined ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) } : {}), signal: AbortSignal.timeout(25000) });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data) throw Object.assign(new Error(data?.error || '크레딧 서비스를 준비하고 있습니다. 기존 개별구매를 이용해주세요.'), { status: response.status });
        return data;
      };
      const buttons = () => document.querySelectorAll('[data-credit-pack]').forEach(button => {
        const available = config?.packs?.find(p => p.id === button.dataset.creditPack)?.available;
        button.disabled = !available || !wallet || buying || !$('credit-policy-accepted').checked;
        button.textContent = !available ? '충전 준비 중' : !wallet ? '로그인 후 충전' : buying ? '결제 준비 중…' : '충전하기';
      });
      const loadWallet = async () => {
        try { wallet = await call('/me'); } catch (error) { if (error.status !== 401) throw error; wallet = null; }
        $('credit-login').hidden = !!wallet; $('credit-wallet').hidden = !wallet;
        $('credit-history-section').hidden = !wallet; $('credit-pending-section').hidden = !wallet?.pending?.length;
        $('credit-topups-section').hidden = !wallet?.topups?.length;
        if (wallet) {
          $('credit-account').textContent = wallet.email; $('credit-balance').textContent = wallet.balance.toLocaleString();
          $('credit-history').replaceChildren();
          for (const entry of wallet.history) {
            const li = document.createElement('li'); li.className = 'flex justify-between gap-4 py-3 text-sm';
            li.textContent = `${new Date(entry.created).toLocaleString('ko-KR')} · ${entry.kind} · ${entry.delta > 0 ? '+' : ''}${entry.delta}개`; $('credit-history').append(li);
          }
          if (!wallet.history.length) $('credit-history').textContent = '아직 내역이 없습니다.';
          $('credit-pending').replaceChildren();
          for (const order of wallet.pending) {
            const button = document.createElement('button'); button.className = 'block rounded-xl border border-slate-300 p-3 text-sm';
            button.textContent = `미사용 주문 ${order.id.slice(0, 8)} · ${order.credits}개 취소·복구`;
            button.onclick = async () => { button.disabled = true; try { await call('/cancel', { orderId: order.id }); await loadWallet(); status('미사용 크레딧을 복구했습니다.'); } catch (e) { status(e.message); button.disabled = false; } }; $('credit-pending').append(button);
          }
          $('credit-topups').replaceChildren();
          for (const topup of wallet.topups || []) {
            const card = document.createElement('div'); card.className = 'rounded-xl border border-slate-200 p-4';
            const text = document.createElement('p'); text.className = 'break-all'; text.textContent = `${topup.credits}개 · ${topup.provider === 'google_play' ? 'Google Play 구매 (금액은 Play 영수증 확인)' : `${topup.amount.toLocaleString()}원 충전`} · 주문 ${topup.id}`; card.append(text);
            if (topup.provider === 'google_play') {
              const notice = document.createElement('p'); notice.className = 'mt-2 text-sm'; notice.textContent = 'Google Play 구매의 결제 금액과 환불은 Google Play 주문 내역에서 확인해주세요.'; card.append(notice);
            } else if (topup.provider === 'nicepay') {
              const notice = document.createElement('p'); notice.className = 'mt-2 text-sm'; notice.textContent = 'NICEPAY 충전 환불은 현재 고객지원에서 결제·사용 내역을 확인한 후 처리합니다.'; card.append(notice);
            } else if (topup.refundStatus) {
              const state = document.createElement('p'); state.className = 'mt-2 text-sm';
              const names = { requested: '환불 검토 대기', completed: '환불 완료', review: '환불 내역 확인 중' };
              state.textContent = `${names[topup.refundStatus] || '확인 중'} · ${topup.refundAmount.toLocaleString()}원`; card.append(state);
            } else if (topup.status === 'paid') {
              const preview = document.createElement('button'); preview.textContent = '환불 예상액 확인'; preview.className = 'mt-3 font-bold text-cyan-800';
              preview.onclick = async () => {
                preview.disabled = true;
                try {
                  const q = await call('/refund/quote', { topupId: topup.id });
                  const details = document.createElement('p'); details.className = 'mt-3 text-sm leading-7';
                  details.textContent = `결제액 ${q.paidAmount.toLocaleString()}원 − 사용 ${q.usedCredits}개 × 정상 단가 ${q.unitKrw.toLocaleString()}원 = 예상 환불액 ${q.refundAmount.toLocaleString()}원. 남은 ${q.remainingCredits}개는 신청 후 사용할 수 없습니다. 적용 세금 및 법정 환불 사유는 검토 시 별도 확인합니다.`;
                  const confirm = document.createElement('button'); confirm.textContent = '예상액 확인 후 환불 신청'; confirm.className = 'mt-3 rounded-lg bg-slate-900 px-4 py-2 text-white'; confirm.disabled = !q.refundAmount || !q.remainingCredits;
                  confirm.onclick = async () => { confirm.disabled = true; try { await call('/refund/request', { ...q, confirmed: true }); await loadWallet(); status('환불 신청을 접수했습니다. 해당 충전 잔액은 처리 중 잠깁니다. 문의 시 충전 주문번호를 알려주세요.'); } catch (e) { status(e.message); confirm.disabled = false; } };
                  card.append(details, confirm); preview.remove();
                } catch (e) { status(e.message); preview.disabled = false; }
              }; card.append(preview);
            }
            $('credit-topups').append(card);
          }
        }
        buttons();
      };
      $('credit-policy-accepted').onchange = buttons;
      $('credit-login-form').onsubmit = async e => { e.preventDefault(); $('credit-login-button').disabled = true; try { await call('/login', { email: $('credit-email').value }); status('이메일로 로그인 링크를 보냈습니다. 15분 이내에 열어주세요.'); } catch (error) { status(error.message); } finally { $('credit-login-button').disabled = !(config?.walletAvailable || config?.enabled); } };
      $('credit-refresh').onclick = () => loadWallet().then(() => status('잔액과 내역을 갱신했습니다.')).catch(e => status(e.message));
      $('credit-logout').onclick = async () => { try { await call('/logout', {}); await loadWallet(); status('로그아웃했습니다.'); } catch (e) { status(e.message); } };
      document.querySelectorAll('[data-credit-pack]').forEach(button => { button.onclick = async () => {
        if (buying) return; buying = true; buttons();
        try { const data = await call('/topup', { packId: button.dataset.creditPack, refundPolicyVersion: config.refundPolicyVersion }); window.location.assign(data.checkoutUrl); }
        catch (error) { status(error.message); buying = false; buttons(); }
      }; });
      (async () => {
        try {
          const token = window.manytoolCreditLoginToken || new URLSearchParams(location.hash.slice(1)).get('login');
          delete window.manytoolCreditLoginToken;
          if (token) { history.replaceState({}, '', location.pathname + location.search); await call('/session', { token }); }
          config = await call('/config'); $('credit-login-button').disabled = !(config.walletAvailable || config.enabled);
          if (config.walletAvailable || config.enabled) await loadWallet();
          const entries = Object.entries(config.tools || {});
          if (entries.length) { $('credit-tools').replaceChildren(); for (const [, item] of entries) { const p = document.createElement('p'); p.className = 'flex justify-between py-3 text-sm'; p.textContent = `${item.label} · ${item.credits}크레딧 (${item.amountKrw.toLocaleString()}원 상당)`; $('credit-tools').append(p); } }
          buttons(); status(config.enabled ? '개별구매 또는 크레딧 사용을 선택할 수 있습니다.' : '크레딧 충전은 준비 중입니다. 지금은 기존 개별구매를 이용해주세요.');
          const topup = new URLSearchParams(location.search).get('topup');
          if (topup && wallet) {
            for (let n = 0; n < 20; n++) {
              const paid = await call(`/topup/${encodeURIComponent(topup)}`);
              if (paid.status === 'paid' || paid.status === 'refunded') { await loadWallet(); status(paid.status === 'paid' ? `${paid.credits}크레딧 충전이 완료되었습니다.` : '환불된 충전 주문입니다.'); return; }
              status('결제를 확인하고 있습니다. 확인이 끝나면 잔액에 반영됩니다.'); await new Promise(resolve => setTimeout(resolve, 3000));
            }
            status('결제 확인이 지연되고 있습니다. 잠시 후 잔액을 새로고침해주세요. 다시 결제할 필요는 없습니다.');
          }
        } catch (error) { status(error.message || '충전 서비스에 연결하지 못했습니다.'); }
      })();
    })();
  </script>
</Layout>
