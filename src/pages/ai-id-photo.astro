    };

    const ensureRecommendedSelection = () => {
      if (!Array.isArray(candidates) || candidates.length === 0) return;
      if (candidates.some((item) => item.selected)) return;
      candidates = candidates.map((item, idx) => ({
        ...item,
        selected: idx === 0
      }));
    };

    const renderCandidates = () => {
      if (!(gridEl instanceof HTMLElement)) return;
      gridEl.innerHTML = '';
      candidates.forEach((item, idx) => {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = `overflow-hidden rounded-2xl border bg-white p-2 text-left shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${item.selected ? 'border-emerald-500 ring-2 ring-emerald-300' : 'border-slate-200'}`;
        const isTopPick = candidates.length > 1 && typeof item.score === 'number' && candidates.every((c) => typeof c.score !== 'number' || c.score <= item.score);
        card.innerHTML = `
          <div class="relative">
            <img src="${item.url}" alt="후보 ${idx + 1}" class="aspect-[3/4] w-full rounded-xl bg-slate-100 object-cover" />
            <div class="absolute left-3 top-3 flex items-center gap-2">
              <span class="rounded-full bg-white/92 px-2.5 py-1 text-[11px] font-black text-slate-900 shadow-sm">옵션 ${idx + 1}</span>
              ${isTopPick ? '<span class="rounded-full bg-amber-400 px-2.5 py-1 text-[11px] font-black text-slate-950 shadow-sm">⭐ AI 추천</span>' : ''}
            </div>
            ${item.selected ? '<span class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-base font-black text-white shadow-lg">✓</span>' : ''}
          </div>
          <div class="mt-2 flex items-center justify-between px-1">
            <p class="text-sm font-bold text-slate-800">후보 ${idx + 1}</p>
            <span class="text-xs font-semibold ${item.selected ? 'text-emerald-600' : 'text-slate-400'}">${item.selected ? '선택됨' : '탭해서 선택'}</span>
          </div>
          <div class="mt-2 rounded-xl bg-slate-50 px-3 py-2 text-[11px] leading-5 text-slate-600">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span><strong class="text-slate-900">점수</strong> ${typeof item.score === 'number' ? item.score.toFixed(1) : 'n/a'}</span>
              <span><strong class="text-slate-900">동일성</strong> ${typeof item.identityScore === 'number' ? item.identityScore.toFixed(1) : 'n/a'}</span>
              <span><strong class="text-slate-900">규격</strong> ${typeof item.qualityScore === 'number' ? item.qualityScore.toFixed(1) : 'n/a'}</span>
              ${item.regenerated ? '<span class="rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-800">안전 재생성</span>' : ''}
            </div>
          </div>
        `;
        card.addEventListener('click', () => {
          const selectedCount = candidates.filter((c) => c.selected).length;
          if (!item.selected && selectedCount >= 1) {
            window.alert('후보 이미지는 1개만 선택할 수 있습니다.');
            setStatus('최대 1장까지 선택할 수 있습니다.');
            return;
          }
          item.selected = !item.selected;
          renderCandidates();
        });
        gridEl.append(card);
      });
      if (downloadBtn instanceof HTMLButtonElement) {
        downloadBtn.disabled = candidates.filter((c) => c.selected).length !== 1;
      }
      syncMobileActionBar();
      savePageState();
    };

    const restorePageState = () => {
      try {
        const raw = localStorage.getItem(PAGE_STATE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (parsed.savedAt && Date.now() - Number(parsed.savedAt) > 1000 * 60 * 60 * 24 * 3) {
          localStorage.removeItem(PAGE_STATE_KEY);
          return;
        }
        if (outfitEl instanceof HTMLSelectElement && typeof parsed.outfit === 'string') {
          outfitEl.value = parsed.outfit;
        }
        if (providerSelectEl instanceof HTMLSelectElement && typeof parsed.provider === 'string') {
          providerSelectEl.value = parsed.provider;
          updateProviderHelp();
        }
        if (Array.isArray(parsed.candidates) && parsed.candidates.length > 0) {
          candidates = parsed.candidates
            .filter((item) => typeof item.url === 'string')
            .map((item) => ({
              id: item.id || `restored_${Date.now()}`,
              url: item.url,
              selected: Boolean(item.selected),
              downloadUrl: item.downloadUrl || null,
              recommended: Boolean(item.recommended),
              score: item.score ?? null,
              identityScore: item.identityScore ?? null,
              qualityScore: item.qualityScore ?? null,
              regenerated: Boolean(item.regenerated)
            }));
          ensureRecommendedSelection();
          renderCandidates();
          if (compareAfterEl instanceof HTMLImageElement) compareAfterEl.src = candidates[0].url;
          if (compareHelpEl instanceof HTMLElement) compareHelpEl.textContent = '이전 생성 결과를 복원했습니다.';
          setStatus('이전 후보 결과를 복원했습니다. 필요하면 다시 생성할 수 있습니다.');
        }
        basePaid = Boolean(parsed.basePaid);
        baseOrderId = typeof parsed.baseOrderId === 'string' ? parsed.baseOrderId : null;
        creditedBaseOrders = Array.isArray(parsed.creditedBaseOrders) ? parsed.creditedBaseOrders.filter((item) => typeof item === 'string') : [];
        if (basePaid && baseOrderId && !creditedBaseOrders.includes(baseOrderId)) {
          creditedBaseOrders.push(baseOrderId);
        }
        addonOrders = {
          add2: typeof parsed?.addonOrders?.add2 === 'string' ? parsed.addonOrders.add2 : null,
          add3: typeof parsed?.addonOrders?.add3 === 'string' ? parsed.addonOrders.add3 : null,
          add7: typeof parsed?.addonOrders?.add7 === 'string' ? parsed.addonOrders.add7 : null
        };
        renderJobDebugLink(typeof parsed.latestJobId === 'string' ? parsed.latestJobId : null);
      } catch {}
    };

    const verifyBaseOrder = async () => {
      if (!baseOrderId) return;
      try {
        const res = await fetch(`${API_BASE}/order/${baseOrderId}`);
        if (!res.ok) return;
        const order = await res.json();
        if (String(order.status) === 'paid' && baseOrderId && !creditedBaseOrders.includes(baseOrderId)) {
          creditedBaseOrders.push(baseOrderId);
          basePaid = true;
        }
        savePageState();
      } catch {}
    };

    const fetchOrder = async (orderId) => {
      if (!orderId) return null;
      const res = await fetch(`${API_BASE}/order/${orderId}`);
      if (!res.ok) return null;
      return res.json();
    };

    const requestRefund = async (orderId, reason = 'service_disruption') => {
      if (!orderId || !apiOnline || paymentMode !== 'polar') return false;
      const res = await fetch(`${API_BASE}/refund`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, reason })
      });
      return res.ok;
    };

    const centerCropTo34 = (img, shiftX = 0, shiftY = 0, filter = 'none') => {
      const ratio = 3 / 4;
      const srcW = img.naturalWidth || img.width;
      const srcH = img.naturalHeight || img.height;
      let cropW = srcW;
      let cropH = Math.round(cropW / ratio);
      if (cropH > srcH) {
        cropH = srcH;
        cropW = Math.round(cropH * ratio);
      }
      const baseX = Math.floor((srcW - cropW) / 2);
      const baseY = Math.floor((srcH - cropH) / 2);
      const x = Math.max(0, Math.min(srcW - cropW, baseX + shiftX));
      const y = Math.max(0, Math.min(srcH - cropH, baseY + shiftY));
      const canvas = document.createElement('canvas');
      canvas.width = 600;
      canvas.height = 800;
      const ctx = canvas.getContext('2d');
      if (!ctx) return '';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.filter = filter;
      ctx.drawImage(img, x, y, cropW, cropH, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/jpeg', 0.92);
    };

    const buildAdjustedUploadAsset = async () => {
      if (!sourceOriginalDataUrl || sourceInputMode !== 'upload') {
        return { dataUrl: sourceDataUrl, file: sourceFile };
      }
      const img = await loadImageFromUrl(sourceOriginalDataUrl);
      const adjustedDataUrl = centerCropTo34(img, sourceAdjust.x, sourceAdjust.y, 'none');
      const blob = dataURLToBlob(adjustedDataUrl);
      const originalName = sourceOriginalFile?.name ?? `upload-${Date.now()}.jpg`;
      const fileName = originalName.replace(/\.[^.]+$/, '') + '-adjusted.jpg';
      const adjustedFile = new File([blob], fileName, { type: 'image/jpeg' });
      return { dataUrl: adjustedDataUrl, file: adjustedFile };
    };

    const applyPcUploadAdjustment = async (runAssessment = false) => {
      if (sourceInputMode !== 'upload' || !sourceOriginalDataUrl) return;
      const adjusted = await buildAdjustedUploadAsset();
      sourceDataUrl = adjusted.dataUrl;
      sourceFile = adjusted.file;
      sourceFaceHint = null;
      sourceUploadAssessment = { messages: [], blocking: false, faceHint: null };
      cachedPhotoId = null;
      candidates = [];
      renderPipelineReport(null);
      renderJobDebugLink(null);
      renderQualityFeedback(null);
      renderProviderResultBadge(null);
      renderCandidates();
      if (sourcePreview instanceof HTMLImageElement) {
        sourcePreview.src = adjusted.dataUrl;
        sourcePreview.classList.remove('hidden');
      }
      if (compareBeforeEl instanceof HTMLImageElement) compareBeforeEl.src = adjusted.dataUrl;
      if (compareAfterEl instanceof HTMLImageElement) compareAfterEl.src = '';
      if (compareHelpEl instanceof HTMLElement) compareHelpEl.textContent = '후보 생성 후 결과 비교가 활성화됩니다.';
      if (compareSliderEl instanceof HTMLInputElement) {
        compareSliderEl.value = '50';
        compareSliderEl.disabled = true;
      }
      if (compareAfterWrapEl instanceof HTMLElement) compareAfterWrapEl.style.width = '50%';
      if (runAssessment && adjusted.file) {
        const assessment = await inspectImageFile(adjusted.file);
        sourceUploadAssessment = assessment;
        sourceFaceHint = assessment.faceHint ?? null;
        renderUploadGuidance(assessment);
        renderBlockingCta(assessment);
      } else {
        renderUploadGuidance(null);
        renderBlockingCta(null);
      }
      updateGenerateAvailability();
      savePageState();
    };

    const generateCandidatesLocalFallback = async (count = 3) => {
      const img = new Image();
      img.src = sourceDataUrl;
      await img.decode();
      const outfit = outfitEl instanceof HTMLSelectElement ? outfitEl.value : 'current';
      const suitFilter = outfit === 'suit' ? 'contrast(1.03) saturate(0.97)' : 'none';
      const variants = [];
      for (let i = 0; i < count; i += 1) {
        const shiftX = (i % 3) * 6;
        const shiftY = (i % 2) * -6;
        const filter = i % 2 === 0 ? suitFilter : `${suitFilter} brightness(1.08)`;
        variants.push({
          id: `candidate_${Date.now()}_${i + 1}`,
          url: centerCropTo34(img, shiftX, shiftY, filter),
          selected: false,
          downloadUrl: null,
          recommended: i === 0,
          score: null,
          identityScore: null,
          qualityScore: null,
          regenerated: false
        });
      }
      candidates = [...candidates, ...variants];
    };

    const uploadSourceIfNeeded = async () => {
      if (cachedPhotoId) return cachedPhotoId;
      if (!sourceFile) throw new Error('source file is missing');
      if (!sourceFaceHint) {
        sourceFaceHint = await detectFaceHintForFile(sourceFile);
      }
      const form = new FormData();
      form.append('image', sourceFile);
      form.append('sourceType', 'upload');
      if (sourceFaceHint) {
        form.append('faceHint', JSON.stringify(sourceFaceHint));
      }
      const uploadRes = await fetch(`${API_BASE}/upload`, { method: 'POST', body: form });
      if (!uploadRes.ok) throw new Error(`upload failed: ${uploadRes.status}`);
      const uploadData = await uploadRes.json();
      if (!uploadData.photoId) throw new Error('photoId missing');
      cachedPhotoId = uploadData.photoId;
      return cachedPhotoId;
    };

    const requestServerCandidates = async (count = 3, orderId = null) => {
      const photoId = await uploadSourceIfNeeded();
      const outfit = outfitEl instanceof HTMLSelectElement ? outfitEl.value : 'current';
      const rounds = Math.ceil(count / 3);
      const generated = [];
      let latestPipelineReport = null;
      let latestResponseJobId = null;

      for (let i = 0; i < rounds; i += 1) {
        const genRes = await fetch(`${API_BASE}/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            photoId,
            toolType: 'id_photo',
            outfitType: outfit,
            orderId: paymentMode === 'polar' ? orderId : null,
            provider: getSelectedProvider()
          })
        });
        if (!genRes.ok) throw new Error(`generate failed: ${genRes.status}`);
        const genData = await genRes.json();
        if (!Array.isArray(genData.candidates)) throw new Error('invalid candidates');
        latestPipelineReport = genData.pipelineReport ?? latestPipelineReport;
        latestResponseJobId = typeof genData.jobId === 'string' ? genData.jobId : latestResponseJobId;
        generated.push(...genData.candidates);
      }

      return {
        jobId: latestResponseJobId,
        candidates: generated.slice(0, count).map((item) => ({
          id: item.id,
          url: `${API_BASE}${item.imageUrl}`,
          selected: false,
          downloadUrl: `${API_BASE}/download/${item.id}`,
          recommended: Boolean(item.recommended),
          score: item.score ?? null,
          identityScore: item.identityScore ?? null,
          qualityScore: latestPipelineReport?.qualityScore ?? null,
          regenerated: Boolean(item.regenerated)
        })),
        pipelineReport: latestPipelineReport
      };
    };

    const generateCandidates = async (count = 3, append = false, orderId = null) => {
      if (!sourceDataUrl || isGenerating) return;
      setBusy(true);
      setStatus('후보를 생성하고 있습니다...');
      try {
        const generation = await requestServerCandidates(count, orderId);
        candidates = append ? [...candidates, ...generation.candidates] : generation.candidates;
        renderPipelineReport(generation.pipelineReport ?? null);
        renderJobDebugLink(generation.jobId ?? null, generation.pipelineReport ?? null);
        renderQualityFeedback(generation.pipelineReport ?? null);
        if (!append) ensureRecommendedSelection();
        const resolvedProvider = generation.pipelineReport?.fallbackToLocalSharp
          ? `local_sharp fallback from ${generation.pipelineReport?.resolvedProvider ?? 'unknown'}`
          : (generation.pipelineReport?.resolvedProvider ?? 'unknown');
        renderProviderResultBadge(generation.pipelineReport ?? null);
        setStatus(`Node API 생성 완료. provider=${resolvedProvider}. 현재 ${candidates.length}장 후보가 준비되었습니다. ${generation.pipelineReport?.qualitySummary ?? ''}`.trim());
      } catch (error) {
        if (paymentMode === 'polar' || !allowLocalFallback) {
          if (!append) candidates = [];
          renderPipelineReport(null);
          renderJobDebugLink(null);
          renderQualityFeedback(null);
          renderProviderResultBadge(null);
          setStatus(paymentMode === 'polar'
            ? (error instanceof Error ? error.message : '결제 모드에서는 무료 대체 생성을 사용할 수 없습니다.')
            : '운영 환경에서는 자동 무료 대체 생성을 사용하지 않습니다.');
          throw error;
        }
        if (!append) candidates = [];
        try {
          await generateCandidatesLocalFallback(count);
          renderPipelineReport(null);
          renderJobDebugLink(null);
          renderQualityFeedback(null);
          renderProviderResultBadge({
            requestedProvider: getSelectedProvider(),
            resolvedProvider: 'local_sharp',
            fallbackToLocalSharp: false,
            externalBackgroundCall: false,
            cache: {}
          });
          if (!append) ensureRecommendedSelection();
          setStatus(`Node API 연결 실패. 로컬 생성 모드로 전환되었습니다. 현재 ${candidates.length}장 후보가 준비되었습니다.`);
        } catch (fallbackError) {
          throw fallbackError;
        }
      }
      finally {
        if (compareAfterEl instanceof HTMLImageElement) compareAfterEl.src = candidates[0]?.url ?? '';
        if (compareHelpEl instanceof HTMLElement) compareHelpEl.textContent = '슬라이더를 움직여 전/후 변화를 비교하세요.';
        if (compareSliderEl instanceof HTMLInputElement) compareSliderEl.disabled = false;
        renderCandidates();
        setBusy(false);
        if (candidates.length > 0) {
          window.setTimeout(scrollToCandidates, 120);
        }
      }
    };

    const requestAddonCheckout = async (count) => {
      const priceMap = { 2: 390, 3: 490, 7: 590 };
      const amount = priceMap[count];
      if (!amount) throw new Error('invalid addon count');
      if (!isPolarProductReady(`add${count}`)) {
        throw new Error(`Polar product is not configured for add${count}`);
      }

      const res = await fetch(`${API_BASE}/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productType: `add${count}`,
          amount,
          currency: 'USD'
        })
      });
      if (!res.ok) throw new Error(`checkout failed: ${res.status}`);
      return res.json();
    };

    const requestBaseCheckout = async () => {
      if (!isPolarProductReady('base')) {
        throw new Error('Polar base product is not configured');
      }
      const res = await fetch(`${API_BASE}/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productType: 'base',
          amount: 990,
          currency: 'USD'
        })
      });
      if (!res.ok) throw new Error(`checkout failed: ${res.status}`);
      return res.json();
    };

    const formatCheckoutAmount = (checkout) => {
      const amount = Number(checkout?.amount ?? 0);
      const currency = String(checkout?.currency ?? 'USD').toUpperCase();
      if (!Number.isFinite(amount) || amount <= 0) return '';
      try {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount / 100);
      } catch {
        return `${amount} ${currency}`;
      }
    };

    const moveToCheckoutIfPending = (checkout, pendingMessage, persistBaseOrder = false) => {
      if (!checkout || !checkout.checkoutUrl || checkout.paid) return false;
      if (persistBaseOrder) {
        baseOrderId = checkout.orderId ?? baseOrderId;
        savePageState();
      }
      const amountLabel = formatCheckoutAmount(checkout);
      setStatus(amountLabel ? `${pendingMessage} Final amount ${amountLabel}` : pendingMessage);
      window.location.href = checkout.checkoutUrl;
      return true;
    };

    const ensureBaseCheckoutForGeneration = async () => {
      if (paymentMode !== 'polar') return null;
      if (!apiOnline) {
        throw new Error('결제 모드에서는 API 연결이 필요합니다.');
      }
      if (basePaid && baseOrderId) return baseOrderId;

      if (baseOrderId) {
        const existingOrder = await fetchOrder(baseOrderId);
        if (existingOrder?.status === 'paid') {
          basePaid = true;
          if (!creditedBaseOrders.includes(baseOrderId)) {
            creditedBaseOrders.push(baseOrderId);
          }
          savePageState();
          return baseOrderId;
        }
        if (existingOrder?.status === 'pending' && existingOrder?.checkoutUrl) {
          window.location.href = existingOrder.checkoutUrl;
          return null;
        }
        if (existingOrder?.status === 'refunded' || existingOrder?.status === 'failed' || existingOrder?.status === 'expired') {
          baseOrderId = null;
          savePageState();
        }
      }

      setStatus('기본 결제를 확인하고 있습니다...');
      const checkout = await requestBaseCheckout();
      if (!checkout.paid) {
        baseOrderId = checkout.orderId ?? baseOrderId;
        savePageState();
        if (moveToCheckoutIfPending(checkout, '결제 페이지로 이동합니다. 결제 후 돌아오면 생성을 시작할 수 있습니다.', true)) return null;
        throw new Error('결제가 완료되지 않았습니다.');
      }

      basePaid = true;
      baseOrderId = checkout.orderId ?? null;
      if (baseOrderId && !creditedBaseOrders.includes(baseOrderId)) {
        creditedBaseOrders.push(baseOrderId);
      }
      savePageState();
      return baseOrderId;
    };

    if (compareSliderEl instanceof HTMLInputElement && compareAfterWrapEl instanceof HTMLElement) {
      compareSliderEl.addEventListener('input', () => {
        compareAfterWrapEl.style.width = `${compareSliderEl.value}%`;
      });
    }

    const loadApiStatus = async () => {
      try {
        const [healthRes, configRes] = await Promise.all([
          fetch(`${API_BASE}/health`),
          fetch(`${API_BASE}/config`)
        ]);
        if (!healthRes.ok || !configRes.ok) throw new Error('status check failed');
        const config = await configRes.json();
        apiOnline = true;
        paymentMode = config?.paymentMode ?? 'mock';
        paymentProducts = {
          base: Boolean(config?.paymentProducts?.base),
          add2: Boolean(config?.paymentProducts?.add2),
          add3: Boolean(config?.paymentProducts?.add3),
          add7: Boolean(config?.paymentProducts?.add7)
        };
        const configuredProvider = config.configuredImageProvider ?? 'unknown';
        const resolvedProvider = config.imageProvider ?? 'unknown';
        const removeBgReady = Boolean(config?.readiness?.removeBgReady);
        const photoroomReady = Boolean(config?.readiness?.photoroomReady);
        providerAvailability = {
          auto: true,
          local_sharp: true,
          remove_bg: Boolean(config?.providerAvailability?.remove_bg),
          photoroom: Boolean(config?.providerAvailability?.photoroom),
          openai_image: Boolean(config?.providerAvailability?.openai_image)
        };
        providerDiagnostics = config?.providerDiagnostics ?? {};
        syncProviderOptions();
        const externalAi = config.externalAiEnabled ? 'ON' : 'OFF';
        const providerBilling = resolvedProvider === 'local_sharp' ? 'free' : 'paid';
        const missingBits = [
          ...(removeBgReady ? [] : ['remove.bg:REMOVE_BG_API_KEY']),
          ...(photoroomReady ? [] : ['photoroom:PHOTOROOM_API_KEY+PHOTOROOM_REMOVE_BG_URL'])
        ];
        setApiStatus(`API 연결됨 · provider=${resolvedProvider}/${providerBilling} (configured=${configuredProvider}) · externalAI=${externalAi} · payment=${config.paymentMode} · remove.bg=${removeBgReady ? 'OK' : 'MISSING'} · photoroom=${photoroomReady ? 'OK' : 'MISSING'}${missingBits.length ? ` · need=${missingBits.join(' | ')}` : ''}`);
        updateProviderHelp();
        if (paymentMode === 'polar' && !paymentProducts.base) {
          setStatus('Polar 기본 상품 ID가 설정되지 않아 실결제를 시작할 수 없습니다.');
        }
        addButtons.forEach((buttonEl) => {
          const count = Number(buttonEl.getAttribute('data-add-count') || '0');
          if (paymentMode === 'polar' && count && !paymentProducts[`add${count}`]) {
            buttonEl.disabled = true;
            buttonEl.title = `Polar add${count} 상품 ID가 필요합니다.`;
          }
        });
      } catch {
        apiOnline = false;
        setApiStatus('API 미연결 · 로컬 fallback 모드');
      }
    };

    if (providerSelectEl instanceof HTMLSelectElement) {
      providerSelectEl.addEventListener('change', () => {
        updateProviderHelp();
        savePageState();
      });
    }

    loadApiStatus();
    restorePageState();
    verifyBaseOrder();

    if (fileInput instanceof HTMLInputElement) {
      fileInput.addEventListener('change', async (e) => {
        const input = e.target;
        const file = input.files && input.files[0];
        if (!file) return;
        if (!validateSelectedFile(file, input)) return;
        stopCamera();
        const reader = new FileReader();
        reader.onload = async () => {
          if (typeof reader.result === 'string') {
            setSource(reader.result, file);
            const assessment = await inspectImageFile(sourceFile ?? file);
            sourceUploadAssessment = assessment;
            sourceFaceHint = assessment.faceHint ?? null;
            renderUploadGuidance(assessment);
            renderBlockingCta(assessment);
            updateGenerateAvailability();
            setStatus(
              assessment.blocking
                ? '사진 품질이 낮아 다시 촬영을 권장합니다.'
                : (assessment.messages[0] ? `${assessment.messages[0]} 계속 진행합니다.` : '사진 업로드 완료.')
            );
          }
        };
        reader.readAsDataURL(file);
      });
    }

    if (pcAdjustXEl instanceof HTMLInputElement) {
      pcAdjustXEl.addEventListener('input', async () => {
        sourceAdjust.x = Number(pcAdjustXEl.value || '0');
        await applyPcUploadAdjustment(false);
      });
      pcAdjustXEl.addEventListener('change', async () => {
        sourceAdjust.x = Number(pcAdjustXEl.value || '0');
        await applyPcUploadAdjustment(true);
      });
    }

    if (pcAdjustYEl instanceof HTMLInputElement) {
      pcAdjustYEl.addEventListener('input', async () => {
        sourceAdjust.y = Number(pcAdjustYEl.value || '0');
        await applyPcUploadAdjustment(false);
      });
      pcAdjustYEl.addEventListener('change', async () => {
        sourceAdjust.y = Number(pcAdjustYEl.value || '0');
        await applyPcUploadAdjustment(true);
      });
    }

    if (pcAdjustResetEl instanceof HTMLButtonElement) {
      pcAdjustResetEl.addEventListener('click', async () => {
        sourceAdjust = { x: 0, y: 0 };
        syncPcAdjustPanel();
        await applyPcUploadAdjustment(true);
        setStatus('사진 위치를 기본값으로 되돌렸습니다.');
      });
    }

    if (resetBtn instanceof HTMLButtonElement) {
      resetBtn.addEventListener('click', () => resetAllState());
    }

    if (uploadGuidanceEl instanceof HTMLElement) uploadGuidanceEl.addEventListener('click', handleGuidanceAction);
    if (blockingCtaEl instanceof HTMLElement) blockingCtaEl.addEventListener('click', handleGuidanceAction);

    if (cameraStartBtn instanceof HTMLButtonElement) {
      cameraStartBtn.addEventListener('click', async () => {
        try {
          stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
          if (cameraEl instanceof HTMLVideoElement) {
            cameraEl.srcObject = stream;
            cameraEl.classList.remove('hidden');
            cameraEl.style.transform = 'scaleX(-1)';
          }
          if (cameraCaptureBtn instanceof HTMLButtonElement) cameraCaptureBtn.disabled = false;
          updateGuideOverlay();
          startLivePreviewAnalysis();
          setStatus('카메라가 켜졌습니다. 촬영 버튼을 눌러주세요.');
        } catch {
          setStatus('카메라 접근 실패. 업로드를 사용해주세요.');
        }
      });
    }

    if (cameraCaptureBtn instanceof HTMLButtonElement) {
      cameraCaptureBtn.addEventListener('click', async () => {
        if (!(cameraEl instanceof HTMLVideoElement)) return;
        const canvas = document.createElement('canvas');
        canvas.width = cameraEl.videoWidth || 720;
        canvas.height = cameraEl.videoHeight || 960;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const applyMirrorFix = cameraMirrorFixEl instanceof HTMLInputElement ? cameraMirrorFixEl.checked : true;
        if (applyMirrorFix) {
          ctx.translate(canvas.width, 0);
          ctx.scale(-1, 1);
        }
        ctx.drawImage(cameraEl, 0, 0, canvas.width, canvas.height);
        if (applyMirrorFix) {
          ctx.setTransform(1, 0, 0, 1, 0, 0);
        }
        const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
        const blob = dataURLToBlob(dataUrl);
        const file = new File([blob], `camera-${Date.now()}.jpg`, { type: 'image/jpeg' });
        setSource(dataUrl, file);
        stopCamera();
        const assessment = await inspectImageFile(file);
        sourceUploadAssessment = assessment;
        sourceFaceHint = assessment.faceHint ?? null;
        renderUploadGuidance(assessment);
        renderBlockingCta(assessment);
        updateGenerateAvailability();
        setStatus(
          assessment.blocking
            ? '사진 품질이 낮아 다시 촬영을 권장합니다.'
            : (assessment.messages[0] ? `${assessment.messages[0]} 계속 진행합니다.` : '촬영 완료.')
        );
        window.setTimeout(() => {
          generateBtn instanceof HTMLButtonElement && generateBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 120);
      });
    }

    if (generateBtn instanceof HTMLButtonElement) {
      generateBtn.addEventListener('click', async () => {
        try {
          const generationOrderId = await ensureBaseCheckoutForGeneration();
          if (paymentMode === 'polar' && !generationOrderId && !basePaid) return;
          await generateCandidates(3, false, generationOrderId ?? baseOrderId ?? null);
        } catch (error) {
          if (error instanceof Error && error.message.includes('not configured')) {
            setStatus('기본 결제용 Polar 상품 ID가 아직 설정되지 않았습니다.');
            return;
          }
          if (error instanceof Error && error.message.includes('API 연결')) {
            setStatus(error.message);
            return;
          }
          setStatus('기본 결제 확인에 실패했습니다. 잠시 후 다시 시도해주세요.');
        }
      });
    }

    addButtons.forEach((buttonEl) => {
      buttonEl.addEventListener('click', async () => {
        const count = Number(buttonEl.getAttribute('data-add-count') || '0');
        const productType = `add${count}`;
        if (!sourceDataUrl || !count) {
          setStatus('먼저 사진을 업로드하고 기본 후보를 생성해주세요.');
          return;
        }
        if (isGenerating) return;
        if (!apiOnline) {
          if (paymentMode === 'polar') {
            setStatus('결제 모드에서는 API 연결이 필요합니다. 잠시 후 다시 시도해주세요.');
            return;
          }
          if (!allowLocalFallback) {
            setStatus('운영 환경에서는 API 미연결 시 무료 대체 생성을 사용하지 않습니다.');
            return;
          }
          setStatus(`API 미연결 상태입니다. 결제 확인 없이 +${count}장 로컬 추가 생성을 진행합니다.`);
          await generateCandidates(count, true);
          return;
        }
        try {
          const existingOrderId = addonOrders[productType];
          if (existingOrderId) {
            const existingOrder = await fetchOrder(existingOrderId);
            if (existingOrder?.status === 'paid') {
              setStatus(`결제 완료(+${count}장). 추가 후보를 생성합니다...`);
              try {
                await generateCandidates(count, true, existingOrderId);
                addonOrders[productType] = null;
                savePageState();
                return;
              } catch {
                await requestRefund(existingOrderId, 'service_disruption');
                addonOrders[productType] = null;
                savePageState();
                setStatus(`추가 생성 처리에 실패해 +${count}장 결제를 환불 요청했습니다.`);
                return;
              }
            }
            if (existingOrder?.status === 'pending' && existingOrder?.checkoutUrl) {
              window.location.href = existingOrder.checkoutUrl;
              return;
            }
            if (existingOrder?.status === 'refunded' || existingOrder?.status === 'failed' || existingOrder?.status === 'expired') {
              addonOrders[productType] = null;
              savePageState();
            }
          }
          setStatus('추가 생성 결제를 확인하고 있습니다...');
          const checkout = await requestAddonCheckout(count);
          if (!checkout.paid) {
            addonOrders[productType] = checkout.orderId ?? null;
            savePageState();
            if (moveToCheckoutIfPending(checkout, '결제 페이지로 이동합니다. 결제 후 돌아와 +추가 생성을 다시 눌러주세요.')) return;
            setStatus('결제가 완료되지 않아 추가 생성을 진행할 수 없습니다.');
            return;
          }
          setStatus(`결제 완료(+${count}장). 추가 후보를 생성합니다...`);
          try {
            await generateCandidates(count, true, checkout.orderId ?? null);
          } catch {
            await requestRefund(checkout.orderId, 'service_disruption');
            setStatus(`추가 생성 처리에 실패해 +${count}장 결제를 환불 요청했습니다.`);
            return;
          }
        } catch (error) {
          if (error instanceof Error && error.message.includes('not configured')) {
            setStatus('추가 생성용 Polar 상품 ID가 아직 설정되지 않았습니다.');
            return;
          }
          setStatus('추가 생성 결제 확인에 실패했습니다. 잠시 후 다시 시도해주세요.');
        }
      });
    });

    if (downloadBtn instanceof HTMLButtonElement) {
      downloadBtn.addEventListener('click', async () => {
        const selected = candidates.filter((item) => item.selected);
        if (selected.length !== 1) {
          window.alert('후보 이미지를 1개 선택해주세요.');
          setStatus('후보 이미지를 1개 선택해주세요.');
          return;
        }
        if (isGenerating) return;
        if (!apiOnline) {
          if (paymentMode === 'polar' && !basePaid) {
            setStatus('결제 모드에서는 다운로드 전 결제 확인이 필요합니다.');
            return;
          }
          try {
            setStatus('API 미연결 상태입니다. 결제 확인 없이 다운로드를 시작합니다.');
            await downloadCandidate(selected[0], 1, 'manytool-id-photo');
            setStatus('다운로드를 시작했습니다.');
          } catch {
            setStatus('다운로드에 실패했습니다. 다시 시도해주세요.');
          }
          return;
        }
        if (!basePaid) {
          try {
            setStatus(paymentMode === 'mock' ? '기본 결제(mock) 상태를 확인하고 있습니다...' : '기본 결제를 확인하고 있습니다...');
            const checkout = await requestBaseCheckout();
            if (!checkout.paid) {
              if (moveToCheckoutIfPending(checkout, '결제 페이지로 이동합니다. 결제 후 돌아오면 다운로드가 가능합니다.', true)) return;
              setStatus('결제가 완료되지 않아 다운로드할 수 없습니다.');
              return;
            }
            basePaid = true;
            baseOrderId = checkout.orderId ?? null;
            if (baseOrderId && !creditedBaseOrders.includes(baseOrderId)) {
              creditedBaseOrders.push(baseOrderId);
            }
            savePageState();
            setStatus('기본 결제 완료. 다운로드를 시작합니다.');
          } catch (error) {
            if (error instanceof Error && error.message.includes('not configured')) {
              setStatus('기본 결제용 Polar 상품 ID가 아직 설정되지 않았습니다.');
              return;
            }
            setStatus('결제 확인에 실패했습니다. 잠시 후 다시 시도해주세요.');
            return;
          }
        }
        try {
          setStatus('다운로드 파일을 준비 중입니다...');
          await downloadCandidate(selected[0], 1, 'manytool-id-photo');
          basePaid = false;
          candidates.forEach((item) => {
            item.selected = false;
          });
          renderCandidates();
          savePageState();
          setStatus('다운로드를 시작했습니다.');
        } catch {
          await requestRefund(baseOrderId, 'service_disruption');
          basePaid = false;
          savePageState();
          setStatus('다운로드에 실패했습니다. 다시 시도해주세요.');
        }
      });
    }

    if (mobileDownloadBtn instanceof HTMLButtonElement && downloadBtn instanceof HTMLButtonElement) {
      mobileDownloadBtn.addEventListener('click', () => {
        downloadBtn.click();
      });
    }

    // 300 dpi pixel sizes for the size presets rendered above the download button.
    const SIZE_PRESETS = {
      half: { w: 354, h: 472 },
      id: { w: 413, h: 531 },
      card: { w: 591, h: 827 },
      square: { w: 591, h: 591 }
    };
    const SHEET = { w: 1200, h: 1800, gap: 12 };

    const selectedPreset = () => {
      const input = document.querySelector('input[name="size-preset"]:checked');
      return input instanceof HTMLInputElement && SIZE_PRESETS[input.value] ? input.value : 'half';
    };
    const wantsSheet = () => document.getElementById('print-sheet')?.checked === true;

    const sheetLayout = (preset) => {
      const { w, h } = SIZE_PRESETS[preset];
      const cols = Math.max(1, Math.floor((SHEET.w + SHEET.gap) / (w + SHEET.gap)));
      const rows = Math.max(1, Math.floor((SHEET.h + SHEET.gap) / (h + SHEET.gap)));
      return { cols, rows, count: cols * rows };
    };

    const updateSizeSummary = () => {
      const el = document.getElementById('size-summary');
      const input = document.querySelector('input[name="size-preset"]:checked');
      if (!el || !(input instanceof HTMLInputElement)) return;
      el.textContent = wantsSheet()
        ? `${input.dataset.label} · 4×6 시트 ${sheetLayout(selectedPreset()).count}장`
        : `${input.dataset.label} · 1장`;
    };
    document.querySelectorAll('input[name="size-preset"], #print-sheet').forEach((el) => el.addEventListener('change', updateSizeSummary));
    updateSizeSummary();

    // Crops the 3x4 result to the chosen ratio (keeping the head, trimming more from the bottom)
    // and optionally tiles it on a 4x6 inch print sheet with light cut lines.
    async function applySizePreset(blob) {
      const preset = selectedPreset();
      const sheet = wantsSheet();
      if (preset === 'half' && !sheet) return { blob, suffix: '' };
      const bitmap = await createImageBitmap(blob);
      const { w, h } = SIZE_PRESETS[preset];
      const target = w / h;
      let sw = bitmap.width;
      let sh = bitmap.height;
      let sx = 0;
      let sy = 0;
      if (sw / sh > target) {
        sw = sh * target;
        sx = (bitmap.width - sw) / 2;
      } else {
        sh = sw / target;
        sy = (bitmap.height - sh) * 0.3;
      }
      const photo = document.createElement('canvas');
      photo.width = w;
      photo.height = h;
      const pctx = photo.getContext('2d');
      pctx.imageSmoothingQuality = 'high';
      pctx.drawImage(bitmap, sx, sy, sw, sh, 0, 0, w, h);
      bitmap.close?.();
      let out = photo;
      if (sheet) {
        const { cols, rows } = sheetLayout(preset);
        out = document.createElement('canvas');
        out.width = SHEET.w;
        out.height = SHEET.h;
        const sctx = out.getContext('2d');
        sctx.fillStyle = '#ffffff';
        sctx.fillRect(0, 0, SHEET.w, SHEET.h);
        const offsetX = (SHEET.w - (cols * w + (cols - 1) * SHEET.gap)) / 2;
        const offsetY = (SHEET.h - (rows * h + (rows - 1) * SHEET.gap)) / 2;
        sctx.strokeStyle = '#d4d4d8';
        sctx.lineWidth = 1;
        for (let r = 0; r < rows; r += 1) {
          for (let c = 0; c < cols; c += 1) {
            const x = Math.round(offsetX + c * (w + SHEET.gap));
            const y = Math.round(offsetY + r * (h + SHEET.gap));
            sctx.drawImage(photo, x, y);
            sctx.strokeRect(x - 0.5, y - 0.5, w + 1, h + 1);
          }
        }
      }
      const converted = await new Promise((resolve, reject) => out.toBlob((b) => (b ? resolve(b) : reject(new Error('convert failed'))), 'image/jpeg', 0.95));
      return { blob: converted, suffix: `-${preset}${sheet ? '-4x6' : ''}` };
    }

    async function downloadCandidate(item, order, namePrefix) {
      const fileUrl = item.downloadUrl || item.url;
      const res = await fetch(fileUrl);
      if (!res.ok) throw new Error(`download failed: ${res.status}`);
      const { blob, suffix } = await applySizePreset(await res.blob());
      const objectUrl = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = objectUrl;
      link.download = `${namePrefix}-${order}${suffix}.jpg`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(objectUrl);
    }

    function dataURLToBlob(dataUrl) {
      const parts = dataUrl.split(',');
      const mime = parts[0].match(/:(.*?);/)?.[1] || 'image/jpeg';
      const binary = atob(parts[1]);
      const len = binary.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i += 1) bytes[i] = binary.charCodeAt(i);
      return new Blob([bytes], { type: mime });
    }
  </script>
</Layout>


