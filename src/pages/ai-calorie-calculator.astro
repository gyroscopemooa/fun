---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import Recommend from '../components/Recommend.astro';
import CalorieResultPanel from '../components/calorie/CalorieResultPanel';
import CalorieSampleShowcase from '../components/calorie/CalorieSampleShowcase';

const rawApiBase = (import.meta.env.PUBLIC_NODE_API_BASE ?? '').trim();
const apiBase = rawApiBase.replace(/\/+$/, '');
---

<Layout
  title="AI 칼로리 계산기 | 음식 사진 칼로리 추정, 식단 사진 분석 | ManyTool"
  description="음식 사진 한 장으로 총 칼로리, 탄단지 비율, 식단 점수, 대체 메뉴까지 알려주는 ManyTool AI 칼로리 계산기입니다."
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600">AI Nutrition</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">AI 칼로리 계산기</h1>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 sm:text-base">
        음식 사진 한 장이면 AI가 음식별 분량과 칼로리, 탄단지 비율, 나트륨·당류를 추정하고 내 목표에 맞춘 식단 점수와 대체 메뉴까지 알려드립니다.
        병원 진단용이 아닌 빠른 참고용 추정치입니다.
      </p>
      <AdSense slotName="본문 상단" />
    </section>
    <AdsterraBanner placement="top" />

    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-bold tracking-[0.16em] text-emerald-600">STEP 1</p>
          <h2 class="mt-1 text-xl font-black text-slate-950">음식 사진 올리기</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">식판, 디저트, 간식, 음료 사진도 분석할 수 있어요.</p>
        </div>
        <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">$0.99</span>
      </div>

      <div class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <label class="flex min-h-[280px] cursor-pointer flex-col items-center justify-center rounded-[28px] border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center transition hover:border-slate-950 hover:bg-white">
          <input id="calorie-image-input" type="file" accept="image/*" class="hidden" />
          <div id="calorie-empty" class="space-y-3">
            <p class="text-4xl">🍱</p>
            <p class="text-base font-semibold text-slate-900">음식 사진 선택</p>
            <p class="text-sm leading-6 text-slate-500">위에서 내려다보거나 45도로 찍은 사진일수록 정확해요.</p>
          </div>
          <img id="calorie-preview" alt="meal preview" class="hidden max-h-[260px] rounded-[24px] object-contain shadow-sm" />
        </label>

        <div class="flex flex-col">
          <p class="text-sm font-bold text-slate-900">나의 목표</p>
          <div id="calorie-goal" class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label="식단 목표">
            <button type="button" role="radio" data-goal="lose" class="rounded-2xl border border-slate-200 px-2 py-3 text-sm font-bold text-slate-700 transition">🔥 체중 감량</button>
            <button type="button" role="radio" data-goal="maintain" class="rounded-2xl border border-slate-200 px-2 py-3 text-sm font-bold text-slate-700 transition">⚖️ 체중 유지</button>
            <button type="button" role="radio" data-goal="gain" class="rounded-2xl border border-slate-200 px-2 py-3 text-sm font-bold text-slate-700 transition">💪 근력 증가</button>
          </div>
          <p class="mt-2 text-xs text-slate-500">목표에 따라 식단 점수와 권장 탄단지 비율, 대체 메뉴 추천이 달라져요.</p>

          <div class="mt-4 rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <p class="font-semibold text-slate-900">이런 걸 알려드려요</p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5">
              <li>총 칼로리와 추정 범위, 하루 목표 대비 비율</li>
              <li>탄단지 비율과 식이섬유·당류·나트륨</li>
              <li>A+~D 식단 점수와 대체 메뉴 추천</li>
            </ul>
            <p class="mt-2 text-xs text-slate-500">국물, 소스, 오일, 정확한 중량은 오차가 있을 수 있어요.</p>
          </div>

          <p id="calorie-payment-note" class="mt-4 text-xs leading-5 text-slate-500"></p>

          <button id="calorie-analyze-button" class="mt-auto w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-bold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:bg-slate-400 max-lg:mt-4">
            칼로리 분석하기
          </button>
          <p id="calorie-status" class="mt-3 text-sm text-slate-600">사진을 첨부하면 음식별 추정 칼로리와 식단 리포트를 보여줍니다.</p>
        </div>
      </div>
    </section>

    <section id="calorie-report" class="mt-6 scroll-mt-20">
      <p class="text-xs font-bold tracking-[0.16em] text-emerald-600">STEP 2</p>
      <h2 class="mt-1 text-xl font-black text-slate-950">내 식단 리포트</h2>
      <div class="mt-4">
        <CalorieResultPanel client:load />
      </div>
    </section>

    <section class="mt-8 rounded-[28px] border border-slate-200 bg-[linear-gradient(180deg,#ffffff_0%,#f0fdf4_100%)] p-6 shadow-sm">
      <p class="text-xs font-semibold tracking-[0.16em] text-emerald-600">SAMPLE REPORT</p>
      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900">실제 음식 사진으로 분석한 샘플</h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">샐러드·짜장면·초밥 사진을 실제 AI 분석 기능으로 분석한 결과예요. 모두 체중 유지 목표를 기준으로 했으며, 칼로리와 영양소는 사진 속 재료와 양을 바탕으로 한 추정치입니다.</p>
      <div class="mt-5">
        <CalorieSampleShowcase client:visible />
      </div>
    </section>

    <script is:inline define:vars={{ apiBase }}>
      const API_BASE = apiBase;
      const CALORIE_DRAFT_STORAGE_KEY = 'manytool.calorieDraft.v1';
      const CALORIE_ORDER_STORAGE_KEY = 'manytool.calorieOrder.v1';
      const CALORIE_PRICE_CENTS = 99;
      const CALORIE_CURRENCY = 'USD';
      // The report UI is Korean on every locale (/en reuses this page), so ask the AI for Korean text too.
      const pageLocale = 'ko';

      const fileInput = document.getElementById('calorie-image-input');
      const preview = document.getElementById('calorie-preview');
      const emptyState = document.getElementById('calorie-empty');
      const analyzeButton = document.getElementById('calorie-analyze-button');
      const statusEl = document.getElementById('calorie-status');
      const goalButtons = Array.from(document.querySelectorAll('#calorie-goal [data-goal]'));
      const paymentNoteEl = document.getElementById('calorie-payment-note');

      let selectedFile = null;
      let paymentMode = 'mock';
      let isPolarBaseReady = true;
      // Paid, not yet used order; the server rejects analysis requests without one.
      let currentOrderId = null;

      const setOrderId = (orderId) => {
        currentOrderId = orderId || null;
        try {
          if (currentOrderId) window.sessionStorage.setItem(CALORIE_ORDER_STORAGE_KEY, currentOrderId);
          else window.sessionStorage.removeItem(CALORIE_ORDER_STORAGE_KEY);
        } catch {
          // Without storage the order only lives for this page view.
        }
      };

      try {
        currentOrderId = window.sessionStorage.getItem(CALORIE_ORDER_STORAGE_KEY) || null;
      } catch {
        currentOrderId = null;
      }
      let shouldAutoAnalyzeAfterPayment = false;
      let selectedGoal = 'maintain';

      const setGoal = (goal) => {
        selectedGoal = ['lose', 'maintain', 'gain'].includes(goal) ? goal : 'maintain';
        goalButtons.forEach((button) => {
          const active = button.getAttribute('data-goal') === selectedGoal;
          button.setAttribute('aria-checked', String(active));
          button.className = `rounded-2xl border px-2 py-3 text-sm font-bold transition ${active ? 'border-emerald-600 bg-emerald-50 text-emerald-800' : 'border-slate-200 text-slate-700 hover:border-slate-400'}`;
        });
      };
      goalButtons.forEach((button) => button.addEventListener('click', () => setGoal(button.getAttribute('data-goal'))));
      setGoal('maintain');

      const pushResult = (analysis, photoUrl) => {
        window.dispatchEvent(new CustomEvent('manytool:ai-calorie-result', { detail: analysis ? { analysis, photoUrl } : null }));
      };

      // Shrinks phone photos for the checkout draft and the upload; the result is also the report thumbnail.
      const downscale = (dataUrl, maxSide = 1280) => new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          const ctx = canvas.getContext('2d');
          if (!ctx) return resolve(dataUrl);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          resolve(canvas.toDataURL('image/jpeg', 0.9));
        };
        img.onerror = () => resolve(dataUrl);
        img.src = dataUrl;
      });

      const setStatus = (message) => {
        if (statusEl) statusEl.textContent = message;
      };

      const setButtonState = (label, disabled) => {
        if (!analyzeButton) return;
        analyzeButton.textContent = label;
        analyzeButton.disabled = disabled;
      };

      const updatePaymentNote = () => {
        if (!paymentNoteEl) return;
        if (paymentMode === 'polar') {
          paymentNoteEl.textContent = '결제 후 같은 페이지로 돌아오면 자동으로 칼로리 분석이 시작됩니다.';
          return;
        }
        paymentNoteEl.textContent = '현재는 테스트 모드로 바로 분석됩니다.';
      };

      updatePaymentNote();

      const fileToDataUrl = (file) => new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(typeof reader.result === 'string' ? reader.result : '');
        reader.onerror = () => reject(new Error('이미지 변환에 실패했습니다.'));
        reader.readAsDataURL(file);
      });

      const dataUrlToFile = async (dataUrl, name, type, lastModified) => {
        const response = await fetch(dataUrl);
        const blob = await response.blob();
        return new File([blob], name, {
          type: type || blob.type || 'image/png',
          lastModified: Number.isFinite(lastModified) ? lastModified : Date.now()
        });
      };

      const updatePreview = (file) => {
        selectedFile = file;
        if (!file) {
          if (preview) {
            preview.classList.add('hidden');
            preview.removeAttribute('src');
          }
          emptyState?.classList.remove('hidden');
          return;
        }

        const objectUrl = URL.createObjectURL(file);
        if (preview) {
          preview.src = objectUrl;
          preview.classList.remove('hidden');
        }
        emptyState?.classList.add('hidden');
      };

      const persistDraftForCheckout = async () => {
        if (typeof window === 'undefined' || !selectedFile) return;
        const draft = {
          imageName: selectedFile.name,
          imageType: selectedFile.type,
          imageLastModified: selectedFile.lastModified,
          imageDataUrl: await downscale(await fileToDataUrl(selectedFile)),
          goal: selectedGoal
        };
        try {
          window.sessionStorage.setItem(CALORIE_DRAFT_STORAGE_KEY, JSON.stringify(draft));
        } catch {
          // Storage full: checkout still works, the photo just has to be picked again afterwards.
        }
      };

      const requestBaseCheckout = async () => {
        const currentUrl = typeof window !== 'undefined' ? window.location.href : '';
        const response = await fetch(`${API_BASE}/checkout`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            productType: 'calorie',
            amount: CALORIE_PRICE_CENTS,
            currency: CALORIE_CURRENCY,
            successUrl: currentUrl,
            returnUrl: currentUrl
          })
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload) {
          throw new Error(payload?.error || '결제 시작에 실패했습니다.');
        }
        return payload;
      };

      const analyzeCurrentFile = async () => {
        if (!selectedFile) {
          setStatus('먼저 음식 사진을 첨부해주세요.');
          return;
        }

        const photoUrl = await downscale(await fileToDataUrl(selectedFile));
        const uploadFile = await dataUrlToFile(photoUrl, 'meal.jpg', 'image/jpeg', Date.now());
        const formData = new FormData();
        formData.append('image', uploadFile);
        formData.append('locale', pageLocale);
        formData.append('goal', selectedGoal);
        formData.append('orderId', currentOrderId || '');

        setButtonState('분석 중...', true);
        setStatus('AI가 음식과 영양 성분을 분석하고 있어요. 보통 30초~1분 정도 걸려요.');
        pushResult(null);

        try {
          const response = await fetch(`${API_BASE}/ai-calorie-calculator/analyze`, {
            method: 'POST',
            body: formData
          });
          const payload = await response.json().catch(() => null);
          if (response.status === 402 || response.status === 409) {
            // The order is missing, unpaid or already used: the next click starts a new checkout.
            setOrderId(null);
            throw new Error(response.status === 409
              ? '이미 사용한 결제입니다. 다시 분석하려면 새로 결제해 주세요.'
              : '결제 확인이 필요합니다. 분석하기를 다시 눌러 결제를 진행해 주세요.');
          }
          if (!response.ok || !payload?.analysis) {
            throw new Error(payload?.error || '분석에 실패했습니다.');
          }

          pushResult(payload.analysis, photoUrl);
          if (payload.analysis.isFood === false) {
            // The server keeps the order open for a retake, so the same payment covers the next photo.
            setStatus('음식을 찾지 못했어요. 같은 결제로 다른 사진을 다시 분석할 수 있어요.');
          } else {
            setOrderId(null);
            setStatus('분석이 완료되었습니다. 아래 리포트를 확인해주세요.');
          }
          window.sessionStorage.removeItem(CALORIE_DRAFT_STORAGE_KEY);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '분석에 실패했습니다.');
        } finally {
          setButtonState('칼로리 분석하기', false);
        }
      };

      fileInput?.addEventListener('change', () => {
        updatePreview(fileInput.files?.[0] ?? null);
      });

      analyzeButton?.addEventListener('click', async () => {
        if (!selectedFile) {
          setStatus('먼저 음식 사진을 첨부해주세요.');
          return;
        }

        if (!API_BASE) {
          setStatus('API 주소가 설정되지 않았습니다. PUBLIC_NODE_API_BASE를 확인해주세요.');
          return;
        }

        if (!currentOrderId) {
          if (paymentMode === 'polar' && !isPolarBaseReady) {
            setStatus('Polar base 상품이 아직 설정되지 않았습니다.');
            return;
          }
          try {
            await persistDraftForCheckout();
            const checkout = await requestBaseCheckout();
            if (checkout.paid && checkout.orderId) {
              // Mock mode: the order is paid immediately.
              setOrderId(checkout.orderId);
            } else if (checkout.checkoutUrl) {
              window.location.href = checkout.checkoutUrl;
              return;
            } else {
              throw new Error('checkout url is missing');
            }
          } catch (error) {
            setStatus(error instanceof Error ? error.message : '결제 시작에 실패했습니다.');
            return;
          }
        }

        await analyzeCurrentFile();
      });

      void (async () => {
        if (!API_BASE) return;
        try {
          const response = await fetch(`${API_BASE}/config`);
          const payload = await response.json().catch(() => null);
          if (response.ok && payload) {
            paymentMode = payload.paymentMode === 'polar' ? 'polar' : 'mock';
            isPolarBaseReady = paymentMode === 'polar'
              ? Boolean(payload.paymentProducts?.calorie || payload.paymentProducts?.base)
              : true;
            updatePaymentNote();
          }
        } catch {
          updatePaymentNote();
        }
      })();

      void (async () => {
        if (typeof window === 'undefined') return;
        const raw = window.sessionStorage.getItem(CALORIE_DRAFT_STORAGE_KEY);
        if (!raw) return;
        try {
          const saved = JSON.parse(raw);
          const restoredFile = await dataUrlToFile(
            saved.imageDataUrl,
            saved.imageName,
            saved.imageType,
            saved.imageLastModified
          );
          updatePreview(restoredFile);
          setGoal(saved.goal);
          if (shouldAutoAnalyzeAfterPayment) {
            shouldAutoAnalyzeAfterPayment = false;
            await analyzeCurrentFile();
          }
        } catch {
          window.sessionStorage.removeItem(CALORIE_DRAFT_STORAGE_KEY);
        }
      })();

      void (async () => {
        if (typeof window === 'undefined' || !API_BASE) return;
        const params = new URLSearchParams(window.location.search);
        const orderId = params.get('orderId');
        if (!orderId) return;

        try {
          const response = await fetch(`${API_BASE}/order/${encodeURIComponent(orderId)}`);
          const payload = await response.json().catch(() => null);
          if (response.ok && payload?.status === 'paid') {
            setOrderId(orderId);
            shouldAutoAnalyzeAfterPayment = true;
          }
        } catch {
          // Keep the page usable even if order verification fails.
        } finally {
          window.history.replaceState({}, '', window.location.pathname);
        }

        if (shouldAutoAnalyzeAfterPayment && selectedFile) {
          shouldAutoAnalyzeAfterPayment = false;
          await analyzeCurrentFile();
        }
      })();
    </script>

    <AdsterraBanner placement="bottom" />
    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 text-sm leading-7 text-slate-600 shadow-sm">
      <h2 class="text-xl font-bold text-slate-950">참고 사항</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5">
        <li>의료나 영양 처방용이 아닌 참고용 AI 추정치입니다.</li>
        <li>국물, 소스, 오일, 숨겨진 재료는 실제보다 높거나 낮게 추정될 수 있습니다.</li>
        <li>정확한 식단 관리가 필요하면 제품 영양정보나 전문가 상담을 함께 참고하는 것이 좋습니다.</li>
      </ul>
    </section>

    <Recommend />
  </main>
  <Footer />
</Layout>
