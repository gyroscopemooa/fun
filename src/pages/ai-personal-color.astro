---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import Recommend from '../components/Recommend.astro';
import PersonalColorResultPanel from '../components/personal-color/PersonalColorResultPanel';
import PersonalColorSampleShowcase from '../components/personal-color/PersonalColorSampleShowcase';
import PromoSlider from '../components/personal-color/PromoSlider';
import { getImage } from 'astro:assets';
import sampleLeft from '../assets/personal-color/sample-left.jpg';
import sampleRight from '../assets/personal-color/sample-right.jpg';
import promo1 from '../assets/personal-color/promo-1.png';
import promo2 from '../assets/personal-color/promo-2.png';
import promo3 from '../assets/personal-color/promo-3.png';
import promo4 from '../assets/personal-color/promo-4.png';
import promo5 from '../assets/personal-color/promo-5.png';
import { detectLocale } from '../lib/i18n';

const apiBase = (import.meta.env.PUBLIC_NODE_API_BASE ?? 'http://127.0.0.1:8787').replace(/\/+$/, '');
const locale = detectLocale(Astro.url.pathname);
const localizedCopy = {
  ko: {
    title: 'AI 퍼스널컬러 자가진단 | 사진 업로드·카메라 촬영 분석 | ManyTool', description: '모바일 카메라 촬영 또는 사진 업로드로 시작하는 AI 퍼스널컬러 자가진단. OpenAI 기반으로 톤 분석, 추천 컬러, 메이크업, 헤어 컬러 가이드를 확인하세요.',
    badge: '모바일 촬영 지원', heading: 'AI 퍼스널컬러 자가진단', intro: '업로드뿐 아니라 카메라 촬영으로도 바로 시작할 수 있게 만든 유료 분석 페이지입니다. 웜/쿨, 명도, 채도, 대비감을 기준으로 12톤 중 내 톤을 찾고, 가상 드레이핑과 실제 컬러칩 팔레트로 결과를 바로 확인할 수 있습니다.',
    start: '시작 방식', startValue: '사진 업로드 또는 카메라 촬영', result: '결과 구성', resultValue: '12톤 진단 · 가상 드레이핑 · 컬러칩', delivery: '결과 전달', deliveryValue: '결제 이메일 기준 결과 링크 재확인', step: '사진 준비', stepDesc: '모바일에서는 셀카를 바로 찍고, PC에서는 업로드로 바로 진행할 수 있습니다.', upload: '사진 업로드', camera: '카메라 시작', capture: '촬영', reset: '초기화', empty: '정면 얼굴 사진을 준비해 주세요', analyze: 'AI 퍼스널컬러 분석 시작', ready: '사진을 준비하면 결제 후 바로 분석을 이어서 진행합니다.'
  },
  en: {
    title: 'AI Personal Color Analysis | Photo Upload & Camera Analysis | ManyTool', description: 'Find your personal color with a photo or camera capture. Get AI-powered tone analysis, color recommendations, makeup and hair color guidance.',
    badge: 'Mobile camera supported', heading: 'AI Personal Color Analysis', intro: 'Start with a photo upload or a camera capture. We assess warmth, brightness, saturation and contrast across 12 tones, then show virtual draping and a practical color-chip palette.',
    start: 'How to start', startValue: 'Upload a photo or use your camera', result: 'Your report', resultValue: '12-tone result · virtual draping · color chips', delivery: 'Result access', deliveryValue: 'Reopen your result from the purchase email', step: 'Prepare your photo', stepDesc: 'Take a selfie on mobile, or upload a photo from your computer.', upload: 'Upload photo', camera: 'Start camera', capture: 'Take photo', reset: 'Reset', empty: 'Prepare a front-facing photo', analyze: 'Start AI color analysis', ready: 'Prepare a photo to continue to secure checkout and analysis.'
  },
  es: {
    title: 'Análisis de color personal con IA | ManyTool', description: 'Descubre tu color personal con una foto o la cámara. Obtén análisis de tono, colores, maquillaje y cabello con IA.',
    badge: 'Compatible con cámara móvil', heading: 'Análisis de color personal con IA', intro: 'Empieza subiendo una foto o usando la cámara. Analizamos calidez, luminosidad, saturación y contraste en 12 tonos, con drapeado virtual y una paleta de colores.',
    start: 'Cómo empezar', startValue: 'Sube una foto o usa la cámara', result: 'Tu informe', resultValue: '12 tonos · drapeado virtual · paleta', delivery: 'Acceso al resultado', deliveryValue: 'Vuelve a abrir el resultado desde el correo de compra', step: 'Prepara tu foto', stepDesc: 'Hazte un selfie en el móvil o sube una foto desde tu ordenador.', upload: 'Subir foto', camera: 'Abrir cámara', capture: 'Tomar foto', reset: 'Restablecer', empty: 'Prepara una foto frontal', analyze: 'Iniciar análisis de color con IA', ready: 'Prepara una foto para continuar al pago y análisis.'
  },
  zh: {
    title: 'AI 个人色彩分析 | ManyTool', description: '通过照片或相机了解您的个人色彩。获取 AI 色调、配色、妆容和发色建议。',
    badge: '支持手机拍摄', heading: 'AI 个人色彩分析', intro: '上传照片或使用相机即可开始。我们从冷暖、明度、饱和度和对比度分析 12 种色调，并提供虚拟披色和实用色卡。',
    start: '开始方式', startValue: '上传照片或使用相机', result: '报告内容', resultValue: '12 色调 · 虚拟披色 · 色卡', delivery: '查看结果', deliveryValue: '可通过购买邮件再次打开结果', step: '准备照片', stepDesc: '在手机上拍自拍照，或从电脑上传照片。', upload: '上传照片', camera: '打开相机', capture: '拍照', reset: '重置', empty: '请准备一张正面照片', analyze: '开始 AI 色彩分析', ready: '准备照片后即可继续付款和分析。'
  },
  ja: {
    title: 'AIパーソナルカラー診断 | ManyTool', description: '写真またはカメラでパーソナルカラーを分析。AIによるトーン、カラー、メイク、ヘアカラーの提案を確認できます。',
    badge: 'モバイルカメラ対応', heading: 'AIパーソナルカラー診断', intro: '写真のアップロードまたはカメラ撮影から始められます。暖色・寒色、明度、彩度、コントラストを12トーンで分析し、バーチャルドレーピングとカラーパレットを確認できます。',
    start: '開始方法', startValue: '写真をアップロードまたはカメラで撮影', result: 'レポート内容', resultValue: '12トーン · バーチャルドレーピング · カラーチップ', delivery: '結果の確認', deliveryValue: '購入メールから結果を再度開けます', step: '写真を準備', stepDesc: 'スマートフォンでは自撮り、PCでは写真をアップロードしてください。', upload: '写真をアップロード', camera: 'カメラを開始', capture: '撮影', reset: 'リセット', empty: '正面の顔写真を準備してください', analyze: 'AIカラー分析を開始', ready: '写真を準備すると、決済後すぐに分析を始められます。'
  }
} as const;
const copy = localizedCopy[locale as keyof typeof localizedCopy] ?? localizedCopy.en;

// Source files are 1-2.5MB; serve resized webp to the React islands.
const toWebp = (src: ImageMetadata, width: number) => getImage({ src, width, format: 'webp', quality: 82 }).then((image) => image.src);
const [sampleLeftUrl, sampleRightUrl] = await Promise.all([toWebp(sampleLeft, 640), toWebp(sampleRight, 640)]);
const promoSlides = await Promise.all(
  [promo1, promo2, promo3, promo4, promo5].map(async (src, i) => ({ src: await toWebp(src, 900), alt: `AI 퍼스널컬러 홍보 이미지 ${i + 1}` }))
);
---

<Layout
  title={copy.title}
  description={copy.description}
  keywords="AI 퍼스널컬러, 퍼스널컬러 자가진단, 카메라 퍼스널컬러, 얼굴 톤 분석, 메이크업 컬러 추천, 퍼스널컬러 추천"
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-8 pb-24 md:pb-8">
    <section class="rounded-3xl border border-rose-200 bg-[radial-gradient(circle_at_top_left,#ffe4e6_0%,#fff7ed_34%,#ffffff_74%)] p-6 shadow-sm">
      <p class="inline-flex rounded-full bg-white/85 px-3 py-1 text-xs font-semibold text-rose-700">{copy.badge}</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900">{copy.heading}</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700 sm:text-base">
        {copy.intro}
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">{copy.start}</p>
          <p class="mt-1 text-sm text-slate-600">{copy.startValue}</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">{copy.result}</p>
          <p class="mt-1 text-sm text-slate-600">{copy.resultValue}</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">{copy.delivery}</p>
          <p class="mt-1 text-sm text-slate-600">{copy.deliveryValue}</p>
        </div>
      </div>
    </section>
    <section class="mt-6" aria-label="AI 퍼스널컬러 소개 이미지">
      <PromoSlider client:load slides={promoSlides} />
    </section>

    <AdsterraBanner placement="top" />

    <AdSense slotName="본문 상단" />

    <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="text-xs font-bold tracking-[0.16em] text-rose-600">STEP 1</p>
          <h2 class="mt-1 text-xl font-black text-slate-900">{copy.step}</h2>
          <p class="mt-1 text-sm text-slate-600">{copy.stepDesc}</p>
        </div>
      </div>

      <div class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-3">
          <video id="camera" class="hidden h-80 w-full -scale-x-100 rounded-xl bg-black object-cover" autoplay playsinline></video>
          <img id="preview" alt="퍼스널컬러 분석용 미리보기" class="hidden h-80 w-full rounded-xl object-contain" />
          <div id="empty-state" class="flex h-80 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white text-center text-sm text-slate-500">
            <svg viewBox="0 0 64 64" class="h-14 w-14 text-slate-300" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><ellipse cx="32" cy="28" rx="13" ry="16"/><path d="M12 58c3-11 11-15 20-15s17 4 20 15"/></svg>
            {copy.empty}
          </div>
        </div>

        <div class="flex flex-col">
          <div class="flex flex-wrap gap-2">
            <label class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white">
              {copy.upload}
              <input id="file-input" type="file" accept="image/*" class="hidden" />
            </label>
            <button id="camera-start" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50">
              {copy.camera}
            </button>
            <button id="camera-capture" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50" disabled>
              {copy.capture}
            </button>
            <button id="reset-all" class="inline-flex items-center justify-center rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">
              {copy.reset}
            </button>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-2 text-center text-xs">
            <div class="rounded-2xl bg-emerald-50 p-3 text-emerald-800"><p class="text-lg">☀️</p><p class="mt-1 font-bold">자연광·창가</p></div>
            <div class="rounded-2xl bg-sky-50 p-3 text-sky-800"><p class="text-lg">🙂</p><p class="mt-1 font-bold">정면·민낯 권장</p></div>
            <div class="rounded-2xl bg-rose-50 p-3 text-rose-800"><p class="text-lg">🚫</p><p class="mt-1 font-bold">필터·보정 X</p></div>
          </div>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600">
            <li>흰 벽 앞, 컬러 조명이 없는 곳에서 찍으면 정확도가 올라가요</li>
            <li>모자·마스크·컬러렌즈·강한 색조 메이크업은 피해 주세요</li>
            <li>염색모라면 메모에 원래 머리색을 남기면 반영돼요</li>
          </ul>
          <input id="notes-input" type="text" maxlength="120" placeholder="메모 (선택) 예: 원래 흑발인데 지금은 밝은 갈색 염색" class="mt-3 w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm text-slate-700 placeholder:text-slate-400 focus:border-slate-400 focus:outline-none" />

          <button id="analyze-button" class="mt-auto w-full rounded-2xl bg-rose-600 px-4 py-4 text-sm font-bold text-white shadow-[0_18px_40px_rgba(225,29,72,0.24)] transition hover:-translate-y-0.5 hover:bg-rose-500 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none max-lg:mt-4" disabled>
            {copy.analyze}
          </button>
          <p id="status" class="mt-3 text-sm text-slate-600">{copy.ready}</p>
          <div id="status-box" class="mt-3 hidden rounded-2xl border p-4 text-sm"></div>
        </div>
      </div>
    </section>

    <section id="personal-color-report" class="mt-6 scroll-mt-20">
      <p class="text-xs font-bold tracking-[0.16em] text-rose-600">STEP 2</p>
      <h2 class="mt-1 text-xl font-black text-slate-900">내 퍼스널컬러 리포트</h2>
      <div class="mt-4">
        <PersonalColorResultPanel client:load locale={locale} />
      </div>
    </section>

    <section class="mt-8 rounded-3xl border border-slate-200 bg-[linear-gradient(180deg,#ffffff_0%,#fff8fb_100%)] p-5">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-semibold tracking-[0.16em] text-rose-600">SAMPLE REPORT</p>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-900">실제 결과 리포트 샘플</h2>
          <p class="mt-2 max-w-3xl text-sm text-slate-600">
            결제 후 받게 되는 리포트와 똑같은 화면입니다. 샘플 사진으로 가상 드레이핑을 보여주며, 톤을 바꿔 가며 차이를 비교해 보세요.
          </p>
        </div>
        <a href="/personal-color" class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50">
          무료 자가진단 보기
        </a>
      </div>
      <div class="mt-5">
        <PersonalColorSampleShowcase client:visible leftPhotoUrl={sampleLeftUrl} rightPhotoUrl={sampleRightUrl} locale={locale} />
      </div>
    </section>

    <a href="/lip-color-simulator" class="mt-6 flex items-center gap-4 rounded-3xl border border-pink-200 bg-[linear-gradient(135deg,#fdf2f8_0%,#fff1f2_60%,#ffffff_100%)] p-5 transition hover:-translate-y-0.5 hover:shadow-md">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm">💄</span>
      <span class="min-w-0">
        <span class="block text-xs font-bold tracking-[0.16em] text-pink-600">NEW · 무료</span>
        <span class="mt-1 block text-lg font-black text-slate-900">내 톤 립 컬러, 사진에 바로 입혀보기</span>
        <span class="mt-0.5 block text-sm text-slate-600">12톤별 립 36색을 내 얼굴에 발색해 보고 4계절 립을 나란히 비교해 보세요.</span>
      </span>
    </a>

    <AdSense slotName="본문 하단" />
    <AdsterraBanner placement="bottom" />
    <Recommend />
  </main>
  <Footer />


  <script is:inline define:vars={{ apiBase, locale }}>
    const API_BASE = apiBase;
    const STORAGE_IMAGE_KEY = 'manytool.aiPersonalColor.image';
    const STORAGE_PENDING_KEY = 'manytool.aiPersonalColor.pendingCheckout';
    const CHECKOUT_AMOUNT = 490;
    const CHECKOUT_CURRENCY = 'USD';

    const fileInput = document.getElementById('file-input');
    const cameraEl = document.getElementById('camera');
    const previewEl = document.getElementById('preview');
    const emptyStateEl = document.getElementById('empty-state');
    const cameraStartBtn = document.getElementById('camera-start');
    const cameraCaptureBtn = document.getElementById('camera-capture');
    const resetBtn = document.getElementById('reset-all');
    const analyzeBtn = document.getElementById('analyze-button');
    const statusEl = document.getElementById('status');
    const statusBoxEl = document.getElementById('status-box');
    const notesInput = document.getElementById('notes-input');

    let imageDataUrl = '';
    let currentOrderId = null;
    let apiReady = false;
    let productReady = false;
    let checkingConnection = false;
    let stream = null;
    let analyzing = false;

    const query = new URLSearchParams(window.location.search);
    const returnedOrderId = query.get('orderId');
    const requestedJobId = query.get('jobId');

    const pushResult = (analysis) => {
      window.dispatchEvent(new CustomEvent('manytool:ai-personal-color-result', { detail: analysis ?? null }));
    };

    const setStatus = (message, tone = 'neutral') => {
      if (statusEl) {
        statusEl.textContent = tone === 'neutral' ? message : '';
        statusEl.classList.toggle('hidden', tone !== 'neutral');
      }
      if (!statusBoxEl) return;
      if (!message || tone === 'neutral') {
        statusBoxEl.className = 'mt-3 hidden rounded-2xl border p-4 text-sm';
        statusBoxEl.textContent = '';
        return;
      }
      const toneClass = tone === 'error'
        ? 'border-rose-200 bg-rose-50 text-rose-700'
        : tone === 'success'
          ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
          : 'border-slate-200 bg-slate-50 text-slate-700';
      statusBoxEl.className = `mt-3 rounded-2xl border p-4 text-sm ${toneClass}`;
      statusBoxEl.setAttribute('role', tone === 'error' ? 'alert' : 'status');
      statusBoxEl.textContent = message;
    };

    const setAnalyzeEnabled = () => {
      if (!(analyzeBtn instanceof HTMLButtonElement)) return;
      analyzeBtn.disabled = !imageDataUrl || checkingConnection || analyzing;
    };

    const stopCamera = () => {
      if (stream) {
        stream.getTracks().forEach((track) => track.stop());
        stream = null;
      }
      if (cameraEl instanceof HTMLVideoElement) {
        cameraEl.pause();
        cameraEl.srcObject = null;
        cameraEl.classList.add('hidden');
      }
      if (cameraCaptureBtn instanceof HTMLButtonElement) {
        cameraCaptureBtn.disabled = true;
      }
    };

    const showPreview = (dataUrl) => {
      imageDataUrl = dataUrl || '';
      if (previewEl instanceof HTMLImageElement && imageDataUrl) {
        previewEl.src = imageDataUrl;
        previewEl.classList.remove('hidden');
      }
      emptyStateEl?.classList.toggle('hidden', Boolean(imageDataUrl));
      if (!imageDataUrl && previewEl instanceof HTMLImageElement) {
        previewEl.classList.add('hidden');
        previewEl.removeAttribute('src');
      }
      try {
        window.sessionStorage.setItem(STORAGE_IMAGE_KEY, imageDataUrl);
      } catch {
        // Storage full: the photo still works for this visit, it just won't survive the checkout redirect.
      }
      setAnalyzeEnabled();
    };

    // Keeps phone photos small enough for sessionStorage and the upload, without hurting color detail.
    const downscale = (dataUrl, maxSide = 1440) => new Promise((resolve) => {
      if (!dataUrl) return resolve('');
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
        if (scale === 1 && dataUrl.length < 2_500_000) return resolve(dataUrl);
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        const ctx = canvas.getContext('2d');
        if (!ctx) return resolve(dataUrl);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL('image/jpeg', 0.92));
      };
      img.onerror = () => resolve(dataUrl);
      img.src = dataUrl;
    });

    const dataUrlToFile = async (dataUrl, filename = 'personal-color.jpg') => {
      const response = await fetch(dataUrl);
      const blob = await response.blob();
      return new File([blob], filename, { type: blob.type || 'image/jpeg' });
    };

    const fetchConfig = async () => {
      checkingConnection = true;
      setAnalyzeEnabled();
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 10000);
      try {
        const response = await fetch(`${API_BASE}/config`, { signal: controller.signal });
        if (!response.ok) throw new Error(`config failed: ${response.status}`);
        const payload = await response.json();
        apiReady = Boolean(payload?.readiness?.aiPersonalColorReady);
        productReady = Boolean(payload?.paymentProducts?.ai_personal_color);
      } catch {
        apiReady = false;
        productReady = false;
      } finally {
        window.clearTimeout(timeout);
        checkingConnection = false;
        setAnalyzeEnabled();
      }
      return apiReady && productReady;
    };

    const fetchOrder = async (orderId) => {
      if (!orderId) return null;
      const response = await fetch(`${API_BASE}/order/${orderId}`);
      if (!response.ok) return null;
      return response.json();
    };

    const fetchJob = async (jobId) => {
      const response = await fetch(`${API_BASE}/ai-personal-color/job/${jobId}`);
      if (!response.ok) throw new Error(`job fetch failed: ${response.status}`);
      return response.json();
    };

    const requestCheckout = async () => {
      const response = await fetch(`${API_BASE}/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productType: 'ai_personal_color',
          amount: CHECKOUT_AMOUNT,
          currency: CHECKOUT_CURRENCY,
          provider: 'polar',
          successUrl: window.location.href.split('?')[0],
          returnUrl: window.location.href.split('?')[0]
        })
      });
      if (!response.ok) throw new Error(`checkout failed: ${response.status}`);
      return response.json();
    };

    const runAnalysis = async () => {
      if (!imageDataUrl || !currentOrderId || analyzing) return;
      analyzing = true;
      setAnalyzeEnabled();
      setStatus('AI가 12톤 기준으로 분석 중입니다. 보통 30초~1분 정도 걸려요.');

      try {
        const file = await dataUrlToFile(imageDataUrl);
        const formData = new FormData();
        formData.append('image', file);
        formData.append('orderId', currentOrderId);
        const notes = notesInput instanceof HTMLInputElement ? notesInput.value.trim() : '';
        if (notes) formData.append('notes', notes);
        formData.append('locale', locale);

        const response = await fetch(`${API_BASE}/ai-personal-color/analyze`, {
          method: 'POST',
          body: formData
        });
        const payload = await response.json();
        if (!response.ok) {
          throw new Error(payload?.error || `analysis failed: ${response.status}`);
        }

        pushResult(payload.job.analysis);
        setStatus('분석이 완료되었습니다. 결제 이메일로도 결과 링크가 발송됩니다.', 'success');
        window.sessionStorage.removeItem(STORAGE_PENDING_KEY);
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.delete('orderId');
        nextUrl.searchParams.set('jobId', payload.job.id);
        window.history.replaceState({}, '', nextUrl.toString());
      } catch (error) {
        setStatus(error instanceof Error ? error.message : '분석에 실패했습니다.', 'error');
      } finally {
        analyzing = false;
        setAnalyzeEnabled();
      }
    };

    const restoreImage = () => {
      const saved = window.sessionStorage.getItem(STORAGE_IMAGE_KEY) || '';
      if (saved) showPreview(saved);
    };

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async () => {
        stopCamera();
        showPreview(await downscale(typeof reader.result === 'string' ? reader.result : ''));
        setStatus('사진이 준비되었습니다. 분석 시작을 누르면 결제 후 바로 분석을 이어갑니다.');
      };
      reader.readAsDataURL(file);
    });

    cameraStartBtn?.addEventListener('click', async () => {
      try {
        if (!navigator.mediaDevices?.getUserMedia) {
          throw new Error('이 브라우저에서는 카메라 촬영을 지원하지 않습니다.');
        }
        stopCamera();
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
        if (cameraEl instanceof HTMLVideoElement) {
          cameraEl.srcObject = stream;
          cameraEl.classList.remove('hidden');
        }
        if (previewEl instanceof HTMLImageElement) {
          previewEl.classList.add('hidden');
        }
        emptyStateEl?.classList.add('hidden');
        if (cameraCaptureBtn instanceof HTMLButtonElement) {
          cameraCaptureBtn.disabled = false;
        }
        setStatus('카메라가 준비되었습니다. 원하는 각도에서 촬영을 눌러주세요.');
      } catch (error) {
        setStatus(error instanceof Error ? error.message : '카메라를 시작하지 못했습니다.', 'error');
      }
    });

    cameraCaptureBtn?.addEventListener('click', () => {
      if (!(cameraEl instanceof HTMLVideoElement) || !cameraEl.videoWidth || !cameraEl.videoHeight) return;
      const canvas = document.createElement('canvas');
      canvas.width = cameraEl.videoWidth;
      canvas.height = cameraEl.videoHeight;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(cameraEl, 0, 0, canvas.width, canvas.height);
      const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
      stopCamera();
      showPreview(dataUrl);
      setStatus('촬영이 완료되었습니다. 분석 시작을 누르면 결제 후 자동으로 분석을 이어갑니다.');
    });

    resetBtn?.addEventListener('click', () => {
      stopCamera();
      imageDataUrl = '';
      currentOrderId = null;
      window.sessionStorage.removeItem(STORAGE_IMAGE_KEY);
      window.sessionStorage.removeItem(STORAGE_PENDING_KEY);
      if (fileInput instanceof HTMLInputElement) fileInput.value = '';
      pushResult(null);
      showPreview('');
      setStatus('초기화되었습니다.');
    });

    analyzeBtn?.addEventListener('click', async () => {
      if (checkingConnection || analyzing) return;
      if (!imageDataUrl) {
        setStatus('먼저 사진을 준비해 주세요.', 'error');
        return;
      }
      if (!apiReady || !productReady) {
        setStatus('분석 서비스 연결을 확인하고 있어요.');
        if (!(await fetchConfig())) {
          setStatus('지금은 분석 서비스에 연결할 수 없어요. 사진은 유지되니 잠시 후 분석 시작을 다시 눌러 주세요.', 'error');
          return;
        }
      }

      if (!currentOrderId) {
        try {
          setStatus('결제 페이지로 이동합니다.');
          window.sessionStorage.setItem(STORAGE_PENDING_KEY, '1');
          const checkout = await requestCheckout();
          if (checkout?.checkoutUrl) {
            window.location.href = checkout.checkoutUrl;
            return;
          }
          throw new Error('checkout url is missing');
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '결제 요청에 실패했습니다.', 'error');
          return;
        }
      }

      await runAnalysis();
    });

    const bootstrap = async () => {
      pushResult(null);
      restoreImage();
      await fetchConfig();

      if (requestedJobId) {
        try {
          const payload = await fetchJob(requestedJobId);
          if (payload?.job?.analysis) {
            currentOrderId = payload.job.orderId ?? null;
            pushResult(payload.job.analysis);
            setStatus('저장된 분석 결과를 불러왔습니다.', 'success');
          }
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '저장된 결과를 불러오지 못했습니다.', 'error');
        }
        return;
      }

      if (returnedOrderId) {
        const order = await fetchOrder(returnedOrderId);
        if (order?.status === 'paid') {
          currentOrderId = returnedOrderId;
          setStatus('결제가 확인되었습니다. 저장된 사진이 있으면 바로 분석을 이어갑니다.', 'success');
          if (window.sessionStorage.getItem(STORAGE_PENDING_KEY) === '1' && imageDataUrl) {
            await runAnalysis();
          }
        } else if (order?.status === 'pending') {
          setStatus('결제가 아직 완료되지 않았습니다.', 'error');
        }
      }

      setAnalyzeEnabled();
    };

    window.addEventListener('beforeunload', stopCamera);
    void bootstrap();
  </script>
</Layout>
