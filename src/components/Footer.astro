---
import { createTranslator, detectLocale } from '../lib/i18n';
import { localizedHrefOrOriginal } from '../lib/locale-routes';

const pathname = Astro.url.pathname;
const locale = detectLocale(pathname);
const t = await createTranslator(locale);
---

<footer class="mt-12 border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-5xl gap-4 px-4 py-6 text-sm text-slate-600 md:grid-cols-2">
    <div class="space-y-1">
      <p>&copy; {new Date().getFullYear()} ManyTool. {t('footer.rights')}</p>
      <p class="text-xs text-slate-500">운영 문의: <a href="mailto:support@manytool.net" class="underline underline-offset-4">support@manytool.net</a></p>
    </div>
    <div class="flex flex-wrap gap-3 md:justify-end">
      <a href="https://live-sub.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-800 hover:underline">패밀리사이트 LIVE-SUB.COM ↗</a>
      <a href={localizedHrefOrOriginal(locale, '/about')} class="hover:underline">{t('footer.about')}</a>
      <a href={localizedHrefOrOriginal(locale, '/privacy')} class="hover:underline">{t('footer.privacy')}</a>
      <a href={localizedHrefOrOriginal(locale, '/terms')} class="hover:underline">{t('footer.terms')}</a>
      <a href={localizedHrefOrOriginal(locale, '/refund-policy')} class="hover:underline">{t('footer.refund')}</a>
      <a href={localizedHrefOrOriginal(locale, '/contact')} class="hover:underline">{t('footer.contact')}</a>
      <a href={localizedHrefOrOriginal(locale, '/editorial-policy')} class="hover:underline">{t('footer.editorial')}</a>
      <a href={localizedHrefOrOriginal(locale, '/content-disclaimer')} class="hover:underline">{t('footer.disclaimer')}</a>
    </div>
    <details class="group md:col-span-2">
      <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-sm font-bold text-slate-700 hover:text-slate-950">
        <span class="text-xs transition-transform group-open:rotate-0 -rotate-90" aria-hidden="true">▼</span>
        Business Information
      </summary>
      <dl class="mt-2 space-y-1 text-xs leading-5 text-slate-500">
        <div class="flex gap-1"><dt>상호:</dt><dd>gyroscope</dd></div>
        <div class="flex gap-1"><dt>대표:</dt><dd>전민수</dd></div>
        <div class="flex gap-1"><dt>사업자등록번호:</dt><dd>696-55-00795</dd></div>
        <div class="flex gap-1"><dt>통신판매업신고번호:</dt><dd>2023-울산남구-0547</dd></div>
        <div class="flex gap-1"><dt>주소:</dt><dd>울산광역시 남구 번영로 124번길 21 울산비즈니스센터 307호</dd></div>
        <div class="flex gap-1"><dt>이메일:</dt><dd><a href="mailto:support@manytool.net" class="underline underline-offset-4">support@manytool.net</a></dd></div>
      </dl>
    </details>
  </div>
</footer>
