---
// Adsterra 네이티브 배너(4:1). 사이트 콘텐츠와 헷갈리지 않도록 "광고" 표시와 테두리로 구분한다.
// - PUBLIC_ADSTERRA_NATIVE 플래그로 켜고 끄며 기본값은 OFF.
// - 결제·로그인·정책·관리자 등 제외 페이지에는 넣지 않는다.
// - 공식 코드가 요구하는 container id 가 페이지에 하나뿐이어야 하므로 페이지당 한 번만 사용한다.
import { adsterra } from '../../lib/ads-config';
import { detectLocale, stripLocale } from '../../lib/i18n';

const { native } = adsterra;
const visible = native.enabled && adsterra.allowsPage(stripLocale(Astro.url.pathname));
const locale = detectLocale(Astro.url.pathname);
const label = locale === 'ko' ? '광고 · 스폰서 콘텐츠' : locale === 'ja' ? '広告 · スポンサーコンテンツ' : 'AD · Sponsored';
---

{
  visible && (
    <aside class="mt-10 rounded-xl border border-dashed border-slate-300 bg-white p-4" aria-label={label}>
      <p class="mb-3 text-[11px] font-semibold tracking-wide text-slate-400">{label}</p>
      <script is:inline async="async" data-cfasync="false" src={native.scriptSrc}></script>
      <div id={`container-${native.key}`}></div>
    </aside>
  )
}
