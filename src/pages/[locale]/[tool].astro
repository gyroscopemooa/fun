export function getStaticPaths() {
  const rolloutLocales = seoLocaleCodes.filter((locale) => locale !== 'ko' && locale !== 'en' && locale !== 'ja');
  const toolSlugs = ['ai-personal-color', 'ai-calorie-calculator', 'ai-manseryeok', 'ai-id-photo', 'ai-headshot', 'ai-pet-translator', 'valorant-agent-picker', 'crosshair-generator', 'fps-aim-sensitivity', 'fps-aim-trainer', 'fps-sensitivity-converter', 'dpi-edpi-calculator', 'fov-calculator', 'name-compatibility', 'nickname-generator', 'name-meaning', 'random-picker', 'chat-random-picker', 'lol-champion-recommender', 'game-character-picker'];
  return rolloutLocales.flatMap((locale) => toolSlugs.map((tool) => ({ params: { locale, tool }, props: { locale, tool } })));
}

const { locale, tool } = Astro.props;
const baseToolCopy = tools[tool as keyof typeof tools];
const toolCopy = localizedAiTools[locale as keyof typeof localizedAiTools]?.[tool as keyof typeof localizedAiTools[keyof typeof localizedAiTools]]
  ?? localizedFpsTools[locale as keyof typeof localizedFpsTools]?.[tool as keyof typeof localizedFpsTools[keyof typeof localizedFpsTools]]
  ?? localizedSimpleTools[locale as keyof typeof localizedSimpleTools]?.[tool as keyof typeof localizedSimpleTools[keyof typeof localizedSimpleTools]]
  ?? localizedImageTools[locale as keyof typeof localizedImageTools]?.[tool as keyof typeof localizedImageTools[keyof typeof localizedImageTools]]
  ?? localizedCalculatorTools[locale as keyof typeof localizedCalculatorTools]?.[tool as keyof typeof localizedCalculatorTools[keyof typeof localizedCalculatorTools]]
  ?? baseToolCopy;
const hasLocalizedToolCopy = toolCopy !== baseToolCopy;
const localizedCopy = localizedLabels[locale as keyof typeof localizedLabels] ?? ['ManyTool Tools', 'Explore AI tools, games, and practical utilities.', 'Start using', 'AI Image Generator'];
const canonicalPath = `/${tool}`;
---

{tool === 'ai-personal-color' ? <PersonalColorPage /> : tool === 'ai-calorie-calculator' ? <CaloriePage /> : tool === 'ai-manseryeok' ? <SajuPage /> : <Layout title={`${toolCopy[0]} | ManyTool`} description={toolCopy[1]} keywords={`${toolCopy[0]}, AI tool, ManyTool`}>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-600">ManyTool · {localizedCopy[0]}</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900">{toolCopy[0]}</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">{hasLocalizedToolCopy ? toolCopy[1] : `${localizedCopy[1]} ${toolCopy[1]}`}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={canonicalPath} class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800">{localizedCopy[2]}</a>
        <a href={`/${locale}/ai-image-generator`} class="rounded-full border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700 hover:border-slate-900">{localizedCopy[3]}</a>
      </div>
    </section>
    <section class="mt-6 grid gap-4 sm:grid-cols-3">
      {Object.entries(tools).filter(([slug]) => slug !== tool).slice(0, 3).map(([slug, copy]) => (
        <a href={`/${locale}/${slug}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:-translate-y-0.5 hover:border-cyan-300">
          <h2 class="font-bold text-slate-900">{copy[0]}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{copy[1]}</p>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>}
