---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['颜色转换器','转换 HEX、RGB 和 HSL 颜色','选择颜色','HEX','RGB'],es:['Conversor de colores','Convierte colores HEX, RGB y HSL','Elegir color','HEX','RGB'],de:['Farbkonverter','HEX-, RGB- und HSL-Farben umwandeln','Farbe auswählen','HEX','RGB'],fr:['Convertisseur de couleurs','Convertissez les couleurs HEX, RGB et HSL','Choisir une couleur','HEX','RGB'],pt:['Conversor de cores','Converta cores HEX, RGB e HSL','Escolher cor','HEX','RGB'],vi:['Công cụ đổi màu','Chuyển đổi màu HEX, RGB và HSL','Chọn màu','HEX','RGB'],id:['Konverter warna','Konversi warna HEX, RGB, dan HSL','Pilih warna','HEX','RGB']}; const t=c[locale]??['Color Converter','Convert HEX, RGB and HSL colors','Choose color','HEX','RGB'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><input id="color" type="color" value="#6366f1" class="h-20 w-20 cursor-pointer rounded-lg border" aria-label={t[2]}/><div class="mt-6 grid gap-3 sm:grid-cols-2"><label>{t[3]}<input id="hex" readonly class="mt-1 w-full rounded-lg border p-3"/></label><label>{t[4]}<input id="rgb" readonly class="mt-1 w-full rounded-lg border p-3"/></label></div></section></main><Footer/></Layout>
<script>const color=document.querySelector('#color'),hex=document.querySelector('#hex'),rgb=document.querySelector('#rgb');function update(){const v=color.value;hex.value=v;const n=parseInt(v.slice(1),16);rgb.value=`rgb(${n>>16&255}, ${n>>8&255}, ${n&255})`}color.addEventListener('input',update);update();</script>
