# Credit wallet: Node >=22.13 (Node 24 recommended), persistent private SQLite volume.
# Keep disabled until verified tool costs, KRW products and AI availability are ready.
CREDITS_ENABLED=false
CREDITS_TOOLS_READY=false
# Set an absolute path outside node-api-storage (which is publicly served).
# CREDITS_DB_PATH=/var/lib/manytool-private/credits.sqlite
CREDITS_TOOL_PRICING_JSON={}
POLAR_PRODUCT_CREDITS_10=
POLAR_PRODUCT_CREDITS_50=
POLAR_PRODUCT_CREDITS_300=

# ID photo launch is independent of other experimental external AI tools.
# Requires OPENAI_API_KEY. Set false to pause this tool.
ID_PHOTO_ENABLED=true

# Play consumable credits: disabled until store setup, app auth, refunds and device tests pass.
PLAY_CREDITS_ENABLED=false
PLAY_REFUND_RECONCILIATION_READY=false
PLAY_PACKAGE_NAME=net.manytool.app
# Product ID -> granted credits. No product/pricing assumptions are shipped.
PLAY_CREDIT_PRODUCTS_JSON={}
# Stable HMAC secret, at least 32 characters, generated/configured only with authorization.
PLAY_ACCOUNT_BINDING_SECRET=
# Private service-account JSON path, never put it in source or public storage.
PLAY_SERVICE_ACCOUNT_FILE=

# Poll refund history + durable consume retries once per minute; keep false until configured/tested.
PLAY_WORKER_ENABLED=false
# 32-byte AES key encoded as 64 lowercase hex chars, provision separately from DB/backups.
# Preserve the key while pending jobs exist; do not rotate without re-encryption.
PLAY_TOKEN_ENCRYPTION_KEY=
