---
import AiImageGenerator from '../../../components/home/AiImageGenerator';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import Layout from '../../../layouts/Layout.astro';
import { seoLocaleCodes } from '../../../lib/i18n';

const localeNames = { zh: '中文', es: 'Español', de: 'Deutsch', fr: 'Français', pt: 'Português', vi: 'Tiếng Việt', id: 'Bahasa Indonesia' };
const styles = ['figure', 'body-profile', 'travel-background', 'snapshot', 'kakao-profile', 'instagram-photo', 'outfit-change', 'hairstyle', 'interior', 'free-style'];

export function getStaticPaths() {
  const rolloutLocales = seoLocaleCodes.filter((locale) => locale !== 'ko');
  const rolloutStyles = ['figure', 'body-profile', 'travel-background', 'snapshot', 'kakao-profile', 'instagram-photo', 'outfit-change', 'hairstyle', 'interior', 'free-style'];
  return rolloutLocales.flatMap((locale) => rolloutStyles.map((style) => ({ params: { locale, style }, props: { locale, style } })));
}

const { locale, style } = Astro.props;
const readableStyle = style.replaceAll('-', ' ');
const localeName = localeNames[locale as keyof typeof localeNames] ?? locale;
---

<Layout title={`AI ${readableStyle} generator | ManyTool`} description={`Create an AI ${readableStyle} image with ManyTool.`} keywords={`AI ${readableStyle}, AI image generator, ManyTool`}>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-8">
    <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-600">ManyTool · {localeName}</p>
      <h1 class="mt-2 text-3xl font-black capitalize tracking-tight text-slate-900">AI {readableStyle} generator</h1>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">Upload a photo, choose your preferred style, and create an AI image. Results and payment availability may vary by region.</p>
    </section>
    <AiImageGenerator client:load locale={locale} />
  </main>
  <Footer />
</Layout>
