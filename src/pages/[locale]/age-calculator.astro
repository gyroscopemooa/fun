---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['年龄计算器','根据出生日期计算年龄','出生日期','计算年龄'],es:['Calculadora de edad','Calcula tu edad a partir de la fecha de nacimiento','Fecha de nacimiento','Calcular edad'],de:['Altersrechner','Berechne dein Alter anhand des Geburtsdatums','Geburtsdatum','Alter berechnen'],fr:['Calculateur d’âge','Calculez votre âge à partir de votre date de naissance','Date de naissance','Calculer l’âge'],pt:['Calculadora de idade','Calcule sua idade pela data de nascimento','Data de nascimento','Calcular idade'],vi:['Tính tuổi','Tính tuổi dựa trên ngày sinh','Ngày sinh','Tính tuổi'],id:['Kalkulator usia','Hitung usia berdasarkan tanggal lahir','Tanggal lahir','Hitung usia']}; const t=c[locale]??['Age Calculator','Calculate your age from your birth date','Birth date','Calculate age'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><label>{t[2]}<input id="birth" type="date" class="mt-1 w-full rounded-lg border p-3"/></label><button id="calc" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t[3]}</button><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 text-xl font-semibold">—</output></section></main><Footer/></Layout>
<script>const birth=document.querySelector('#birth'),result=document.querySelector('#result');document.querySelector('#calc').addEventListener('click',()=>{const d=new Date(birth.value),now=new Date();if(Number.isNaN(d.getTime())){result.textContent='—';return}let age=now.getFullYear()-d.getFullYear();const before=now.getMonth()<d.getMonth()||(now.getMonth()===d.getMonth()&&now.getDate()<d.getDate());if(before)age--;result.textContent=String(Math.max(0,age))});</script>
