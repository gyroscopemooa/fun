---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageWorkshop from '../components/ImageWorkshop';
---
<Layout title="이미지 합치기 | ManyTool" description="사진을 원하는 순서로 정렬하고 가로 또는 세로로 이어 붙이세요. 사진은 브라우저 안에서만 처리합니다."><Header /><main class="mx-auto max-w-5xl px-4 py-10"><a href="/image-tools" class="text-sm font-bold text-violet-700">← 이미지 도구 모음</a><section class="mt-5 rounded-[28px] bg-slate-950 p-8 text-white"><p class="text-xs font-bold tracking-widest text-violet-300">MANYTOOL · IMAGE TOOLS</p><h1 class="mt-3 text-3xl font-black sm:text-4xl">이미지 합치기</h1><p class="mt-4 leading-7 text-slate-300">사진을 원하는 순서로 정렬하고 가로 또는 세로로 이어 붙이세요. 사진은 브라우저 안에서만 처리합니다.</p></section><ImageWorkshop mode="merge" client:load /></main><Footer /></Layout>
