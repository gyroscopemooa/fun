---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { seoLocaleCodes } from '../../lib/i18n';

const locale = Astro.params.locale ?? 'en';
export function getStaticPaths() {
  return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale } }));
}
const copy: Record<string, { title: string; description: string; choose: string; strength: string; download: string; missing: string }> = {
  zh: { title: '在线图片模糊工具', description: '在浏览器中快速模糊图片并下载。', choose: '选择图片', strength: '模糊强度', download: '下载图片', missing: '请选择图片。' },
  es: { title: 'Desenfocar imagen online', description: 'Desenfoca imágenes rápidamente en tu navegador y descárgalas.', choose: 'Elegir imagen', strength: 'Intensidad', download: 'Descargar imagen', missing: 'Elige una imagen.' },
  de: { title: 'Bilder online weichzeichnen', description: 'Bilder direkt im Browser weichzeichnen und herunterladen.', choose: 'Bild auswählen', strength: 'Stärke', download: 'Bild herunterladen', missing: 'Bitte ein Bild auswählen.' },
  fr: { title: 'Flouter une image en ligne', description: 'Floutez rapidement une image dans votre navigateur et téléchargez-la.', choose: 'Choisir une image', strength: 'Intensité', download: 'Télécharger l’image', missing: 'Choisissez une image.' },
  pt: { title: 'Desfocar imagem online', description: 'Desfoque imagens rapidamente no navegador e baixe o resultado.', choose: 'Escolher imagem', strength: 'Intensidade', download: 'Baixar imagem', missing: 'Escolha uma imagem.' },
  vi: { title: 'Làm mờ ảnh trực tuyến', description: 'Làm mờ ảnh nhanh trong trình duyệt và tải xuống.', choose: 'Chọn ảnh', strength: 'Độ mờ', download: 'Tải ảnh xuống', missing: 'Hãy chọn một ảnh.' },
  id: { title: 'Buram gambar online', description: 'Buramkan gambar dengan cepat di browser lalu unduh hasilnya.', choose: 'Pilih gambar', strength: 'Kekuatan', download: 'Unduh gambar', missing: 'Pilih gambar terlebih dahulu.' },
};
const t = copy[locale] ?? { title: 'Image Blur', description: 'Blur an image in your browser and download it.', choose: 'Choose image', strength: 'Blur strength', download: 'Download image', missing: 'Choose an image.' };
---
<Layout title={t.title} description={t.description} locale={locale}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">{t.title}</h1>
    <p class="mt-3 text-slate-500">{t.description}</p>
    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <input id="file" type="file" accept="image/*" class="block w-full rounded-lg border p-3" aria-label={t.choose} />
      <label class="mt-6 block font-medium" for="strength">{t.strength}: <span id="value">8</span>px</label>
      <input id="strength" type="range" min="1" max="30" value="8" class="mt-3 w-full" />
      <canvas id="canvas" class="mt-6 max-h-[520px] w-full rounded-lg bg-slate-100 object-contain"></canvas>
      <button id="download" type="button" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t.download}</button>
      <p id="message" class="mt-3 text-sm text-slate-500"></p>
    </section>
  </main>
  <Footer />
</Layout>
<script define:vars={{ missing: t.missing }}>
  const file = document.querySelector('#file');
  const strength = document.querySelector('#strength');
  const value = document.querySelector('#value');
  const canvas = document.querySelector('#canvas');
  const message = document.querySelector('#message');
  let image = null;
  strength.addEventListener('input', () => { value.textContent = strength.value; draw(); });
  file.addEventListener('change', () => { const selected = file.files?.[0]; if (!selected) return; image = new Image(); image.onload = draw; image.src = URL.createObjectURL(selected); });
  function draw() { if (!image) return; canvas.width = image.naturalWidth; canvas.height = image.naturalHeight; const ctx = canvas.getContext('2d'); ctx.filter = `blur(${strength.value}px)`; ctx.drawImage(image, 0, 0); }
  document.querySelector('#download').addEventListener('click', () => { if (!image) { message.textContent = missing; return; } const link = document.createElement('a'); link.download = 'manytool-blurred.png'; link.href = canvas.toDataURL('image/png'); link.click(); });
</script>
