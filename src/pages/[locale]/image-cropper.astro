---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { seoLocaleCodes } from '../../lib/i18n';
const locale = Astro.params.locale ?? 'en';
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale } })); }
const copy: Record<string, any> = {
  zh:{title:'在线图片裁剪工具',desc:'在浏览器中裁剪图片并下载。',choose:'选择图片',w:'宽度',h:'高度',download:'下载图片',missing:'请选择图片。'},
  es:{title:'Recortar imagen online',desc:'Recorta imágenes en tu navegador y descarga el resultado.',choose:'Elegir imagen',w:'Ancho',h:'Alto',download:'Descargar imagen',missing:'Elige una imagen.'},
  de:{title:'Bilder online zuschneiden',desc:'Bilder direkt im Browser zuschneiden und herunterladen.',choose:'Bild auswählen',w:'Breite',h:'Höhe',download:'Bild herunterladen',missing:'Bitte ein Bild auswählen.'},
  fr:{title:'Rogner une image en ligne',desc:'Rognez une image dans votre navigateur et téléchargez-la.',choose:'Choisir une image',w:'Largeur',h:'Hauteur',download:'Télécharger l’image',missing:'Choisissez une image.'},
  pt:{title:'Cortar imagem online',desc:'Corte imagens no navegador e baixe o resultado.',choose:'Escolher imagem',w:'Largura',h:'Altura',download:'Baixar imagem',missing:'Escolha uma imagem.'},
  vi:{title:'Cắt ảnh trực tuyến',desc:'Cắt ảnh ngay trong trình duyệt và tải xuống.',choose:'Chọn ảnh',w:'Chiều rộng',h:'Chiều cao',download:'Tải ảnh xuống',missing:'Hãy chọn một ảnh.'},
  id:{title:'Potong gambar online',desc:'Potong gambar di browser lalu unduh hasilnya.',choose:'Pilih gambar',w:'Lebar',h:'Tinggi',download:'Unduh gambar',missing:'Pilih gambar terlebih dahulu.'}
};
const t = copy[locale] ?? {title:'Image Cropper',desc:'Crop an image in your browser and download it.',choose:'Choose image',w:'Width',h:'Height',download:'Download image',missing:'Choose an image.'};
---
<Layout title={t.title} description={t.desc} locale={locale}><Header /><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t.title}</h1><p class="mt-3 text-slate-500">{t.desc}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><input id="file" type="file" accept="image/*" class="block w-full rounded-lg border p-3" aria-label={t.choose}/><div class="mt-5 grid grid-cols-2 gap-3"><label>{t.w}<input id="w" type="number" min="1" class="mt-1 w-full rounded-lg border p-2"/></label><label>{t.h}<input id="h" type="number" min="1" class="mt-1 w-full rounded-lg border p-2"/></label></div><canvas id="canvas" class="mt-6 max-h-[520px] w-full rounded-lg bg-slate-100 object-contain"></canvas><button id="download" type="button" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t.download}</button><p id="message" class="mt-3 text-sm text-slate-500"></p></section></main><Footer /></Layout>
<script define:vars={{ missing: t.missing }}>
const file=document.querySelector('#file'), w=document.querySelector('#w'), h=document.querySelector('#h'), canvas=document.querySelector('#canvas'), message=document.querySelector('#message'); let image=null;
file.addEventListener('change',()=>{const f=file.files?.[0];if(!f)return;image=new Image();image.onload=()=>{w.value=image.naturalWidth;h.value=image.naturalHeight;draw()};image.src=URL.createObjectURL(f)}); w.addEventListener('input',draw);h.addEventListener('input',draw);
function draw(){if(!image)return;canvas.width=Math.max(1,Number(w.value)||image.naturalWidth);canvas.height=Math.max(1,Number(h.value)||image.naturalHeight);canvas.getContext('2d').drawImage(image,0,0,canvas.width,canvas.height)}
document.querySelector('#download').addEventListener('click',()=>{if(!image){message.textContent=missing;return}const a=document.createElement('a');a.download='manytool-cropped.png';a.href=canvas.toDataURL('image/png');a.click()});
</script>
