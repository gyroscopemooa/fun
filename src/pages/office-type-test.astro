---
import TypeTestPage from '../components/tests/TypeTestPage.astro';

const faq = [
  { q: '결과는 몇 가지인가요?', a: '칼퇴 요정, 엑셀 장인, 회의 MC 등 8가지 직장인 유형 중 하나가 나와요.' },
  { q: '팀원들과 같이 해도 되나요?', a: '네. 결과 링크를 팀 채팅방에 공유하면 서로의 일하는 스타일과 찰떡 동료를 알 수 있어요.' },
  { q: '답변이 저장되나요?', a: '아니요. 답변은 브라우저 안에서만 계산되고 어디에도 보내지 않아요.' }
];
---

<TypeTestPage
  slug="office-type-test"
  description="12개의 회사 생활 질문으로 칼퇴 요정, 엑셀 장인, 회의 MC 등 8가지 직장인 유형 중 나의 일하는 스타일을 알려 주는 무료 테스트입니다."
  keywords="직장인 유형 테스트, 회사 생활 테스트, 업무 스타일 테스트, 직장인 심리 테스트, 팀 성향 테스트"
  faq={faq}
/>
