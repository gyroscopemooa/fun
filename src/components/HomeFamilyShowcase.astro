---
import { familyServices } from '../data/family-services';
---

<section class="px-4 pb-6 lg:px-10" aria-labelledby="family-showcase-title">
  <div class="overflow-hidden rounded-[28px] bg-[#090b11] p-5 text-white shadow-[0_18px_50px_rgba(15,23,42,0.14)] sm:p-7">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="font-mono text-[11px] font-bold uppercase tracking-[0.18em] text-lime-300">LIVE SUB FAMILY</p>
        <h2 id="family-showcase-title" class="mt-2 text-2xl font-black tracking-tight sm:text-3xl">같이 만든 8개의 서비스</h2>
        <p class="mt-2 text-sm text-slate-400">언어, 건강, 일과 생활에 필요한 서비스를 만나보세요.</p>
      </div>
      <a href="https://live-sub.com/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/15 px-4 py-2 text-xs font-bold text-slate-200 transition hover:border-lime-300 hover:text-lime-300">패밀리 사이트 전체보기 ↗</a>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {familyServices.map((service, index) => (
        <a
          href={service.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative min-h-40 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.045] p-5 transition duration-300 hover:-translate-y-1 hover:border-white/25 hover:bg-white/[0.075]"
          style={`--family-accent:${service.accent}`}
        >
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--family-accent)] to-transparent opacity-70"></div>
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-[10px] font-bold tracking-[0.13em] text-[var(--family-accent)]">{String(index + 1).padStart(2, '0')} · {service.eyebrow}</span>
            <span class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-sm transition group-hover:border-[var(--family-accent)] group-hover:text-[var(--family-accent)]">↗</span>
          </div>
          <h3 class="mt-7 text-xl font-black tracking-tight text-white">{service.name}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-400">{service.copy}</p>
        </a>
      ))}
    </div>
  </div>
</section>
