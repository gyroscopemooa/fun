---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import Recommend from '../components/Recommend.astro';
import LipColorStudio from '../components/lip-color/LipColorStudio';
import { getImage } from 'astro:assets';
import sample from '../assets/personal-color/sample-left.jpg';

const sampleUrl = (await getImage({ src: sample, width: 900, format: 'webp', quality: 85 })).src;
---

<Layout
  title="립 컬러 시뮬레이터 | 퍼스널컬러 톤별 립 발색 미리보기 | ManyTool"
  description="내 사진에 퍼스널컬러 12톤별 립 컬러 36가지를 바로 입혀보는 무료 립 컬러 시뮬레이터. 매트·글로시 마감과 4계절 립 비교까지 한 번에 확인하세요."
  keywords="립 컬러 시뮬레이터, 립 발색, 퍼스널컬러 립, 웜톤 립, 쿨톤 립, 립스틱 가상 체험"
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-8 pb-24 md:pb-8">
    <section class="rounded-3xl border border-rose-200 bg-[radial-gradient(circle_at_top_left,#ffe4e6_0%,#fdf2f8_40%,#ffffff_78%)] p-6 shadow-sm">
      <p class="inline-flex rounded-full bg-white/85 px-3 py-1 text-xs font-semibold text-rose-700">무료 · 사진은 기기 안에서만 처리</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900">립 컬러 시뮬레이터</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700 sm:text-base">
        얼굴 사진 한 장으로 퍼스널컬러 12톤별 립 36가지를 바로 입혀보세요. 입술 위치를 자동으로 찾아 원래 입술 결과 밝기를 살린 채 발색하고, 매트·글로시 마감과 4계절 대표 립 비교까지 보여드려요.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">💄 36가지 립</p>
          <p class="mt-1 text-sm text-slate-600">12톤 × 라이트·기본·딥</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">↔️ 전후 비교</p>
          <p class="mt-1 text-sm text-slate-600">사진 위를 밀어서 바로 비교</p>
        </div>
        <div class="rounded-2xl border border-white/70 bg-white/85 p-4">
          <p class="text-sm font-bold text-slate-900">🌸 4계절 비교</p>
          <p class="mt-1 text-sm text-slate-600">봄·여름·가을·겨울 대표 립 나란히</p>
        </div>
      </div>
    </section>

    <AdsterraBanner placement="top" />
    <AdSense slotName="본문 상단" />

    <section class="mt-6">
      <LipColorStudio client:load sampleUrl={sampleUrl} />
    </section>

    <section class="mt-6 rounded-3xl border border-rose-200 bg-[linear-gradient(135deg,#fff1f2_0%,#fff7ed_55%,#fefce8_100%)] p-5">
      <p class="inline-flex rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-rose-700">내 톤이 궁금하다면</p>
      <h2 class="mt-3 text-xl font-bold text-slate-900">AI 퍼스널컬러로 내 12톤 먼저 확인하기</h2>
      <p class="mt-2 text-sm text-slate-700">AI가 사진으로 12톤 중 내 톤을 찾고, 어울리는 립·블러셔·헤어 컬러와 가상 드레이핑까지 보여드려요.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/ai-personal-color" class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">AI 퍼스널컬러 진단 보기</a>
        <a href="/personal-color" class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">무료 자가진단</a>
      </div>
    </section>

    <a href="/tone-outfit-board" class="mt-5 flex items-center gap-4 rounded-3xl border border-amber-200 bg-[linear-gradient(135deg,#fef3c7_0%,#fff7ed_60%,#ffffff_100%)] p-5 transition hover:-translate-y-0.5 hover:shadow-md">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm">👗</span>
      <span class="min-w-0">
        <span class="block text-xs font-bold tracking-[0.16em] text-amber-600">NEW · 무료</span>
        <span class="mt-1 block text-lg font-black text-slate-900">립에 어울리는 옷 색 조합도 보기</span>
        <span class="mt-0.5 block text-sm text-slate-600">톤별 코디 보드에서 데일리·오피스·데이트 룩 무드보드를 확인해 보세요.</span>
      </span>
    </a>

    <section class="mt-5 rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-700">
      <h2 class="text-lg font-semibold text-slate-900">사용 방법</h2>
      <p class="mt-1">정면 얼굴 사진을 올리면 입술을 자동으로 찾아요. 계절 탭에서 톤을 고르고 립 컬러를 누르면 바로 발색되고, 발색 강도와 매트·글로시 마감도 바꿀 수 있어요.</p>
      <h2 class="mt-4 text-lg font-semibold text-slate-900">FAQ</h2>
      <p class="mt-1">Q. 사진이 서버로 전송되나요? A. 아니요. 입술 인식과 발색은 모두 브라우저 안에서 처리돼요.</p>
      <p class="mt-1">Q. 실제 제품 색과 같나요? A. 조명과 화면에 따라 달라 보일 수 있어요. 색 고르기 참고용으로 써 주세요.</p>
    </section>

    <AdsterraBanner placement="bottom" />
    <AdSense slotName="본문 하단" />
    <Recommend />
  </main>
  <Footer />
</Layout>
