---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['每日英语句子', '每天练习一句自然的英语表达。', '下一句', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], es: ['Frase inglesa del día', 'Practica una expresión natural en inglés cada día.', 'Siguiente frase', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], de: ['Englischer Satz des Tages', 'Übe jeden Tag einen natürlichen englischen Satz.', 'Nächster Satz', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], fr: ['Phrase anglaise du jour', 'Pratiquez chaque jour une expression anglaise naturelle.', 'Phrase suivante', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], pt: ['Frase inglesa do dia', 'Pratique uma expressão natural em inglês todos os dias.', 'Próxima frase', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], vi: ['Câu tiếng Anh hôm nay', 'Luyện tập một cách diễn đạt tiếng Anh tự nhiên mỗi ngày.', 'Câu tiếp theo', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']], id: ['Kalimat bahasa Inggris hari ini', 'Latih satu ungkapan bahasa Inggris alami setiap hari.', 'Kalimat berikutnya', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Daily English sentence', 'Practice one natural English expression each day.', 'Next sentence', ['Small steps still move you forward.', 'Curiosity opens unexpected doors.', 'A calm mind sees more clearly.']];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, English sentence, ManyTool`}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><blockquote id="sentence" class="mt-10 text-2xl font-black leading-relaxed text-slate-900"></blockquote><button id="next" class="mt-8 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[2]}</button></section></main><Footer /></Layout>
<script is:inline define:vars={{ sentences: text[3] }}>
  let i = new Date().getDate() % sentences.length; const sentence = document.querySelector('#sentence'); const render = () => { sentence.textContent = `“${sentences[i]}”`; }; document.querySelector('#next').addEventListener('click', () => { i = (i + 1) % sentences.length; render(); }); render();
</script>
