---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { seoLocaleCodes } from '../../lib/i18n';

const copy = {
  zh: { title: 'FPS 灵敏度测试', intro: '输入灵敏度，点击目标并查看反应速度与命中率。', sensitivity: '当前灵敏度', start: '开始测试', reset: '重置记录', status: '输入灵敏度后开始测试。', target: '出现目标后立即点击', result: '测试结果' },
  es: { title: 'Prueba de sensibilidad FPS', intro: 'Introduce tu sensibilidad, haz clic en los objetivos y revisa tu precisión.', sensitivity: 'Sensibilidad actual', start: 'Comenzar prueba', reset: 'Restablecer', status: 'Introduce la sensibilidad para comenzar.', target: 'Haz clic en el objetivo', result: 'Resultado' },
  de: { title: 'FPS-Empfindlichkeitstest', intro: 'Gib deine Empfindlichkeit ein, klicke Ziele und prüfe Reaktionszeit und Genauigkeit.', sensitivity: 'Aktuelle Empfindlichkeit', start: 'Test starten', reset: 'Zurücksetzen', status: 'Empfindlichkeit eingeben und starten.', target: 'Ziel sofort anklicken', result: 'Testergebnis' },
  fr: { title: 'Test de sensibilité FPS', intro: 'Saisissez votre sensibilité, cliquez sur les cibles et vérifiez votre précision.', sensitivity: 'Sensibilité actuelle', start: 'Commencer le test', reset: 'Réinitialiser', status: 'Saisissez une sensibilité pour commencer.', target: 'Cliquez rapidement sur la cible', result: 'Résultat' },
  pt: { title: 'Teste de sensibilidade FPS', intro: 'Digite sua sensibilidade, clique nos alvos e confira sua precisão.', sensitivity: 'Sensibilidade atual', start: 'Iniciar teste', reset: 'Redefinir', status: 'Digite a sensibilidade para começar.', target: 'Clique no alvo rapidamente', result: 'Resultado' },
  vi: { title: 'Kiểm tra độ nhạy FPS', intro: 'Nhập độ nhạy, bấm vào mục tiêu và xem tốc độ cùng độ chính xác.', sensitivity: 'Độ nhạy hiện tại', start: 'Bắt đầu kiểm tra', reset: 'Đặt lại', status: 'Nhập độ nhạy để bắt đầu.', target: 'Bấm ngay khi mục tiêu xuất hiện', result: 'Kết quả' },
  id: { title: 'Tes sensitivitas FPS', intro: 'Masukkan sensitivitas, klik target, lalu lihat kecepatan dan akurasi.', sensitivity: 'Sensitivitas saat ini', start: 'Mulai tes', reset: 'Atur ulang', status: 'Masukkan sensitivitas untuk memulai.', target: 'Klik target segera', result: 'Hasil tes' },
  en: { title: 'FPS sensitivity test', intro: 'Enter your sensitivity, click targets, and check your reaction speed and accuracy.', sensitivity: 'Current sensitivity', start: 'Start test', reset: 'Reset', status: 'Enter sensitivity to start.', target: 'Click the target as soon as it appears', result: 'Test result' }
};
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
const text = copy[locale as keyof typeof copy] ?? copy.en;
---
<Layout title={`${text.title} | ManyTool`} description={text.intro} keywords={`${text.title}, FPS aim, ManyTool`}>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-600">FPS Aim Tool</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">{text.title}</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600">{text.intro}</p>
    </section>
    <section class="mt-6 grid gap-6 lg:grid-cols-[300px_minmax(0,1fr)]">
      <aside class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm">
        <label class="block text-sm font-bold text-slate-800">{text.sensitivity}<input id="sensitivity" type="number" min="0.01" step="0.01" value="1.65" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" /></label>
        <div class="mt-4 flex gap-2"><button id="start" class="flex-1 rounded-xl bg-slate-950 px-3 py-3 text-sm font-bold text-white">{text.start}</button><button id="reset" class="rounded-xl border border-slate-300 px-3 py-3 text-sm font-bold text-slate-700">{text.reset}</button></div>
        <p id="status" class="mt-4 text-sm text-slate-600">{text.status}</p>
      </aside>
      <div class="rounded-[28px] border border-slate-200 bg-slate-950 p-6 text-white shadow-sm">
        <p class="text-sm text-slate-300">{text.target}</p><button id="target" class="mt-5 hidden h-16 w-16 rounded-full bg-cyan-300 shadow-[0_0_35px_rgba(103,232,249,0.8)]"></button>
        <div class="mt-8 grid grid-cols-3 gap-3 text-center"><div class="rounded-xl bg-white/10 p-3"><p class="text-xs text-slate-400">Hits</p><p id="hits" class="text-2xl font-black">0</p></div><div class="rounded-xl bg-white/10 p-3"><p class="text-xs text-slate-400">Misses</p><p id="misses" class="text-2xl font-black">0</p></div><div class="rounded-xl bg-white/10 p-3"><p class="text-xs text-slate-400">Avg ms</p><p id="avg" class="text-2xl font-black">-</p></div></div>
        <h2 class="mt-6 text-lg font-black">{text.result}</h2><p id="result" class="mt-2 text-sm leading-6 text-slate-300">-</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script is:inline define:vars={{ text }}>
  const start = document.querySelector('#start'); const reset = document.querySelector('#reset'); const target = document.querySelector('#target'); const status = document.querySelector('#status'); const result = document.querySelector('#result'); const hitsEl = document.querySelector('#hits'); const missesEl = document.querySelector('#misses'); const avgEl = document.querySelector('#avg');
  let hits = 0, misses = 0, times = [], startedAt = 0, running = false;
  const showTarget = () => { target.style.display = 'block'; target.style.marginLeft = `${10 + Math.random() * 70}%`; target.style.marginTop = `${10 + Math.random() * 30}%`; startedAt = performance.now(); };
  start.addEventListener('click', () => { hits = 0; misses = 0; times = []; running = true; status.textContent = text.target; showTarget(); });
  target.addEventListener('click', () => { if (!running) return; hits += 1; times.push(Math.round(performance.now() - startedAt)); hitsEl.textContent = hits; avgEl.textContent = String(Math.round(times.reduce((a, b) => a + b, 0) / times.length)); target.style.display = 'none'; result.textContent = `${text.result}: ${avgEl.textContent} ms`; setTimeout(showTarget, 500); });
  reset.addEventListener('click', () => { hits = 0; misses = 0; times = []; running = false; target.style.display = 'none'; status.textContent = text.status; result.textContent = '-'; hitsEl.textContent = '0'; missesEl.textContent = '0'; avgEl.textContent = '-'; });
</script>
