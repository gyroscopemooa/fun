---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['图片调整大小', '在浏览器中调整图片尺寸并下载。', '选择图片', '宽度', '高度', '调整并下载', '请选择图片。'], es: ['Redimensionador de imágenes', 'Cambia el tamaño de una imagen en el navegador y descárgala.', 'Elegir imagen', 'Ancho', 'Alto', 'Redimensionar y descargar', 'Elige una imagen.'], de: ['Bildgröße ändern', 'Ändere die Bildgröße im Browser und lade sie herunter.', 'Bild auswählen', 'Breite', 'Höhe', 'Größe ändern und herunterladen', 'Wähle ein Bild aus.'], fr: ['Redimensionneur d’images', 'Modifiez la taille d’une image dans le navigateur et téléchargez-la.', 'Choisir une image', 'Largeur', 'Hauteur', 'Redimensionner et télécharger', 'Choisissez une image.'], pt: ['Redimensionador de imagens', 'Altere o tamanho de uma imagem no navegador e baixe-a.', 'Escolher imagem', 'Largura', 'Altura', 'Redimensionar e baixar', 'Escolha uma imagem.'], vi: ['Đổi kích thước ảnh', 'Đổi kích thước ảnh trong trình duyệt và tải xuống.', 'Chọn ảnh', 'Chiều rộng', 'Chiều cao', 'Đổi kích thước và tải xuống', 'Hãy chọn một ảnh.'], id: ['Pengubah ukuran gambar', 'Ubah ukuran gambar di browser lalu unduh.', 'Pilih gambar', 'Lebar', 'Tinggi', 'Ubah ukuran dan unduh', 'Pilih gambar.'] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Image Resizer', 'Resize an image in your browser and download it.', 'Choose image', 'Width', 'Height', 'Resize and download', 'Choose an image.'];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, image resizer, ManyTool`}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><input id="file" type="file" accept="image/*" class="mt-6 block w-full rounded-xl border border-slate-300 p-3" /><div class="mt-4 grid grid-cols-2 gap-3"><label class="text-sm font-bold">{text[3]}<input id="width" type="number" min="1" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" /></label><label class="text-sm font-bold">{text[4]}<input id="height" type="number" min="1" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" /></label></div><button id="resize" class="mt-5 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[5]}</button><p id="message" class="mt-4 min-h-6 text-sm text-rose-600">{text[6]}</p><img id="preview" class="mt-5 hidden max-h-72 rounded-xl border object-contain" /></section></main><Footer /></Layout>
<script is:inline define:vars={{ missing: text[6] }}>
  const file = document.querySelector('#file'); const width = document.querySelector('#width'); const height = document.querySelector('#height'); const button = document.querySelector('#resize'); const message = document.querySelector('#message'); const preview = document.querySelector('#preview'); file.addEventListener('change', () => { const selected = file.files?.[0]; if (!selected) return; const image = new Image(); image.onload = () => { width.value = image.width; height.value = image.height; }; image.src = URL.createObjectURL(selected); }); button.addEventListener('click', () => { const selected = file.files?.[0]; if (!selected) { message.textContent = missing; return; } const image = new Image(); image.onload = () => { const canvas = document.createElement('canvas'); canvas.width = Number(width.value) || image.width; canvas.height = Number(height.value) || image.height; canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height); canvas.toBlob((blob) => { const url = URL.createObjectURL(blob); preview.src = url; preview.classList.remove('hidden'); const link = document.createElement('a'); link.href = url; link.download = 'manytool-resized.png'; link.click(); }); }; image.src = URL.createObjectURL(selected); });
</script>
