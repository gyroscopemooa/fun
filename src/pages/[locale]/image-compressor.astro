---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['图片压缩器', '在浏览器中压缩图片并下载更小的文件。', '选择图片', '压缩质量', '压缩并下载', '请选择图片。'], es: ['Compresor de imágenes', 'Comprime imágenes en el navegador y descarga un archivo más pequeño.', 'Elegir imagen', 'Calidad', 'Comprimir y descargar', 'Elige una imagen.'], de: ['Bildkompressor', 'Komprimiere Bilder im Browser und lade eine kleinere Datei herunter.', 'Bild auswählen', 'Qualität', 'Komprimieren und herunterladen', 'Wähle ein Bild aus.'], fr: ['Compresseur d’images', 'Compressez une image dans le navigateur et téléchargez un fichier plus léger.', 'Choisir une image', 'Qualité', 'Compresser et télécharger', 'Choisissez une image.'], pt: ['Compressor de imagens', 'Comprima imagens no navegador e baixe um arquivo menor.', 'Escolher imagem', 'Qualidade', 'Comprimir e baixar', 'Escolha uma imagem.'], vi: ['Nén ảnh', 'Nén ảnh ngay trong trình duyệt và tải tệp nhỏ hơn.', 'Chọn ảnh', 'Chất lượng', 'Nén và tải xuống', 'Hãy chọn một ảnh.'], id: ['Kompresor gambar', 'Kompres gambar di browser dan unduh file yang lebih kecil.', 'Pilih gambar', 'Kualitas', 'Kompres dan unduh', 'Pilih gambar.'] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Image Compressor', 'Compress an image in your browser and download a smaller file.', 'Choose image', 'Quality', 'Compress and download', 'Choose an image.'];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, image compressor, ManyTool`}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><label class="mt-6 block text-sm font-bold text-slate-800">{text[2]}<input id="file" type="file" accept="image/*" class="mt-2 block w-full rounded-xl border border-slate-300 p-3" /></label><label class="mt-5 block text-sm font-bold text-slate-800">{text[3]} <span id="qualityValue">80</span>%<input id="quality" type="range" min="20" max="95" value="80" class="mt-2 w-full" /></label><button id="compress" class="mt-5 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[4]}</button><p id="message" class="mt-4 min-h-6 text-sm text-rose-600"></p><img id="preview" class="mt-6 hidden max-h-72 rounded-xl border object-contain" /></section></main><Footer /></Layout>
<script is:inline define:vars={{ missing: text[5] }}>
  const file = document.querySelector('#file'); const quality = document.querySelector('#quality'); const qualityValue = document.querySelector('#qualityValue'); const button = document.querySelector('#compress'); const message = document.querySelector('#message'); const preview = document.querySelector('#preview'); quality.addEventListener('input', () => { qualityValue.textContent = quality.value; }); button.addEventListener('click', () => { const source = file.files?.[0]; if (!source) { message.textContent = missing; return; } const image = new Image(); image.onload = () => { const canvas = document.createElement('canvas'); const scale = Math.min(1, 1800 / image.width); canvas.width = Math.round(image.width * scale); canvas.height = Math.round(image.height * scale); canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height); canvas.toBlob((blob) => { const url = URL.createObjectURL(blob); preview.src = url; preview.classList.remove('hidden'); const link = document.createElement('a'); link.href = url; link.download = `manytool-${source.name.replace(/\.[^.]+$/, '')}.jpg`; link.click(); message.textContent = ''; }, 'image/jpeg', Number(quality.value) / 100); }; image.src = URL.createObjectURL(source); });
</script>
