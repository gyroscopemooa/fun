---
import Layout from '../../layouts/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const locale=Astro.params.locale??'en'; export function getStaticPaths(){return seoLocaleCodes.filter((locale)=>locale!=='ko').map((locale)=>({params:{locale}}))}
const c:any={zh:['时区转换器','将本地时间转换为其他时区','日期和时间','从时区','转换到','转换'],es:['Conversor de zonas horarias','Convierte la hora local a otra zona horaria','Fecha y hora','Desde','Hasta','Convertir'],de:['Zeitzonenrechner','Lokale Zeit in eine andere Zeitzone umrechnen','Datum und Uhrzeit','Von Zeitzone','In Zeitzone','Umrechnen'],fr:['Convertisseur de fuseaux horaires','Convertissez l’heure locale vers un autre fuseau','Date et heure','Depuis','Vers','Convertir'],pt:['Conversor de fuso horário','Converta a hora local para outro fuso','Data e hora','De','Para','Converter'],vi:['Đổi múi giờ','Chuyển giờ địa phương sang múi giờ khác','Ngày và giờ','Từ múi giờ','Sang múi giờ','Chuyển đổi'],id:['Konverter zona waktu','Konversi waktu lokal ke zona waktu lain','Tanggal dan waktu','Dari zona','Ke zona','Konversi']}; const t=c[locale]??['Time Zone Converter','Convert local time to another time zone','Date and time','From time zone','To time zone','Convert'];
---
<Layout title={t[0]} description={t[1]} locale={locale}><Header/><main class="mx-auto max-w-3xl px-4 py-12"><h1 class="text-3xl font-bold">{t[0]}</h1><p class="mt-3 text-slate-500">{t[1]}</p><section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><label>{t[2]}<input id="date" type="datetime-local" class="mt-1 w-full rounded-lg border p-3"/></label><div class="mt-4 grid gap-3 sm:grid-cols-2"><label>{t[3]}<select id="from" class="mt-1 w-full rounded-lg border p-3"><option value="0">UTC</option><option value="9">Asia/Seoul (UTC+9)</option><option value="-5">New York (UTC-5)</option></select></label><label>{t[4]}<select id="to" class="mt-1 w-full rounded-lg border p-3"><option value="0">UTC</option><option value="9">Asia/Seoul (UTC+9)</option><option value="-5">New York (UTC-5)</option></select></label></div><button id="convert" class="mt-6 rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white">{t[5]}</button><output id="result" class="mt-6 block rounded-lg bg-slate-100 p-4 font-semibold">—</output></section></main><Footer/></Layout>
<script>const d=document.querySelector('#date'),f=document.querySelector('#from'),to=document.querySelector('#to'),r=document.querySelector('#result');document.querySelector('#convert').addEventListener('click',()=>{if(!d.value){r.textContent='—';return}const utc=new Date(d.value).getTime()-Number(f.value)*3600000;r.textContent=new Date(utc+Number(to.value)*3600000).toLocaleString()});</script>
