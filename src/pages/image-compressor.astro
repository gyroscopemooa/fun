---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
---
<Layout title="이미지 용량 줄이기 | JPG PNG WEBP 사진 압축 | ManyTool" description="사진과 이미지 파일의 용량을 브라우저에서 바로 줄여보세요. 업로드 없이 안전하게 JPG, PNG, WEBP 이미지를 압축합니다." keywords="이미지 용량 줄이기, 사진 용량 줄이기, JPG 압축, PNG 압축"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Image Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">이미지 용량 줄이기</h1><p class="mt-3 text-sm leading-7 text-slate-300">사진을 선택하면 브라우저에서 바로 압축합니다. 파일은 서버로 업로드되지 않습니다.</p></section><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><input id="file" type="file" accept="image/*" class="block w-full rounded-2xl border border-slate-300 p-4 text-sm" /><label class="mt-5 block text-sm font-bold">압축 품질 <input id="quality" type="range" min="10" max="100" value="75" class="mt-3 w-full" /></label><button id="run" class="mt-6 rounded-2xl bg-cyan-500 px-5 py-3 font-bold text-slate-950">압축하기</button><div id="result" class="mt-6"></div></section><Recommend /></main><Footer /></Layout>
<script is:inline>const file=document.getElementById('file'), quality=document.getElementById('quality'), result=document.getElementById('result'); document.getElementById('run').addEventListener('click',()=>{const f=file.files?.[0];if(!f){result.textContent='이미지를 먼저 선택해주세요.';return}const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=img.width;c.height=img.height;c.getContext('2d').drawImage(img,0,0);c.toBlob(b=>{const u=URL.createObjectURL(b);result.innerHTML=`<p class="text-sm text-slate-600">원본 ${(f.size/1024).toFixed(1)}KB → 압축 ${(b.size/1024).toFixed(1)}KB</p><a href="${u}" download="compressed-${f.name.replace(/\.[^.]+$/,'')}.jpg" class="mt-3 inline-block rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">압축 파일 다운로드</a>`},'image/jpeg',Number(quality.value)/100)};img.src=URL.createObjectURL(f)});</script>
