---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="날짜 계산기·D-day 계산기 | ManyTool" description="두 날짜 사이의 기간과 특정 날짜까지 남은 D-day를 계산하는 무료 날짜 계산기입니다." keywords="날짜 계산기, 디데이 계산기, 날짜 차이 계산, D-day"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Life Calculator</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">날짜 계산기·D-day</h1><p class="mt-3 text-sm leading-7 text-slate-300">두 날짜 사이의 일수와 기준일까지 남은 날짜를 계산합니다.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><div class="grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">시작일<input id="start" type="date" class="mt-2 w-full rounded-xl border p-3"/></label><label class="text-sm font-bold">종료일<input id="end" type="date" class="mt-2 w-full rounded-xl border p-3"/></label></div><button id="run" class="mt-6 rounded-2xl bg-cyan-500 px-5 py-3 font-bold">계산하기</button><div id="result" class="mt-6 rounded-2xl bg-slate-50 p-5 text-lg font-bold"></div></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const s=document.getElementById('start'),e=document.getElementById('end'),o=document.getElementById('result');const today=new Date();s.valueAsDate=today;document.getElementById('run').onclick=()=>{if(!s.value||!e.value){o.textContent='날짜를 모두 선택해주세요.';return}const a=new Date(`${s.value}T00:00:00`),b=new Date(`${e.value}T00:00:00`),days=Math.round((b-a)/86400000);o.innerHTML=`두 날짜의 차이: <span class="text-cyan-700">${Math.abs(days).toLocaleString()}일</span><br><span class="mt-2 block text-sm font-normal text-slate-500">종료일 포함 시 ${Math.abs(days)+1}일입니다.</span>`};</script>
