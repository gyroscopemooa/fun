---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { seoLocaleCodes } from '../../lib/i18n';
const copy = {
  zh: ['姓名匹配测试', '输入两个名字，查看简单的趣味匹配结果。', '姓名 1', '姓名 2', '查看结果', '请输入两个名字。', '匹配度'],
  es: ['Compatibilidad de nombres', 'Escribe dos nombres para ver un resultado divertido.', 'Nombre 1', 'Nombre 2', 'Ver resultado', 'Escribe ambos nombres.', 'Compatibilidad'],
  de: ['Namenskompatibilität', 'Gib zwei Namen ein und erhalte ein spielerisches Ergebnis.', 'Name 1', 'Name 2', 'Ergebnis anzeigen', 'Bitte beide Namen eingeben.', 'Kompatibilität'],
  fr: ['Compatibilité des prénoms', 'Saisissez deux prénoms pour obtenir un résultat amusant.', 'Prénom 1', 'Prénom 2', 'Voir le résultat', 'Saisissez les deux prénoms.', 'Compatibilité'],
  pt: ['Compatibilidade de nomes', 'Digite dois nomes para ver um resultado divertido.', 'Nome 1', 'Nome 2', 'Ver resultado', 'Digite os dois nomes.', 'Compatibilidade'],
  vi: ['Độ hợp tên', 'Nhập hai tên để xem kết quả vui nhộn.', 'Tên 1', 'Tên 2', 'Xem kết quả', 'Hãy nhập cả hai tên.', 'Độ hợp'],
  id: ['Kecocokan nama', 'Masukkan dua nama untuk melihat hasil yang menyenangkan.', 'Nama 1', 'Nama 2', 'Lihat hasil', 'Masukkan kedua nama.', 'Kecocokan'],
  it: ['Compatibilità dei nomi', 'Inserisci due nomi per vedere un risultato divertente.', 'Nome 1', 'Nome 2', 'Mostra risultato', 'Inserisci entrambi i nomi.', 'Compatibilità'],
  nl: ['Naamcompatibiliteit', 'Voer twee namen in voor een leuke uitslag.', 'Naam 1', 'Naam 2', 'Resultaat bekijken', 'Voer beide namen in.', 'Compatibiliteit'],
  ru: ['Совместимость имён', 'Введите два имени и получите шуточный результат.', 'Имя 1', 'Имя 2', 'Показать результат', 'Введите оба имени.', 'Совместимость'],
  ar: ['توافق الأسماء', 'أدخل اسمين لرؤية نتيجة ممتعة.', 'الاسم 1', 'الاسم 2', 'عرض النتيجة', 'أدخل الاسمين.', 'التوافق'],
  hi: ['नाम अनुकूलता', 'मज़ेदार परिणाम देखने के लिए दो नाम लिखें।', 'नाम 1', 'नाम 2', 'रिज़ल्ट देखें', 'दोनों नाम लिखें।', 'अनुकूलता'],
  tr: ['İsim Uyumu', 'Eğlenceli bir sonuç görmek için iki isim girin.', 'İsim 1', 'İsim 2', 'Sonucu göster', 'İki ismi de girin.', 'Uyum'],
  pl: ['Zgodność imion', 'Wpisz dwa imiona, aby zobaczyć zabawny wynik.', 'Imię 1', 'Imię 2', 'Pokaż wynik', 'Wpisz oba imiona.', 'Zgodność'],
  th: ['ความเข้ากันได้ของชื่อ', 'ป้อนชื่อสองชื่อเพื่อดูผลลัพธ์สนุก ๆ', 'ชื่อ 1', 'ชื่อ 2', 'ดูผลลัพธ์', 'กรุณาป้อนชื่อทั้งสองชื่อ', 'ความเข้ากันได้'],
  sv: ['Namnkompatibilitet', 'Skriv in två namn för att se ett roligt resultat.', 'Namn 1', 'Namn 2', 'Visa resultat', 'Skriv in båda namnen.', 'Kompatibilitet'],
  uk: ['Сумісність імен', 'Введіть два імені, щоб побачити розважальний результат.', 'Ім’я 1', 'Ім’я 2', 'Показати результат', 'Введіть обидва імені.', 'Сумісність'],
  en: ['Name compatibility', 'Enter two names to see a fun compatibility result.', 'Name 1', 'Name 2', 'Show result', 'Enter both names.', 'Compatibility']
};
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? copy.en;
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, name compatibility, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm leading-7 text-slate-600">{text[1]}</p><div class="mt-6 grid gap-3 sm:grid-cols-2"><input id="first" class="rounded-xl border border-slate-300 px-4 py-3" placeholder={text[2]} /><input id="second" class="rounded-xl border border-slate-300 px-4 py-3" placeholder={text[3]} /></div><button id="check" class="mt-4 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[4]}</button><p id="message" class="mt-4 min-h-6 text-sm text-rose-600"></p><div id="result" class="mt-5 hidden rounded-2xl bg-fuchsia-50 p-6 text-center"><p class="text-sm font-bold text-fuchsia-700">{text[6]}</p><p id="score" class="mt-2 text-5xl font-black text-fuchsia-900"></p></div></section></main><Footer /></Layout>
<script is:inline define:vars={{ text }}>
  const first = document.querySelector('#first'); const second = document.querySelector('#second'); const check = document.querySelector('#check'); const message = document.querySelector('#message'); const result = document.querySelector('#result'); const score = document.querySelector('#score');
  check.addEventListener('click', () => { const a = first.value.trim(); const b = second.value.trim(); if (!a || !b) { message.textContent = text[5]; result.classList.add('hidden'); return; } let seed = 0; for (const ch of `${a.toLowerCase()}-${b.toLowerCase()}`) seed = (seed * 31 + ch.charCodeAt(0)) % 101; message.textContent = ''; score.textContent = `${55 + seed % 46}%`; result.classList.remove('hidden'); });
</script>
