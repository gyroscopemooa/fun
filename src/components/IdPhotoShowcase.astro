---
const { variant = 'hero' } = Astro.props;
const examples = [
  { id: 'woman', title: '가까이 찍은 셀카도, 차분한 프로필로.', detail: '풀패키지 ON · 정장 · 머리 단정 · 피부·얼굴선·생기·메이크업' },
  { id: 'man', title: '헝클어진 아침 사진에서 새로운 첫인상으로.', detail: '풀패키지 ON · 정장 · 머리 단정 · 피부·얼굴선·생기·메이크업' }
];
---
{variant === 'hero' ? (
  <section class="studio-hero">
    <div class="studio-hero-copy">
      <p class="studio-eyebrow"><span></span> MANYTOOL PORTRAIT STUDIO</p>
      <h1>사진 한 장,<br />준비된 <em>첫인상.</em></h1>
      <p class="studio-intro">방금 찍은 셀카를 단정한 증명사진으로.<br />머리부터 정장, 자연스러운 보정까지<br class="desktop-break" /> 원하는 만큼만 선택하세요.</p>
      <div class="studio-hero-actions"><a class="studio-primary" href="#candidate-section">내 사진으로 시작하기 <span>↗</span></a><a class="studio-text-link" href="#real-samples">실제 변환 예시 보기 ↓</a></div>
      <div class="studio-hero-price"><strong>$9.90</strong><span>후보 3장 생성 · 최종 1장 다운로드<br />머리·정장·보정 옵션 추가 비용 없음</span></div>
    </div>
    <div class="studio-hero-preview">
      <div class="studio-preview-heading"><span>같은 사진, 달라진 준비도</span><div class="studio-example-tabs" aria-label="예시 사진 선택"><button type="button" data-example="woman" aria-pressed="true">예시 01</button><button type="button" data-example="man" aria-pressed="false">예시 02</button></div></div>
      <div class="studio-photo-pair">
        <figure class="studio-before"><img data-hero-before src="/images/id-studio/woman-before.webp" alt="제공된 원본 셀카" width="600" height="800" fetchpriority="high" /><figcaption><span>BEFORE</span> 원본 사진</figcaption></figure>
        <figure class="studio-after"><img data-hero-after src="/images/id-studio/woman-after.webp" alt="실제 증명사진 API로 생성한 풀패키지 결과" width="600" height="800" fetchpriority="high" /><figcaption><span>AFTER</span> 실제 AI 생성 결과</figcaption></figure>
      </div>
      <p class="studio-proof"><span>✦</span> 제공된 원본을 서비스의 실제 생성 API로 처리한 결과입니다.</p>
    </div>
  </section>
) : (
  <section id="real-samples" class="studio-real-samples">
    <div class="studio-section-heading"><div><p class="studio-eyebrow">REAL BEFORE & AFTER</p><h2>일러스트 대신,<br />실제로 만든 결과.</h2></div><p>아래 두 예시는 제공된 사진으로 직접 생성했습니다.<br />얼굴이 가려진 부분은 AI가 재구성하며,<br />원본 상태에 따라 결과가 달라질 수 있습니다.</p></div>
    <div class="studio-example-grid">{examples.map((example, index) => (
      <article class="studio-example-card"><div class="studio-example-title"><span>0{index + 1}</span><h3>{example.title}</h3></div><div class="studio-photo-pair"><figure class="studio-before"><img src={`/images/id-studio/${example.id}-before.webp`} alt={`예시 ${index + 1} 원본 사진`} width="600" height="800" loading="lazy" /><figcaption><span>BEFORE</span> 원본</figcaption></figure><figure class="studio-after"><img src={`/images/id-studio/${example.id}-after.webp`} alt={`예시 ${index + 1} 실제 API 풀패키지 결과`} width="600" height="800" loading="lazy" /><figcaption><span>AFTER</span> 실제 생성 결과</figcaption></figure></div><p class="studio-example-detail">{example.detail}</p></article>
    ))}</div>
  </section>
)}
{variant === 'hero' && <script is:inline>
  document.querySelectorAll('[data-example]').forEach((button) => button.addEventListener('click', () => {
    const example = button.dataset.example;
    if (!['woman', 'man'].includes(example)) return;
    document.querySelector('[data-hero-before]').src = `/images/id-studio/${example}-before.webp`;
    document.querySelector('[data-hero-after]').src = `/images/id-studio/${example}-after.webp`;
    document.querySelectorAll('[data-example]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
  }));
</script>}
