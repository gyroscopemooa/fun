---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';

const copy = {
  zh: ['ManyTool 在线工具', 'AI 工具、游戏工具和实用网页工具。'],
  es: ['Herramientas online ManyTool', 'Herramientas de IA, juegos y utilidades web.'],
  de: ['ManyTool Online-Werkzeuge', 'KI-Werkzeuge, Spiele und praktische Webtools.'],
  fr: ['Outils en ligne ManyTool', 'Outils IA, jeux et utilitaires web pratiques.'],
  pt: ['Ferramentas online ManyTool', 'Ferramentas de IA, jogos e utilidades web.'],
  vi: ['Công cụ trực tuyến ManyTool', 'Công cụ AI, trò chơi và tiện ích web.'],
  id: ['Alat online ManyTool', 'Alat AI, permainan, dan utilitas web.']
};

export function getStaticPaths() {
  return ['zh', 'es', 'de', 'fr', 'pt', 'vi', 'id'].map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const [title, description] = copy[locale as keyof typeof copy];
---

<Layout title={`${title} | ManyTool`} description={description}>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-600">ManyTool</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900">{title}</h1>
      <p class="mt-3 text-sm leading-7 text-slate-600">{description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/${locale}/ai-image-generator`} class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white">AI Image Generator</a>
        <a href={`/${locale}/valorant-agent-picker`} class="rounded-full border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700">Valorant Agent Picker</a>
        <a href={`/${locale}/name-compatibility`} class="rounded-full border border-slate-300 px-5 py-3 text-sm font-bold text-slate-700">Name Compatibility</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
