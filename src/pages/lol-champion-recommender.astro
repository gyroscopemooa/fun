---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Recommend from '../components/Recommend.astro';

const fallbackIds = `Aatrox Ahri Akali Akshan Alistar Ambessa Amumu Anivia Annie Aphelios Ashe AurelionSol Aurora Azir Bard Belveth Blitzcrank Brand Braum Briar Caitlyn Camille Cassiopeia Chogath Corki Darius Diana Draven DrMundo Ekko Elise Evelynn Ezreal Fiddlesticks Fiora Fizz Galio Gangplank Garen Gnar Gragas Graves Gwen Hecarim Heimerdinger Hwei Illaoi Irelia Ivern Janna JarvanIV Jax Jayce Jhin Jinx Kaisa Kalista Karma Karthus Kassadin Katarina Kayle Kayn Kennen Khazix Kindred Kled KogMaw KSante Leblanc LeeSin Leona Lillia Lissandra Lucian Lulu Lux Malphite Malzahar Maokai MasterYi Mel Milio MissFortune MonkeyKing Mordekaiser Morgana Naafiri Nami Nasus Nautilus Neeko Nidalee Nilah Nocturne Nunu Olaf Orianna Ornn Pantheon Poppy Pyke Qiyana Quinn Rakan Rammus RekSai Rell Renata Renekton Rengar Riven Rumble Ryze Samira Sejuani Senna Seraphine Sett Shaco Shen Shyvana Singed Sion Sivir Skarner Smolder Sona Soraka Swain Sylas Syndra TahmKench Taliyah Talon Taric Teemo Thresh Tristana Trundle Tryndamere TwistedFate Twitch Udyr Urgot Varus Vayne Veigar Velkoz Vex Vi Viego Viktor Vladimir Volibear Warwick Xayah Xerath XinZhao Yasuo Yone Yorick Yunara Yuumi Zaahen Zac Zed Zeri Ziggs Zilean Zoe Zyra`.split(' ');
const fallbackChampions = fallbackIds.map((id) => ({ id, name: id }));
---

<Layout title="롤 챔피언 추천기 | 포지션별 리그 오브 레전드 챔피언 랜덤 추천 | ManyTool" description="탑, 정글, 미드, 원딜, 서폿 포지션과 플레이 스타일을 선택하면 리그 오브 레전드 챔피언을 랜덤으로 추천해주는 무료 도구입니다." keywords="롤 챔피언 추천, 롤 챔프 추천, 리그 오브 레전드 챔피언 추천, 롤 포지션 추천">
  <Header /><main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] bg-slate-950 p-6 text-white shadow-sm sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">League Champion Picker</p><h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">롤 챔피언 추천기</h1><p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">오늘 어떤 챔피언을 할지 고민될 때 포지션과 플레이 스타일을 골라 랜덤으로 추천받아 보세요. 현재 리그 오브 레전드 챔피언 목록을 기준으로 동작합니다.</p></section><AdsterraBanner placement="top" />
    <section class="mt-6 grid gap-6 lg:grid-cols-[300px_minmax(0,1fr)]"><aside class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-950">추천 조건</h2><label class="mt-5 block"><span class="mb-2 block text-sm font-semibold text-slate-700">포지션</span><select id="lol-role" class="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm text-slate-900"><option value="all">전체 포지션</option><option value="top">탑</option><option value="jungle">정글</option><option value="mid">미드</option><option value="bot">원딜</option><option value="support">서폿</option></select></label><label class="mt-4 block"><span class="mb-2 block text-sm font-semibold text-slate-700">플레이 스타일</span><select id="lol-style" class="w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm text-slate-900"><option value="all">상관없음</option><option value="carry">캐리형</option><option value="tank">탱커형</option><option value="utility">유틸형</option><option value="fighter">난전형</option><option value="poke">포킹형</option></select></label><button id="lol-pick" type="button" class="mt-6 w-full rounded-2xl bg-cyan-500 px-5 py-3 font-bold text-slate-950 transition hover:bg-cyan-300">챔피언 추천받기</button><p id="lol-count" class="mt-3 text-center text-xs text-slate-500">챔피언 목록을 불러오는 중...</p></aside><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><div id="lol-result" class="flex min-h-[360px] flex-col items-center justify-center text-center"><div class="text-6xl">🎲</div><h2 class="mt-5 text-2xl font-black text-slate-950">챔피언을 추천받아 보세요</h2><p class="mt-2 max-w-md text-sm leading-6 text-slate-500">조건을 고른 뒤 버튼을 누르면 플레이할 챔피언 한 명을 골라드립니다.</p></div></section></section>
    <AdsterraBanner placement="bottom" />
    <Recommend />
  </main><Footer />
</Layout>

<script is:inline define:vars={{ fallbackChampions }}>
  const FALLBACK = fallbackChampions; let champions = FALLBACK; const roleEl = document.getElementById('lol-role'), styleEl = document.getElementById('lol-style'), pickEl = document.getElementById('lol-pick'), resultEl = document.getElementById('lol-result'), countEl = document.getElementById('lol-count'); const has = (c, tag) => (c.tags || []).includes(tag);
  const matches = (c, role, style) => { const roleMatch = role === 'all' || (role === 'top' && (has(c, 'Fighter') || has(c, 'Tank'))) || (role === 'jungle' && (has(c, 'Fighter') || has(c, 'Assassin') || has(c, 'Tank'))) || (role === 'mid' && (has(c, 'Mage') || has(c, 'Assassin'))) || (role === 'bot' && has(c, 'Marksman')) || (role === 'support' && (has(c, 'Support') || has(c, 'Tank'))); const styleMatch = style === 'all' || (style === 'carry' && (has(c, 'Marksman') || has(c, 'Assassin'))) || (style === 'tank' && has(c, 'Tank')) || (style === 'utility' && has(c, 'Support')) || (style === 'fighter' && has(c, 'Fighter')) || (style === 'poke' && has(c, 'Mage')); return roleMatch && styleMatch; };
  const pick = () => { const pool = champions.filter((c) => matches(c, roleEl.value, styleEl.value)); const usable = pool.length ? pool : champions; const c = usable[Math.floor(Math.random() * usable.length)]; const image = c.image ? `https://ddragon.leagueoflegends.com/cdn/16.15.1/img/champion/${c.id}.png` : ''; resultEl.innerHTML = `${image ? `<img src="${image}" alt="${c.name}" class="h-28 w-28 rounded-full border-4 border-cyan-400 shadow-lg" />` : '<div class="text-7xl">🎮</div>'}<p class="mt-5 text-xs font-bold uppercase tracking-[0.2em] text-cyan-600">오늘의 추천 챔피언</p><h2 class="mt-2 text-4xl font-black text-slate-950">${c.name || c.id}</h2><p class="mt-3 text-sm text-slate-500">조건에 맞는 ${usable.length}명의 챔피언 중 랜덤 추천</p><button id="lol-pick-again" type="button" class="mt-6 rounded-full border border-slate-300 px-5 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50">다시 뽑기</button>`; document.getElementById('lol-pick-again')?.addEventListener('click', pick); };
  pickEl.addEventListener('click', pick); fetch('https://ddragon.leagueoflegends.com/cdn/16.15.1/data/en_US/champion.json').then((r) => r.json()).then((payload) => { champions = Object.values(payload.data).filter((c) => !c.id.startsWith('Jade_')); countEl.textContent = `${champions.length}명 챔피언 준비 완료`; }).catch(() => { countEl.textContent = `${champions.length}명 챔피언 준비 완료`; });
</script>
