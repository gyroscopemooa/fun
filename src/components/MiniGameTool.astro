---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from './ads/AdsterraBanner.astro';
import ToolGuide from './ToolGuide.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Recommend from './Recommend.astro';

const { tool } = Astro.props;
const configs = {
  sensitivity: ['FPS 감도 변환기', '게임별 감도와 eDPI, cm/360을 빠르게 계산합니다.'],
  crosshair: ['크로스헤어 생성기', 'FPS 게임에서 사용할 조준선을 만들고 설정값을 복사합니다.'],
  fov: ['FOV·해상도 계산기', '화면 비율과 FOV 변화를 간단히 비교합니다.'],
  dpi: ['DPI·eDPI 계산기', '마우스 DPI와 게임 감도로 실제 eDPI를 계산합니다.'],
  aim: ['FPS 조준 훈련', '움직이는 타겟을 클릭하며 조준 기록을 연습합니다.'],
  damage: ['게임 데미지 계산기', '공격력과 방어력으로 필요한 타격 횟수를 계산합니다.'],
  keybind: ['게임 키 세팅 시각화', '자주 쓰는 키 설정을 입력하고 키보드 형태로 확인합니다.'],
  session: ['게임 세션 기록기', '플레이 시간과 승패를 브라우저에 기록합니다.']
};
const [title, description] = configs[tool] ?? configs.sensitivity;
---

<Layout title={`${title} | ManyTool`} description={description}>
  <Header />
  <main class="mx-auto max-w-4xl px-4 py-8">
    <section class="rounded-[28px] bg-slate-950 p-6 text-white shadow-sm sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">ManyTool Game Tools</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">{description}</p>
    </section>
    <AdsterraBanner placement="top" />

    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      {tool === 'sensitivity' && <div class="grid gap-4 sm:grid-cols-2"><label>게임<select id="game" class="mt-2 w-full rounded-xl border p-3"><option value="1">기준 게임</option><option value="0.314">Valorant → CS2</option><option value="0.318">CS2 → Valorant</option><option value="0.07">Overwatch → Valorant</option></select></label><label>현재 감도<input id="sens" type="number" step="0.01" value="1" class="mt-2 w-full rounded-xl border p-3" /></label><div class="rounded-2xl bg-slate-100 p-4 sm:col-span-2"><p class="text-sm text-slate-500">변환 감도</p><p id="sens-result" class="mt-1 text-3xl font-black">1.00</p><p class="mt-2 text-sm text-slate-500">eDPI: <span id="edpi-result">800</span> · cm/360: <span id="cm-result">51.95</span></p></div><button id="sens-calc" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white sm:col-span-2">계산하기</button></div>}
      {tool === 'crosshair' && <div class="grid gap-6 md:grid-cols-[1fr_220px]"><div class="grid gap-4 sm:grid-cols-2"><label>크기<input id="cross-size" type="range" min="1" max="20" value="6" class="mt-3 w-full" /></label><label>두께<input id="cross-width" type="range" min="1" max="8" value="2" class="mt-3 w-full" /></label><label>색상<input id="cross-color" type="color" value="#00ff88" class="mt-2 h-10 w-full" /></label><label>중앙점<input id="cross-dot" type="checkbox" class="ml-3" /></label></div><div class="flex min-h-48 items-center justify-center rounded-2xl bg-slate-900"><div id="cross-preview" class="relative h-12 w-12"><i class="absolute left-1/2 top-0 h-5 -translate-x-1/2 bg-emerald-400"></i><i class="absolute bottom-0 left-1/2 h-5 -translate-x-1/2 bg-emerald-400"></i><i class="absolute left-0 top-1/2 h-1 w-5 -translate-y-1/2 bg-emerald-400"></i><i class="absolute right-0 top-1/2 h-1 w-5 -translate-y-1/2 bg-emerald-400"></i></div></div><button id="cross-copy" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white md:col-span-2">설정값 복사</button><p id="cross-status" class="text-sm text-slate-500"></p></div>}
      {tool === 'fov' && <div class="grid gap-4 sm:grid-cols-2"><label>기존 화면 비율<select id="fov-from" class="mt-2 w-full rounded-xl border p-3"><option value="1.7778">16:9</option><option value="1.3333">4:3</option><option value="1.6">16:10</option></select></label><label>변경 화면 비율<select id="fov-to" class="mt-2 w-full rounded-xl border p-3"><option value="1.3333">4:3</option><option value="1.7778">16:9</option><option value="1.6">16:10</option></select></label><label>현재 수평 FOV<input id="fov-value" type="number" value="103" class="mt-2 w-full rounded-xl border p-3" /></label><div class="rounded-2xl bg-slate-100 p-4"><p class="text-sm text-slate-500">변환 결과</p><p id="fov-result" class="mt-1 text-2xl font-black">-</p></div><button id="fov-calc" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white sm:col-span-2">FOV 계산</button></div>}
      {tool === 'dpi' && <div class="grid gap-4 sm:grid-cols-2"><label>DPI<input id="dpi-value" type="number" value="800" class="mt-2 w-full rounded-xl border p-3" /></label><label>게임 감도<input id="dpi-sens" type="number" step="0.01" value="1" class="mt-2 w-full rounded-xl border p-3" /></label><div class="rounded-2xl bg-slate-100 p-4 sm:col-span-2"><p class="text-sm text-slate-500">실제 eDPI</p><p id="dpi-result" class="mt-1 text-3xl font-black">800</p></div><button id="dpi-calc" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white sm:col-span-2">eDPI 계산</button></div>}
      {tool === 'aim' && <div><div id="aim-arena" class="relative h-[420px] overflow-hidden rounded-2xl bg-slate-900"><button id="aim-target" class="absolute hidden h-14 w-14 -translate-x-1/2 -translate-y-1/2 rounded-full border-4 border-white bg-rose-500"></button></div><div class="mt-4 grid grid-cols-3 gap-2 text-center text-sm"><p class="rounded-xl bg-slate-100 p-3">명중 <b id="aim-hits">0</b></p><p class="rounded-xl bg-slate-100 p-3">평균 <b id="aim-avg">-</b></p><p class="rounded-xl bg-slate-100 p-3">실패 <b id="aim-miss">0</b></p></div><button id="aim-start" class="mt-4 w-full rounded-xl bg-slate-950 px-4 py-3 font-bold text-white">훈련 시작</button></div>}
      {tool === 'damage' && <div class="grid gap-4 sm:grid-cols-2"><label>공격력<input id="damage-power" type="number" value="100" class="mt-2 w-full rounded-xl border p-3" /></label><label>상대 방어력<input id="damage-armor" type="number" value="50" class="mt-2 w-full rounded-xl border p-3" /></label><label>상대 체력<input id="damage-hp" type="number" value="1000" class="mt-2 w-full rounded-xl border p-3" /></label><div class="rounded-2xl bg-slate-100 p-4"><p class="text-sm text-slate-500">필요 타격 횟수</p><p id="damage-result" class="mt-1 text-3xl font-black">-</p></div><button id="damage-calc" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white sm:col-span-2">계산하기</button></div>}
      {tool === 'keybind' && <div><p class="text-sm text-slate-500">키를 입력하면 아래 키보드에 표시됩니다.</p><input id="keybind-input" placeholder="WASD Q E R Shift Ctrl" class="mt-4 w-full rounded-xl border p-3" /><div id="keybind-board" class="mt-5 grid grid-cols-7 gap-2 text-center text-xs font-bold"></div></div>}
      {tool === 'session' && <div class="grid gap-4 sm:grid-cols-2"><label>게임 이름<input id="session-game" placeholder="예: Valorant" class="mt-2 w-full rounded-xl border p-3" /></label><label>플레이 시간(분)<input id="session-time" type="number" value="30" class="mt-2 w-full rounded-xl border p-3" /></label><label>승리<input id="session-win" type="number" value="1" class="mt-2 w-full rounded-xl border p-3" /></label><label>패배<input id="session-loss" type="number" value="0" class="mt-2 w-full rounded-xl border p-3" /></label><button id="session-add" class="rounded-xl bg-slate-950 px-4 py-3 font-bold text-white sm:col-span-2">세션 기록</button><div id="session-list" class="space-y-2 sm:col-span-2"></div></div>}
    </section>
    <ToolGuide />
    <AdsterraBanner placement="bottom" />
    <Recommend />
  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ tool }}>
  const $ = (id) => document.getElementById(id);
  if (tool === 'sensitivity') { const calc = () => { const s = Number($('sens').value) || 0; const ratio = Number($('game').value) || 1; $('sens-result').textContent = (s * ratio).toFixed(2); $('edpi-result').textContent = Math.round(s * 800 * ratio); $('cm-result').textContent = (415.7 / (s * 800 * ratio || 1)).toFixed(2); }; $('sens-calc').addEventListener('click', calc); calc(); }
  if (tool === 'dpi') { const calc = () => { const n = (Number($('dpi-value').value) || 0) * (Number($('dpi-sens').value) || 0); $('dpi-result').textContent = Math.round(n); }; $('dpi-calc').addEventListener('click', calc); calc(); }
  if (tool === 'fov') { $('fov-calc').addEventListener('click', () => { const from = Number($('fov-from').value), to = Number($('fov-to').value), fov = Number($('fov-value').value) || 0; const h = 2 * Math.atan(Math.tan((fov * Math.PI / 180) / 2) * (to / from)) * 180 / Math.PI; $('fov-result').textContent = `${h.toFixed(1)}°`; }); }
  if (tool === 'crosshair') { const update = () => { const color = $('cross-color').value, size = Number($('cross-size').value), width = Number($('cross-width').value); $('cross-preview').querySelectorAll('i').forEach((el, i) => { el.style.backgroundColor = color; el.style.width = i < 2 ? `${width}px` : `${size}px`; el.style.height = i < 2 ? `${size}px` : `${width}px`; }); }; ['cross-color','cross-size','cross-width'].forEach((id) => $(id).addEventListener('input', update)); $('cross-copy').addEventListener('click', async () => { await navigator.clipboard?.writeText(`size=${$('cross-size').value}; thickness=${$('cross-width').value}; color=${$('cross-color').value}`); $('cross-status').textContent = '설정값을 복사했습니다.'; }); update(); }
  if (tool === 'damage') { $('damage-calc').addEventListener('click', () => { const power = Number($('damage-power').value) || 0, armor = Number($('damage-armor').value) || 0, hp = Number($('damage-hp').value) || 0; $('damage-result').textContent = `${Math.ceil(hp / (power * 100 / (100 + Math.max(armor, 0))))}회`; }); }
  if (tool === 'keybind') { const board = $('keybind-board'); const render = () => { board.innerHTML = 'Q W E R A S D F Shift Ctrl Space'.split(' ').map((k) => `<div class="rounded-lg border bg-slate-100 p-3">${k}<br><span class="text-[10px] text-slate-500">${$('keybind-input').value.toUpperCase().includes(k) ? '사용' : ''}</span></div>`).join(''); }; $('keybind-input').addEventListener('input', render); render(); }
  if (tool === 'session') { const key = 'manytool-game-sessions'; const render = () => { const rows = JSON.parse(localStorage.getItem(key) || '[]'); $('session-list').innerHTML = rows.length ? rows.slice().reverse().map((r) => `<div class="flex justify-between rounded-xl bg-slate-100 p-3 text-sm"><span>${r.game || '이름 없는 게임'} · ${r.time}분</span><b>${r.win}승 ${r.loss}패</b></div>`).join('') : '<p class="text-sm text-slate-500">아직 기록이 없습니다.</p>'; }; $('session-add').addEventListener('click', () => { const rows = JSON.parse(localStorage.getItem(key) || '[]'); rows.push({ game: $('session-game').value, time: $('session-time').value, win: $('session-win').value, loss: $('session-loss').value }); localStorage.setItem(key, JSON.stringify(rows)); render(); }); render(); }
  if (tool === 'aim') { let active = false, started = 0, hits = [], miss = 0; const move = () => { const arena = $('aim-arena'), target = $('aim-target'); target.style.left = `${Math.random() * 86 + 7}%`; target.style.top = `${Math.random() * 78 + 11}%`; target.classList.remove('hidden'); started = performance.now(); }; $('aim-start').addEventListener('click', () => { active = true; hits = []; miss = 0; move(); }); $('aim-target').addEventListener('click', () => { if (!active) return; hits.push(Math.round(performance.now() - started)); $('aim-hits').textContent = hits.length; $('aim-avg').textContent = `${Math.round(hits.reduce((a,b) => a+b, 0) / hits.length)}ms`; if (hits.length >= 10) { active = false; $('aim-target').classList.add('hidden'); return; } move(); }); $('aim-arena').addEventListener('click', (e) => { if (active && e.target === $('aim-arena')) { miss++; $('aim-miss').textContent = miss; } }); }
</script>
