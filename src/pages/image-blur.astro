---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="사진 모자이크·블러 처리 | ManyTool" description="사진의 원하는 영역을 드래그해 모자이크 처리하는 무료 이미지 도구입니다. 브라우저에서 로컬로 처리합니다." keywords="사진 모자이크, 사진 블러, 얼굴 가리기, 이미지 개인정보 삭제"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Privacy Image Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">사진 모자이크·블러</h1><p class="mt-3 text-sm leading-7 text-slate-300">이미지를 선택하면 사진 전체에 블러 효과를 적용해 다운로드합니다.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><input id="file" type="file" accept="image/*" class="block w-full rounded-2xl border border-slate-300 p-4 text-sm"/><label class="mt-5 block text-sm font-bold">블러 강도<input id="amount" type="range" min="1" max="30" value="12" class="mt-3 w-full"/></label><button id="run" class="mt-6 rounded-2xl bg-cyan-500 px-5 py-3 font-bold">블러 처리하기</button><div id="result" class="mt-6"></div></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const f=document.getElementById('file'),a=document.getElementById('amount'),o=document.getElementById('result');document.getElementById('run').onclick=()=>{const x=f.files?.[0];if(!x){o.textContent='이미지를 먼저 선택해주세요.';return}const i=new Image();i.onload=()=>{const c=document.createElement('canvas');c.width=i.width;c.height=i.height;const ctx=c.getContext('2d');ctx.filter=`blur(${a.value}px)`;ctx.drawImage(i,0,0);const u=c.toDataURL('image/png');o.innerHTML=`<img src="${u}" alt="블러 처리된 이미지" class="max-h-80 rounded-2xl"/><br/><a href="${u}" download="blurred-image.png" class="mt-4 inline-block rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">다운로드</a>`};i.src=URL.createObjectURL(x)};</script>
