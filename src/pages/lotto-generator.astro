---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LottoGenerator from '../components/LottoGenerator';
---
<Layout title="로또 번호 생성기 | ManyTool" description="1부터 45까지 중복 없는 번호 6개를 무작위로 뽑습니다. 한 번에 최대 5게임을 만들어보세요."><Header /><main class="mx-auto max-w-5xl px-4 py-10"><a href="/" class="text-sm font-bold text-violet-700">← 매니툴 홈</a><section class="mt-5 rounded-[28px] bg-slate-950 p-8 text-white"><p class="text-xs font-bold tracking-widest text-violet-300">MANYTOOL · LUCKY NUMBERS</p><h1 class="mt-3 text-3xl font-black sm:text-4xl">로또 번호 생성기</h1><p class="mt-4 leading-7 text-slate-300">1부터 45까지 중복 없는 번호 6개를 무작위로 뽑습니다. 한 번에 최대 5게임을 만들어보세요.</p></section><LottoGenerator client:load /></main><Footer /></Layout>
