---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="공개 크레딧 충전·사용 테스트 | ManyTool" description="Google 로그인 후 모의 충전과 사용 경로를 확인하는 공개 심사 페이지" noindex>
<Header/><main class="mx-auto max-w-3xl px-4 py-10">
<h1 class="text-3xl font-black">크레딧 충전·사용 공개 테스트</h1>
<aside class="my-5 rounded-xl border border-amber-300 bg-amber-50 p-5 leading-7"><strong>심사용 모의 테스트 · 실제 결제 없음</strong><p>Google 로그인은 실제 인증입니다. 아래 테스트 크레딧은 실제 금전·운영 잔액·유료 상품 구매와 무관합니다. NICE 충전 승인이나 유료 AI 결과가 아닙니다.</p><p>10개 충전·2개 차감은 검수용 예시입니다. 판매 가격과 상품별 차감량은 미정입니다. 테스트 상태는 브라우저의 1시간 임시 세션에 보관하며 로그아웃·만료 시 초기화됩니다.</p></aside>
<p id="review-message" class="my-4 rounded-xl bg-slate-100 p-4" role="status">설정을 확인하고 있습니다.</p>
<section id="review-login" class="rounded-2xl border p-6"><h2 class="text-xl font-bold">1. Google 계정으로 테스트 로그인</h2><p class="my-3 text-sm">계정 선택 후 동의를 완료해주세요. 기존 운영 지갑과 별도입니다.</p><div id="review-google"></div><button id="retry" class="mt-4 underline">로그인 버튼 다시 불러오기</button></section>
<section id="review-wallet" hidden class="mt-6 rounded-2xl border p-6"><p id="account" class="text-sm"></p><h2 class="my-4 text-2xl font-bold">테스트 잔액 <span id="balance">0</span>개</h2><button id="logout" class="underline">테스트 로그아웃</button>
<h3 class="mt-6 text-xl font-bold">2. 테스트 크레딧 충전</h3><p class="my-3">10개를 모의 충전합니다. 카드정보 입력과 금전 결제는 없습니다.</p><button id="topup" disabled class="rounded-xl bg-slate-900 px-5 py-3 font-bold text-white disabled:opacity-40">테스트 크레딧 10개 충전</button>
<h3 class="mt-6 text-xl font-bold">3. 테스트 상품 선택·사용</h3><p class="my-3">사용 경로 검수용 샘플 상품입니다. 2개를 차감하고 테스트 완료 결과를 표시합니다. 실제 유료 AI는 실행하지 않습니다.</p><button id="use" disabled class="rounded-xl bg-cyan-800 px-5 py-3 font-bold text-white disabled:opacity-40">테스트 상품 사용 · 2개 차감</button>
<h3 class="mt-6 text-xl font-bold">4. 사용 결과·내역 확인</h3><p id="result" class="my-3"></p><ul id="ledger" class="list-disc pl-5"></ul></section>
<p class="mt-8"><a class="underline" href="/credits/">크레딧 안내</a> · <a class="underline" href="/payment-review/">NICE 직접결제 확인</a></p>
</main>
<script is:inline>
(()=>{const $=id=>document.getElementById(id);let busy=false;const api=async(path,body)=>{const r=await fetch('/api/credit-review/'+path,{credentials:'same-origin',...(body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})});const d=await r.json();if(!r.ok)throw Object.assign(new Error(d.error),{status:r.status});return d;};
function show(s){$('review-login').hidden=!!s;$('review-wallet').hidden=!s;if(!s)return;$('account').textContent='Google 테스트 계정: '+s.email;$('balance').textContent=s.balance;$('topup').disabled=busy||s.topped;$('topup').textContent=s.topped?'모의 충전 완료 · 중복 지급 없음':'테스트 크레딧 10개 충전';$('use').disabled=busy||!s.topped||s.used;$('use').textContent=s.used?'테스트 상품 사용 완료':'테스트 상품 사용 · 2개 차감';$('result').textContent=s.result||'아직 사용 결과가 없습니다.';$('ledger').replaceChildren();for(const row of s.history){const li=document.createElement('li');li.textContent=row.label+' '+(row.delta>0?'+':'')+row.delta+'개';$('ledger').append(li);}}
async function login(){try{const c=await api('challenge',{});if(!window.google?.accounts?.id)await new Promise((resolve,reject)=>{let s=document.createElement('script');s.src='https://accounts.google.com/gsi/client';s.onload=resolve;s.onerror=reject;document.head.append(s);});$('review-google').replaceChildren();google.accounts.id.initialize({client_id:c.clientId,nonce:c.nonce,auto_select:false,callback:async result=>{try{show(await api('session',{credential:result.credential}));$('review-message').textContent='Google 로그인 완료. 테스트 크레딧 충전을 시작할 수 있습니다.';}catch(e){$('review-message').textContent=e.message;await login();}}});google.accounts.id.renderButton($('review-google'),{theme:'outline',size:'large',locale:'ko',text:'signin_with'});}catch(e){$('review-message').textContent=e.message;}}
$('retry').onclick=login;for(const action of ['topup','use'])$(action).onclick=async()=>{if(busy)return;busy=true;$('topup').disabled=true;$('use').disabled=true;try{const s=await api(action,{});busy=false;show(s);$('review-message').textContent=action==='topup'?'모의 충전 완료: 10개 반영. 실제 결제는 없습니다.':'테스트 상품 사용 완료: 2개 차감, 잔액 8개.';}catch(e){busy=false;$('review-message').textContent=e.message;try{show(await api('me'));}catch{show(null);await login();}}};$('logout').onclick=async()=>{try{await api('logout',{});show(null);$('review-message').textContent='테스트 로그아웃했습니다.';await login();}catch(e){$('review-message').textContent=e.message;}};
(async()=>{try{await api('config');try{show(await api('me'));$('review-message').textContent='테스트 세션을 불러왔습니다.';}catch(e){if(e.status!==401)throw e;show(null);$('review-message').textContent='Google 로그인 후 모의 충전·사용을 확인해주세요.';await login();}}catch(e){$('review-message').textContent=e.message;}})();})();
</script></Layout>
