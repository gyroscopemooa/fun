---
import Footer from '../../components/Footer.astro'; import Header from '../../components/Header.astro'; import Layout from '../../layouts/Layout.astro'; import { seoLocaleCodes } from '../../lib/i18n';
const copy = { zh: ['日期计算器', '选择两个日期，计算它们之间相差多少天。', '开始日期', '结束日期', '计算天数', '请输入两个日期。'], es: ['Calculadora de fechas', 'Elige dos fechas para calcular cuántos días hay entre ellas.', 'Fecha inicial', 'Fecha final', 'Calcular días', 'Selecciona ambas fechas.'], de: ['Datumsrechner', 'Wähle zwei Daten und berechne die Anzahl der Tage dazwischen.', 'Startdatum', 'Enddatum', 'Tage berechnen', 'Wähle beide Daten.'], fr: ['Calculateur de dates', 'Choisissez deux dates pour calculer le nombre de jours entre elles.', 'Date de début', 'Date de fin', 'Calculer les jours', 'Choisissez les deux dates.'], pt: ['Calculadora de datas', 'Escolha duas datas para calcular quantos dias existem entre elas.', 'Data inicial', 'Data final', 'Calcular dias', 'Selecione as duas datas.'], vi: ['Máy tính ngày', 'Chọn hai ngày để tính số ngày chênh lệch.', 'Ngày bắt đầu', 'Ngày kết thúc', 'Tính số ngày', 'Hãy chọn cả hai ngày.'], id: ['Kalkulator tanggal', 'Pilih dua tanggal untuk menghitung selisih hari.', 'Tanggal mulai', 'Tanggal akhir', 'Hitung hari', 'Pilih kedua tanggal.'] };
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? ['Date calculator', 'Choose two dates to calculate the number of days between them.', 'Start date', 'End date', 'Calculate days', 'Choose both dates.'];
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, date calculator, ManyTool`}><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-8 shadow-sm"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm text-slate-600">{text[1]}</p><div class="mt-6 grid gap-3 sm:grid-cols-2"><label class="text-sm font-bold">{text[2]}<input id="start" type="date" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" /></label><label class="text-sm font-bold">{text[3]}<input id="end" type="date" class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-3" /></label></div><button id="calc" class="mt-5 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[4]}</button><p id="message" class="mt-4 min-h-6 text-sm text-rose-600"></p><p id="result" class="mt-5 text-4xl font-black text-cyan-700"></p></section></main><Footer /></Layout>
<script is:inline define:vars={{ error: text[5] }}>
  const start = document.querySelector('#start'); const end = document.querySelector('#end'); const calc = document.querySelector('#calc'); const message = document.querySelector('#message'); const result = document.querySelector('#result'); calc.addEventListener('click', () => { if (!start.value || !end.value) { message.textContent = error; result.textContent = ''; return; } message.textContent = ''; const days = Math.round(Math.abs(new Date(end.value).getTime() - new Date(start.value).getTime()) / 86400000); result.textContent = `${days} days`; });
</script>
