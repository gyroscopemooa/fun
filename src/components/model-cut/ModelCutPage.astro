---
import AiImageGenerator from '../home/AiImageGenerator';
import AdsterraBanner from '../ads/AdsterraBanner.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import Layout from '../../layouts/Layout.astro';
import { MODEL_CUT_SAMPLES, MODEL_CUT_SLOTS_PER_USE_CASE, modelCutSamplesFor, type ModelCutUseCase } from '../../lib/model-cut-samples';

type Props = { locale: 'ko' | 'en' };
const { locale } = Astro.props;
const isKo = locale === 'ko';

const copy = isKo
  ? {
      title: 'AI 모델컷 생성기 | 옷 사진으로 쇼핑몰 모델컷·착장샷 만들기 | ManyTool',
      description: '옷 사진 한 장(바닥컷·행거컷·마네킹컷)만 넣으면 AI 모델이 입은 쇼핑몰 모델컷과 착장샷을 만들어 줍니다. 모델 섭외·촬영 없이 상세페이지용 착용 이미지를 만드세요.',
      keywords: 'AI 모델컷, AI 모델 착용샷, 쇼핑몰 모델컷, 옷 사진 모델 착용, 착장샷, 가상 피팅, 상세페이지 모델 사진, AI 룩북',
      eyebrow: 'AI MODEL CUT',
      intro: '옷 사진만 넣으면, 모델이 입은 사진이 나옵니다. 모델 섭외도, 촬영도 필요 없어요.',
      promoEyebrow: '옷만 넣으세요',
      promoTitle: '옷 사진 한 장이면 충분해요',
      promoDesc: '바닥에 펼쳐 찍은 사진, 행거에 건 사진, 마네킹 사진 모두 됩니다. 색상·패턴·로고는 그대로 살려서 AI 모델에게 입혀 드려요.',
      before: '옷 사진',
      after: 'AI 모델컷',
      soon: '샘플 준비 중',
      useCases: {
        shop: {
          badge: '셀러용',
          title: '옷만 넣으면, 쇼핑몰에서 바로 파는 모델컷',
          desc: '스마트스토어·쿠팡·자사몰 상세페이지에 바로 올릴 수 있는 깔끔한 화이트 스튜디오 룩북컷을 만듭니다. 신상품이 들어올 때마다 촬영할 필요가 없어요.',
          points: ['모델 섭외·스튜디오 촬영 비용 0원', '화이트 배경 룩북 스타일 기본 제공', '남성·여성 모델, 야외 배경 요청 가능']
        },
        tryon: {
          badge: '구매자용',
          title: '옷만 넣으면, 내가 안 입어봐도 대신 입어주는 착장샷',
          desc: '사고 싶은 옷, 옷장에 있는 옷을 AI 모델이 대신 입어 봅니다. 입었을 때 핏과 분위기, 코디 느낌을 미리 확인해 보세요.',
          points: ['입었을 때 핏·기장감 미리보기', '"20대 여성, 캐주얼 코디"처럼 요청 가능', '온라인 쇼핑 전 착용 느낌 확인']
        }
      },
      stepsTitle: '이렇게 만들어요',
      steps: [
        { title: '옷 사진 올리기', desc: '옷 전체가 보이는 사진 한 장을 올려요.' },
        { title: '모델·배경 요청 (선택)', desc: '"남성 모델, 야외 거리"처럼 짧게 적어요. 비워두면 화이트 스튜디오로 만들어요.' },
        { title: '모델컷 받기', desc: '약 30초 뒤 고해상도 모델컷을 저장하고 바로 써요.' }
      ],
      tipsTitle: '잘 나오는 옷 사진 팁',
      tips: ['옷 전체가 잘리지 않게 찍어 주세요.', '밝은 곳에서, 주름은 최대한 펴서 찍어 주세요.', '한 장에 옷 한 벌만 나오게 해 주세요.', '로고·프린트가 있으면 정면에서 또렷하게 찍어 주세요.'],
      crossSellTitle: '모델컷으로 상세페이지까지',
      crossSellDesc: '만든 모델컷을 AI 상세페이지 생성기에 넣으면 쇼핑몰 상세페이지 초안까지 한 번에 만들 수 있어요.',
      crossSellCta: 'AI 상세페이지 생성기 열기',
      faqTitle: 'AI 모델컷 FAQ',
      faq: [
        { q: '어떤 옷 사진을 올리면 되나요?', a: '옷 전체가 잘 보이는 바닥컷, 행거컷, 마네킹컷이 가장 안정적입니다. 주름이 적고 밝은 사진일수록 좋습니다.' },
        { q: '옷의 색상이나 로고가 바뀌지 않나요?', a: '색상·패턴·로고·디테일을 그대로 유지하도록 설계되어 있지만, 작은 글씨나 복잡한 프린트는 일부 달라질 수 있어 확인 후 사용하세요.' },
        { q: '모델 성별이나 배경을 정할 수 있나요?', a: '네. "남성 모델, 야외 거리 배경"처럼 짧게 입력하면 반영됩니다. 비워두면 화이트 스튜디오 룩북 스타일로 생성됩니다.' },
        { q: '만든 모델컷을 쇼핑몰에 써도 되나요?', a: '네. 직접 판매하는 상품의 상세페이지·광고 이미지로 활용할 수 있습니다. 실제 상품과 다르게 보이지 않는지 꼭 확인해 주세요.' }
      ]
    }
  : {
      title: 'AI Model Shot Generator | Turn Clothing Photos into Model Shots | ManyTool',
      description: 'Upload one clothing photo (flat lay, hanger or mannequin) and get an e-commerce model shot or a try-on outfit shot of an AI model wearing it. No model booking, no photo shoot.',
      keywords: 'AI model shot, AI fashion model generator, clothing on model AI, virtual try-on, AI lookbook, product photo to model',
      eyebrow: 'AI MODEL SHOT',
      intro: 'Upload just the clothes and get a photo of a model wearing them. No model, no shoot.',
      promoEyebrow: 'Just the clothes',
      promoTitle: 'One clothing photo is all it takes',
      promoDesc: 'Flat lays, hanger shots and mannequin photos all work. Colors, patterns and logos are kept as they are.',
      before: 'Clothing photo',
      after: 'AI model shot',
      soon: 'Sample coming soon',
      useCases: {
        shop: {
          badge: 'For sellers',
          title: 'Model shots ready to sell in your online store',
          desc: 'Clean white-studio lookbook shots you can drop straight into product pages. No shoot for every new arrival.',
          points: ['No model or studio costs', 'White-background lookbook by default', 'Ask for a male/female model or an outdoor scene']
        },
        tryon: {
          badge: 'For shoppers',
          title: 'Try-on shots without trying it on',
          desc: 'Let an AI model wear the clothes you want to buy or already own, and preview the fit, length and overall vibe.',
          points: ['Preview fit and length', 'Ask for "woman in her 20s, casual styling"', 'Check the look before you buy']
        }
      },
      stepsTitle: 'How it works',
      steps: [
        { title: 'Upload a clothing photo', desc: 'One photo where the whole garment is visible.' },
        { title: 'Model & background (optional)', desc: 'Write something short like "male model, outdoor street". Leave it empty for a white studio.' },
        { title: 'Get your model shot', desc: 'Save the high-resolution result in about 30 seconds.' }
      ],
      tipsTitle: 'Tips for a good clothing photo',
      tips: ['Keep the whole garment in frame.', 'Shoot in bright light and smooth out wrinkles.', 'One garment per photo.', 'Photograph logos and prints straight on.'],
      crossSellTitle: 'From model shot to product page',
      crossSellDesc: 'Feed your model shots into the AI Product Detail Studio to draft a full store product page.',
      crossSellCta: 'Open AI Product Detail Studio',
      faqTitle: 'AI Model Shot FAQ',
      faq: [
        { q: 'What kind of clothing photo works best?', a: 'A flat lay, hanger, or mannequin shot where the whole garment is clearly visible, well lit, and not heavily wrinkled.' },
        { q: 'Will the color or logo change?', a: 'The tool is built to keep color, pattern, logos, and details, but small text or complex prints can drift, so review before publishing.' },
        { q: 'Can I choose the model or background?', a: 'Yes. Add a short request like "male model, outdoor street". Leave it empty for a clean white studio lookbook.' },
        { q: 'Can I use the shots in my store?', a: 'Yes, for products you sell. Always check that the image represents the real product accurately.' }
      ]
    };

const useCaseOrder: ModelCutUseCase[] = ['shop', 'tryon'];
const slotsFor = (useCase: ModelCutUseCase) => {
  const samples = modelCutSamplesFor(useCase);
  const empty = Math.max(0, MODEL_CUT_SLOTS_PER_USE_CASE - samples.length);
  return { samples, empty };
};
const heroImageUrls = MODEL_CUT_SAMPLES.map((sample) => sample.model);
const detailStudioHref = isKo ? '/tools/product-detail-studio' : '/en/tools/product-detail-studio';
---

<Layout title={copy.title} description={copy.description} keywords={copy.keywords}>
  <Header />
  <main class="mx-auto max-w-7xl px-4 py-8">
    <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-stone-500">{copy.eyebrow}</p>
      <p class="mt-2 max-w-4xl text-lg font-bold leading-8 text-slate-800">{copy.intro}</p>
    </section>
    <AdsterraBanner placement="top" />

    <AiImageGenerator client:load locale={locale} initialMode="modelcut" lockMode heroImageUrls={heroImageUrls} />

    <section class="mt-8 overflow-hidden rounded-[2rem] border border-stone-200 bg-gradient-to-br from-stone-900 via-stone-800 to-amber-900 p-6 text-white shadow-sm sm:p-10">
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-amber-200">{copy.promoEyebrow}</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">{copy.promoTitle}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-stone-200">{copy.promoDesc}</p>
    </section>

    {useCaseOrder.map((useCase) => {
      const content = copy.useCases[useCase];
      const { samples, empty } = slotsFor(useCase);
      return (
        <section class="mt-6 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.6fr)] lg:items-start">
            <div>
              <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">{content.badge}</span>
              <h2 class="mt-3 text-2xl font-black leading-snug tracking-tight text-slate-900">{content.title}</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">{content.desc}</p>
              <ul class="mt-4 space-y-2">
                {content.points.map((point) => (
                  <li class="flex items-start gap-2 text-sm font-semibold text-slate-700">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
              {samples.map((sample) => (
                <figure class="overflow-hidden rounded-[1.4rem] border border-slate-200 bg-slate-50">
                  <div class="grid grid-cols-2 gap-px bg-slate-200">
                    <div class="relative bg-white">
                      <img src={sample.garment} alt={`${isKo ? sample.label : sample.labelEn} ${copy.before}`} loading="lazy" class="aspect-[3/4] w-full object-cover" />
                      <span class="absolute left-2 top-2 rounded-full bg-white/90 px-2 py-0.5 text-[10px] font-bold text-slate-600 shadow-sm">{copy.before}</span>
                    </div>
                    <div class="relative bg-white">
                      <img src={sample.model} alt={`${isKo ? sample.label : sample.labelEn} ${copy.after}`} loading="lazy" class="aspect-[3/4] w-full object-cover object-top" />
                      <span class="absolute left-2 top-2 rounded-full bg-stone-900/85 px-2 py-0.5 text-[10px] font-bold text-white shadow-sm">{copy.after}</span>
                    </div>
                  </div>
                  <figcaption class="px-3 py-2 text-xs font-semibold text-slate-600">{isKo ? sample.label : sample.labelEn}</figcaption>
                </figure>
              ))}
              {Array.from({ length: empty }).map(() => (
                <div class="flex min-h-[220px] flex-col items-center justify-center rounded-[1.4rem] border-2 border-dashed border-slate-200 bg-slate-50 p-4 text-center">
                  <span class="text-2xl" aria-hidden="true">👕 → 🧍</span>
                  <span class="mt-2 text-xs font-bold text-slate-400">{copy.soon}</span>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">{copy.stepsTitle}</h2>
        <ol class="mt-4 space-y-3">
          {copy.steps.map((step, index) => (
            <li class="flex gap-3 rounded-[1.3rem] border border-slate-200 bg-slate-50 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-stone-900 text-sm font-black text-white">{index + 1}</span>
              <div>
                <h3 class="text-base font-black text-slate-900">{step.title}</h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-black tracking-tight text-slate-900">{copy.tipsTitle}</h2>
        <ul class="mt-4 space-y-3">
          {copy.tips.map((tip) => (
            <li class="rounded-[1.3rem] border border-slate-200 bg-slate-50 p-4 text-sm font-semibold leading-6 text-slate-700">✓ {tip}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-6 flex flex-col items-start justify-between gap-4 rounded-[2rem] border border-rose-200 bg-rose-50 p-6 shadow-sm sm:flex-row sm:items-center">
      <div>
        <h2 class="text-xl font-black tracking-tight text-slate-900">{copy.crossSellTitle}</h2>
        <p class="mt-1 text-sm leading-6 text-slate-600">{copy.crossSellDesc}</p>
      </div>
      <a href={detailStudioHref} class="shrink-0 rounded-full bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-700">{copy.crossSellCta}</a>
    </section>

    <section class="mt-6 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-black tracking-tight text-slate-900">{copy.faqTitle}</h2>
      <div class="mt-4 space-y-4">
        {copy.faq.map((item) => (
          <article class="rounded-[1.3rem] border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-base font-black text-slate-900">{item.q}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.a}</p>
          </article>
        ))}
      </div>
    </section>
    <AdsterraBanner placement="bottom" />
  </main>
  <Footer />
</Layout>
