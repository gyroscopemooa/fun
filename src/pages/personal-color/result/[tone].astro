---
import SharedResultLayout from '../../../components/share/SharedResultLayout.astro';
import { TONES, TONE_MAP, readableText, type ToneId } from '../../../lib/personal-color-tones';

export const getStaticPaths = () => TONES.map((t) => ({ params: { tone: t.id } }));

const tone = TONE_MAP[Astro.params.tone as ToneId];
const main = tone.best[0].hex;
const makeup = [
  { label: '립', swatch: tone.lip },
  { label: '블러셔', swatch: tone.blush },
  { label: '아이', swatch: tone.eye }
];
---

<SharedResultLayout
  title={`${tone.label} (${tone.english}) | 퍼스널컬러 결과 | ManyTool`}
  description={`${tone.tagline}. 베스트 컬러와 립·헤어 컬러까지, 나의 퍼스널컬러도 무료로 확인해 보세요.`}
  image={`/og/personal-color/${tone.id}.jpg`}
  ctaHref="/personal-color"
  ctaLabel="나도 퍼스널컬러 진단하기 →"
  testName="퍼스널컬러"
  accent="#0f172a"
>
  <div slot="card" class="mx-auto max-w-full overflow-auto rounded-[22px] shadow-xl max-[419px]:[zoom:0.8]">
    <div class="flex h-[480px] w-[360px] flex-col bg-white p-6">
      <div class="flex items-center justify-between text-[11px] font-black tracking-[0.25em] text-slate-500">
        <span>PERSONAL COLOR</span>
        <span>ManyTool</span>
      </div>
      <div class="mt-5 rounded-[20px] p-5" style={`background:${main}; color:${readableText(main)}`}>
        <p class="text-xs font-bold tracking-[0.2em] opacity-70">{tone.english.toUpperCase()}</p>
        <p class="mt-1 text-[34px] font-black leading-tight">{tone.label}</p>
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-600">{tone.tagline}</p>
      <p class="mt-3 text-[11px] font-black text-slate-500">BEST COLORS</p>
      <div class="mt-1.5 grid grid-cols-8 gap-1">
        {tone.best.map((s) => <div class="h-9 rounded-md border border-black/5" style={`background:${s.hex}`} title={s.name}></div>)}
      </div>
      <p class="mt-3 text-[11px] font-black text-slate-500">MAKEUP</p>
      <div class="mt-1.5 grid grid-cols-3 gap-2">
        {makeup.map((m) => (
          <div class="flex items-center gap-1.5">
            <span class="h-6 w-6 rounded-full border border-black/5" style={`background:${m.swatch.hex}`}></span>
            <span class="text-[11px] font-bold text-slate-600">{m.label} · {m.swatch.name}</span>
          </div>
        ))}
      </div>
      <p class="mt-auto text-right text-[10px] font-bold text-slate-400">manytool.net/personal-color</p>
    </div>
  </div>
  <h1 class="text-2xl font-black text-slate-900">{tone.label} <span class="text-base font-bold text-slate-400">{tone.english}</span></h1>
  <p class="leading-6">{tone.tagline}</p>
  <div class="rounded-2xl border border-slate-200 bg-white p-3">
    <p class="font-black text-slate-900">🎨 베스트 컬러</p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {tone.best.map((s) => (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2 py-1 text-xs font-bold text-slate-700 shadow-sm"><span class="h-3.5 w-3.5 rounded-full" style={`background:${s.hex}`}></span>{s.name}</span>
      ))}
    </div>
    <p class="mt-3 font-black text-slate-900">🚫 피하면 좋은 컬러</p>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {tone.avoid.map((s) => (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-2 py-1 text-xs font-bold text-slate-500 shadow-sm"><span class="h-3.5 w-3.5 rounded-full" style={`background:${s.hex}`}></span>{s.name}</span>
      ))}
    </div>
    <p class="mt-3 font-black text-slate-900">💇 헤어 컬러</p>
    <p class="mt-1">{tone.hair.map((h) => h.name).join(', ')}</p>
  </div>
  <div slot="after" class="grid grid-cols-2 gap-2">
    <a href="/ai-personal-color" class="rounded-xl border border-rose-200 bg-white px-3 py-2.5 text-center text-xs font-bold text-rose-700 hover:bg-rose-50">📷 AI로 정밀 분석</a>
    <a href="/lip-color-simulator" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-center text-xs font-bold text-slate-700 hover:bg-slate-50">💄 립 컬러 입혀보기</a>
  </div>
</SharedResultLayout>
