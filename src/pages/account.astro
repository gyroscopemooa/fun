---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const apiBase = (import.meta.env.PUBLIC_NODE_API_BASE ?? 'http://127.0.0.1:8787').replace(/\/+$/, '');
---
<Layout title="로그인 | ManyTool" description="Google 계정으로 ManyTool에 로그인하세요." noindex>
  <Header />
  <main class="mx-auto max-w-lg px-4 py-16">
    <section class="rounded-3xl border border-slate-200 bg-white p-8">
      <img src="/brand/manytool-96.png" alt="" width="64" height="64" class="mb-5 rounded-2xl" />
      <h1 class="text-2xl font-bold">ManyTool 로그인</h1>
      <p class="mt-3 text-sm leading-6 text-slate-600">Google 계정으로 ManyTool에 로그인하세요. 현재 웹 로그인은 결제 지갑과 연결되지 않으며, 유료 구매나 크레딧 충전을 실행하지 않습니다.</p>
      <div id="account-google" class="mt-6"></div>
      <div id="account-profile" hidden class="mt-6">
        <p id="account-email" class="break-all font-semibold"></p>
        <button id="account-logout" class="mt-4 rounded-xl border px-4 py-2 text-sm">로그아웃</button>
        <button id="account-delete" class="ml-3 mt-4 text-sm text-slate-500 underline">계정 삭제</button>
      </div>
      <p id="account-status" role="status" aria-live="polite" class="mt-4 text-sm leading-6 text-slate-600">로그인 상태를 확인하고 있습니다.</p>
      <a href="/privacy/" class="mt-6 inline-block text-sm font-semibold text-cyan-800 underline">개인정보 처리방침</a>
    </section>
  </main>
  <Footer />
  <script is:inline define:vars={{ apiBase }}>
    (() => {
      const $ = id => document.getElementById(id);
      const call = async (path, body) => {
        const r = await fetch(`/api/auth${path}`, { credentials:'same-origin', signal:AbortSignal.timeout(15000), ...(body !== undefined ? {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)} : {}) });
        const data = await r.json().catch(() => null);
        if (!r.ok || !data) throw Object.assign(new Error(data?.error || '로그인 서비스 연결을 준비하고 있습니다.'), {status:r.status});
        return data;
      };
      const showSession = async () => {
        try {
          const me = await call('/me');
          $('account-email').textContent = me.email;
          $('account-profile').hidden = false;
          $('account-google').hidden = true;
          $('account-status').textContent = '로그인되었습니다.';
          return true;
        } catch (e) { if (e.status !== 401) throw e; return false; }
      };
      const login = async () => {
        $('account-profile').hidden = true;
        $('account-google').hidden = false;
        $('account-google').replaceChildren();
        if (await showSession()) return;
        if (/ManytoolAndroid/.test(navigator.userAgent)) throw new Error('앱 계정 연결은 준비 중입니다. 웹 브라우저에서 로그인해주세요.');
        const config = await call('/config');
        if (!config.googleClientId) throw new Error('구글 로그인 설정을 준비하고 있습니다.');
        const challenge = await call('/challenge', {});
        if (!window.google?.accounts?.id) await new Promise((resolve,reject) => {
          const s=document.createElement('script');s.src='https://accounts.google.com/gsi/client';s.onload=resolve;s.onerror=()=>reject(new Error('Google 로그인을 불러오지 못했습니다.'));document.head.append(s);
        });
        window.google.accounts.id.initialize({client_id:challenge.clientId,nonce:challenge.nonce,auto_select:false,callback:async result => {
          try { await call('/session',{credential:result.credential});await showSession(); }
          catch(e) { await login().catch(()=>{});$('account-status').textContent=e.message; }
        }});
        window.google.accounts.id.renderButton($('account-google'),{type:'standard',theme:'outline',size:'large',text:'signin_with',locale:document.documentElement.lang});
        $('account-status').textContent='로그인할 Google 계정을 선택해주세요.';
      };
      $('account-logout').onclick = async () => {
        try { await call('/logout',{});window.google?.accounts?.id?.disableAutoSelect();await login(); }
        catch(e) { $('account-status').textContent=e.message; }
      };
      $('account-delete').onclick = async () => {
        if (!confirm('ManyTool Google 계정 정보와 모든 웹 로그인 세션을 삭제할까요? 기존 결제·크레딧 기록은 별도 고객지원에서 처리합니다.')) return;
        try { await call('/delete',{});window.google?.accounts?.id?.disableAutoSelect();await login();$('account-status').textContent='계정과 로그인 세션을 삭제했습니다.'; }
        catch(e) { $('account-status').textContent=e.message; }
      };
      login().catch(e => { $('account-status').textContent=e.message; });
    })();
  </script>
</Layout>
