  <style is:global>
    .home-card-track { display:flex; gap:12px; overflow-x:auto; scrollbar-width:none; scroll-behavior:auto; overflow-anchor:none; }
    .home-card-track::-webkit-scrollbar { display:none; }
    .home-tool-card { width: min(72vw, 280px); }
    .home-card-nav { display:flex; align-items:center; justify-content:center; width:32px; height:40px; flex-shrink:0; border:1px solid #e0f2fe; border-radius:999px; background:white; color:#0ea5e9; font-size:22px; }
    .home-card-nav:disabled { opacity:.35; }
    [data-search-result][hidden] { display:none; }
    .home-search-layout { display:flex; align-items:center; gap:8px; }
    .home-search-layout[hidden] { display:none; }
    .home-search-track { display:flex; flex:1; min-width:0; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
    .home-search-track::-webkit-scrollbar { display:none; }
    .home-search-track > article { flex:0 0 100%; min-width:0; scroll-snap-align:start; overflow-wrap:anywhere; }
    .home-search-nav { display:flex; flex-shrink:0; width:44px; height:44px; align-items:center; justify-content:center; border:1px solid #bae6fd; border-radius:999px; background:#fff; color:#0284c7; font-size:26px; touch-action:manipulation; }
    .home-search-nav:disabled { color:#94a3b8; border-color:#e2e8f0; opacity:.55; }
    .home-search-nav:focus-visible { outline:3px solid #0ea5e9; outline-offset:2px; }
    @media(min-width:640px) { .home-search-layout { display:block; } .home-search-nav { display:none; } .home-search-track { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); overflow:visible; } }
    @media(min-width:1024px) { .home-search-track { grid-template-columns:repeat(3,minmax(0,1fr)); } }
    @media(min-width:640px) { .home-tool-card { width:230px; } .home-card-nav { width:40px; } }
  </style>

  <script is:inline define:vars={{ apiBase, donateButtonLabel: t.guideDonate, donateText: t }}>
    const homeDonateButton = document.getElementById('home-donate-button');
    const homeDonateMessage = document.getElementById('home-donate-message');
    const trendingCardListEl = document.getElementById('trending-card-list');
    const trendingCardStatusEl = document.getElementById('trending-card-status');
    const trendingCardUpdatedEl = document.getElementById('trending-card-updated');

    const renderTrendCards = (items) => {
      if (!(trendingCardListEl instanceof HTMLElement)) return;
      trendingCardListEl.innerHTML = '';
      items.forEach((item) => {
        const link = document.createElement('a');
        link.href = `https://www.google.com/search?q=${encodeURIComponent(item.title)}`;
        link.target = '_blank';
        link.rel = 'nofollow noopener noreferrer';
        link.className = 'group flex items-center gap-3 rounded-xl px-2 py-2 transition hover:bg-slate-50';
        link.innerHTML = `
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-[11px] font-bold text-white">#${item.rank}</div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-slate-800 group-hover:text-sky-700">${item.title}</p>
          </div>
          <div class="shrink-0 text-[11px] text-slate-400">${item.traffic || ''}</div>
          <div class="shrink-0 text-slate-300">›</div>
        `;
        trendingCardListEl.append(link);
      });
    };

    const renderTrendUpdated = (updatedAt) => {
      if (!(trendingCardUpdatedEl instanceof HTMLElement)) return;
      const d = new Date(updatedAt || Date.now());
      if (Number.isNaN(d.getTime())) {
        trendingCardUpdatedEl.textContent = '';
        return;
      }
      trendingCardUpdatedEl.textContent = `${donateText.trendingUpdated}: ${d.toLocaleString()}`;
    };

    const loadTrends = async () => {
      if (trendingCardStatusEl instanceof HTMLElement) trendingCardStatusEl.textContent = donateText.trendingLoading;
      try {
        const hl = document.documentElement.lang?.startsWith('ja')
          ? 'ja'
          : document.documentElement.lang?.startsWith('en')
            ? 'en-US'
            : 'ko';
        const res = await fetch(`/api/trending?geo=KR&hl=${encodeURIComponent(hl)}&limit=10`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`status ${res.status}`);
        const data = await res.json();
        if (!Array.isArray(data.items) || data.items.length === 0) throw new Error('empty');
        renderTrendCards(data.items);
        renderTrendUpdated(data.updatedAt);
        if (trendingCardStatusEl instanceof HTMLElement) trendingCardStatusEl.textContent = '';
      } catch {
        if (trendingCardStatusEl instanceof HTMLElement) trendingCardStatusEl.textContent = donateText.trendingError;
        if (trendingCardUpdatedEl instanceof HTMLElement) trendingCardUpdatedEl.textContent = '';
      }
    };

    loadTrends();

    homeDonateButton?.addEventListener('click', async () => {
      if (!apiBase) {
        if (homeDonateMessage) homeDonateMessage.textContent = donateText.donateUnavailable;
        return;
      }

      homeDonateButton.disabled = true;
      homeDonateButton.textContent = donateText.donateLoading;
      if (homeDonateMessage) homeDonateMessage.textContent = '';

      try {
        const configResponse = await fetch(`${apiBase}/config`);
        const configPayload = await configResponse.json().catch(() => null);
        if (!configResponse.ok || !configPayload?.paymentProducts?.donation) {
          throw new Error(donateText.donateUnavailable);
        }

        const currentUrl = window.location.href;
        const checkoutResponse = await fetch(`${apiBase}/checkout`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            productType: 'donation',
            amount: 100,
            currency: 'USD',
            successUrl: currentUrl,
            returnUrl: currentUrl
          })
        });
        const checkoutPayload = await checkoutResponse.json().catch(() => null);
        if (!checkoutResponse.ok || !checkoutPayload?.checkoutUrl) {
          throw new Error(checkoutPayload?.error || donateText.donateFailed);
        }

        window.location.href = checkoutPayload.checkoutUrl;
      } catch (error) {
        if (homeDonateMessage) {
          homeDonateMessage.textContent = error instanceof Error ? error.message : donateText.donateFailed;
        }
        homeDonateButton.disabled = false;
        homeDonateButton.textContent = donateButtonLabel;
      }
    });

    
  </script>

  <script is:inline define:vars={{ locale, strippedPath, supportedLocales: seoLocaleCodes }}>
    const languageStorageKey = 'manytool-locale';
    const localePath = (nextLocale) => {
      const path = strippedPath === '/' ? '' : strippedPath;
      return nextLocale === 'ko' ? (path || '/') : `/${nextLocale}${path || '/'}`;
    };
    const localePrefixPattern = new RegExp(`^/(${supportedLocales.filter((code) => code !== 'ko').join('|')})(?:/|$)`);

    document.querySelectorAll('header a[href]').forEach((link) => {
      const href = link.getAttribute('href') || '';
      const match = href.match(localePrefixPattern);
      const nextLocale = match ? match[1] : href.startsWith('/') ? 'ko' : null;
      if (nextLocale && supportedLocales.includes(nextLocale)) {
        link.addEventListener('click', () => localStorage.setItem(languageStorageKey, nextLocale));
      }
    });

    const isCanonicalKoreanPath = locale === 'ko' && !location.pathname.match(localePrefixPattern);
    if (isCanonicalKoreanPath && !localStorage.getItem(languageStorageKey)) {
      const browserLocale = (navigator.languages || [navigator.language || 'ko'])
        .map((value) => value.toLowerCase().split('-')[0])
        .find((value) => supportedLocales.includes(value));
      if (browserLocale && browserLocale !== 'ko') {
        location.replace(localePath(browserLocale));
      } else {
        fetch('/api/locale', { headers: { Accept: 'application/json' } })
          .then((response) => response.ok ? response.json() : null)
          .then((data) => {
            const detectedLocale = data?.locale;
            if (detectedLocale && supportedLocales.includes(detectedLocale) && detectedLocale !== 'ko') {
              location.replace(localePath(detectedLocale));
            }
          })
          .catch(() => undefined);
      }
    }
  </script>

