---
import Layout from '../layouts/Layout.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Recommend from '../components/Recommend.astro';
const questions = [
  { area: '강가의 굽은 길', answer: '미드 강가', hint: '라인과 강이 만나는 길목입니다.', shape: 'M-20 220 C90 110 150 210 250 110 S410 60 540 -10' },
  { area: '붉은 바위와 좁은 입구', answer: '레드 버프', hint: '두꺼운 벽과 작은 캠프 공간이 특징입니다.', shape: 'M40 35 l90 30 35 70 -55 80 -85 -35z M240 -20 l100 75 -15 80 -80 20 -45 -65z' },
  { area: '푸른 웅덩이와 바위섬', answer: '블루 버프', hint: '정글 안쪽의 물가와 둥근 바위가 보입니다.', shape: 'M-10 85 C75 35 160 70 205 125 S330 235 550 160' },
  { area: '삼거리와 높은 벽', answer: '탑 1차 포탑 앞', hint: '라인이 갈라지는 진입로입니다.', shape: 'M255 -20 L270 320 M-20 155 C120 145 165 125 265 150 S420 180 560 155' },
  { area: '용의 둥지 입구', answer: '드래곤 앞 강', hint: '강에서 둥지로 내려가는 좁은 경사로입니다.', shape: 'M-20 230 C90 175 150 210 230 145 S380 65 560 95' }
];
---
<Layout title="롤 지형 맞히기 | ManyTool" description="리그 오브 레전드 지형 일부를 보고 위치를 맞히는 4지선다 퀴즈입니다.">
  <Header /><main class="mx-auto max-w-5xl px-4 py-8">
    <section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">League of Legends Quiz</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">롤 지형 맞히기</h1><p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base">맵의 일부만 보고 이곳이 어디인지 맞혀보세요. 5문제 4지선다입니다.</p></section>
    <AdsterraBanner placement="top" />
    <section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-5 shadow-sm sm:p-8"><div class="flex justify-between"><span id="progress" class="text-sm font-bold text-cyan-700"></span><span id="score" class="text-sm font-bold text-slate-500">점수 0점</span></div><div class="mt-4 h-2 rounded-full bg-slate-100"><div id="bar" class="h-full rounded-full bg-cyan-500"></div></div><div id="quiz" class="mt-8"><div class="mx-auto max-w-2xl overflow-hidden rounded-3xl bg-[#173b35]"><svg viewBox="0 0 540 300" class="block aspect-[1.8] w-full" role="img" aria-label="리그 오브 레전드 지형 일부"><rect width="540" height="300" fill="#1d493d"/><path d="M0 260 Q110 210 210 260 T540 235 V300 H0Z" fill="#255445"/><path id="shape" d="" fill="none" stroke="#9bd2a7" stroke-width="24" stroke-linecap="round"/><path d="M70 70 l70 35 20 55 -70 55 -60 -45z M390 220 l80 -45 60 65 -55 50z" fill="none" stroke="#d2f0b1" stroke-width="6" opacity=".8"/><circle cx="290" cy="120" r="28" fill="#e9c46a" opacity=".85"/></svg></div><p id="area" class="mt-5 text-center text-xs font-bold uppercase tracking-[0.2em] text-cyan-600"></p><h2 class="mt-2 text-center text-2xl font-black text-slate-950">이곳은 어디일까요?</h2><div id="choices" class="mx-auto mt-6 grid max-w-2xl gap-3 sm:grid-cols-2"></div><p id="feedback" class="mt-5 min-h-6 text-center text-sm font-semibold"></p></div><div id="result" class="hidden py-14 text-center"><div class="text-6xl">🏆</div><h2 id="final" class="mt-5 text-4xl font-black text-slate-950"></h2><button id="restart" class="mt-7 rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white">다시 하기</button></div></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer />
</Layout>
<script is:inline define:vars={{ questions }}>
  const $ = (id) => document.getElementById(id); let index = 0; let score = 0; let locked = false; const shuffle = (a) => [...a].sort(() => Math.random() - .5);
  function render() { const q = questions[index]; locked = false; $('progress').textContent = `${index + 1} / ${questions.length}`; $('score').textContent = `점수 ${score}점`; $('bar').style.width = `${(index + 1) * 20}%`; $('area').textContent = q.area; $('feedback').textContent = ''; $('shape').setAttribute('d', q.shape); const answers = shuffle([q.answer, ...shuffle(questions.filter((x) => x.answer !== q.answer)).slice(0, 3).map((x) => x.answer)]); $('choices').innerHTML = answers.map((a, i) => `<button type="button" data-answer="${a}" class="choice rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 text-left text-sm font-bold text-slate-700 hover:border-cyan-400 hover:bg-cyan-50"><span class="mr-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-white text-xs text-slate-400">${String.fromCharCode(65 + i)}</span>${a}</button>`).join(''); document.querySelectorAll('.choice').forEach((b) => b.addEventListener('click', () => choose(b))); }
  function choose(button) { if (locked) return; locked = true; const ok = button.dataset.answer === questions[index].answer; if (ok) { score += 20; button.classList.add('border-emerald-400', 'bg-emerald-50'); $('feedback').textContent = `정답! ${questions[index].hint}`; $('feedback').className = 'mt-5 min-h-6 text-center text-sm font-semibold text-emerald-600'; } else { button.classList.add('border-rose-400', 'bg-rose-50'); $('feedback').textContent = `아쉬워요. 정답은 ${questions[index].answer}입니다.`; $('feedback').className = 'mt-5 min-h-6 text-center text-sm font-semibold text-rose-600'; } $('score').textContent = `점수 ${score}점`; setTimeout(() => { index++; if (index < questions.length) render(); else { $('quiz').classList.add('hidden'); $('result').classList.remove('hidden'); $('final').textContent = `${score}점 / 100점`; } }, 900); }
  $('restart').addEventListener('click', () => { index = 0; score = 0; $('result').classList.add('hidden'); $('quiz').classList.remove('hidden'); render(); }); render();
</script>
