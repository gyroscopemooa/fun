---
import NicepayReviewOffer from '../components/NicepayReviewOffer.astro';
import AiImageGenerator from '../components/home/AiImageGenerator';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const seoLinks = [
  { href: '/ai-image-generator/figure', label: 'AI Figure' },
  { href: '/ai-image-generator/body-profile', label: 'AI Body Profile' },
  { href: '/ai-image-generator/travel-background', label: 'AI Travel Background' },
  { href: '/ai-image-generator/europe-style', label: 'AI Europe Style' },
  { href: '/ai-image-generator/snapshot', label: 'AI Snapshot' },
  { href: '/ai-image-generator/instagram-photo', label: 'AI Instagram Photo' },
  { href: '/ai-image-generator/hanbok', label: 'AI Hanbok' },
  { href: '/ai-image-generator/kimono', label: 'AI Kimono' },
  { href: '/ai-image-generator/outfit-change', label: 'AI Outfit Change' },
  { href: '/ai-image-generator/streamer-promo', label: 'AI Streamer Promo' },
  { href: '/ai-image-generator/pet-humanizer', label: 'AI Pet Humanizer' },
  { href: '/ai-image-generator/hairstyle', label: 'AI Hairstyle' },
  { href: '/ai-image-generator/interior', label: 'AI Interior' },
  { href: '/ai-image-generator/animation', label: 'AI Animation' },
  { href: '/ai-model-cut', label: 'AI 상품으로 모델 만들기' },
  { href: '/ai-image-generator/free-style', label: 'AI Free Style' }
];
---

<Layout
  title="AI 이미지 생성기 | 피규어, 바디프로필, 여행 배경, 인스타 스타일 | ManyTool"
  description="사진 한 장으로 AI 피규어, 바디프로필, 해외여행 배경, 유럽여행 스타일, 인스타 사진, 한복/기모노 스타일, 의상변경 이미지를 생성하세요."
  keywords="AI 이미지 생성기, AI 피규어 만들기, AI 바디프로필, AI 여행 배경, AI 유럽여행 스타일, AI 인스타 사진, AI 한복 스타일, AI 기모노 스타일, AI 의상변경"
>
  <Header />
  <main>
    <section class="mx-auto max-w-6xl px-4 pt-4 sm:pt-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:rounded-[2rem] sm:p-6">
        <h2 class="text-base font-black tracking-tight text-slate-900 sm:text-xl">AI 스타일별 전용 페이지</h2>
        <p class="mt-1 hidden text-sm leading-6 text-slate-600 sm:mt-2 sm:block">세부 키워드는 아래 전용 URL에서도 바로 확인할 수 있습니다.</p>
        <div class="mt-2 flex gap-2 overflow-x-auto pb-1 sm:mt-4 sm:flex-wrap sm:gap-3 sm:overflow-visible sm:pb-0">
          {seoLinks.map((item) => (
            <a href={item.href} class="shrink-0 whitespace-nowrap rounded-full border border-slate-300 bg-slate-50 px-3 py-1.5 text-xs font-semibold sm:px-4 sm:py-2 sm:text-sm text-slate-700 transition hover:border-slate-900 hover:bg-white hover:text-slate-950">
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>
    <div class="mx-auto max-w-6xl px-4">
      <AdsterraBanner placement="top" />
    </div>
    <AiImageGenerator client:load locale="ko" />
    <div class="mx-auto max-w-6xl px-4 pb-8">
      <AdsterraBanner placement="bottom" />
    </div>
  <NicepayReviewOffer product="image" />
  </main>
  <Footer />
</Layout>
