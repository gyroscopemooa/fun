---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
---
<Layout title="파일명 일괄 변경기 | 여러 파일 이름 바꾸기 | ManyTool" description="여러 파일의 이름에 접두사와 번호를 한 번에 붙이는 무료 파일명 변경 도구입니다." keywords="파일명 일괄 변경, 파일 이름 한꺼번에 바꾸기, 파일명 변경"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">File Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">파일명 일괄 변경기</h1><p class="mt-3 text-sm leading-7 text-slate-300">선택한 파일의 이름 앞에 원하는 접두사와 번호를 붙여 다운로드합니다.</p></section><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm"><input id="files" type="file" multiple class="block w-full rounded-2xl border border-slate-300 p-4 text-sm"/><input id="prefix" placeholder="예: 여행사진" class="mt-4 w-full rounded-xl border p-3"/><button id="run" class="mt-6 rounded-2xl bg-cyan-500 px-5 py-3 font-bold">이름 바꿔 다운로드</button><p id="result" class="mt-5 text-sm text-slate-600"></p></section><Recommend /></main><Footer /></Layout>
<script is:inline>const files=document.getElementById('files'),prefix=document.getElementById('prefix'),o=document.getElementById('result');document.getElementById('run').onclick=()=>{if(!files.files.length){o.textContent='파일을 선택해주세요.';return}[...files.files].forEach((f,i)=>{const a=document.createElement('a');a.href=URL.createObjectURL(f);a.download=`${prefix.value||'file'}-${String(i+1).padStart(3,'0')}${f.name.match(/\.[^.]+$/)?.[0]||''}`;a.click()});o.textContent=`${files.files.length}개 파일의 다운로드를 시작했습니다.`};</script>
