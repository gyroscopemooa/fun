---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { seoLocaleCodes } from '../../lib/i18n';
const copy = {
  zh: ['昵称生成器', '输入关键词，生成适合游戏和社交账号的昵称。', '关键词', '例如：月亮、猫、速度', '生成昵称', '请输入关键词。'],
  es: ['Generador de apodos', 'Crea apodos para juegos y perfiles sociales a partir de una palabra.', 'Palabra clave', 'Ejemplo: luna, gato, velocidad', 'Generar apodos', 'Escribe una palabra clave.'],
  de: ['Nickname-Generator', 'Erstelle Nicknames für Spiele und soziale Profile aus einem Stichwort.', 'Stichwort', 'Beispiel: Mond, Katze, Tempo', 'Nicknames generieren', 'Gib ein Stichwort ein.'],
  fr: ['Générateur de pseudos', 'Créez des pseudos pour les jeux et les profils sociaux à partir d’un mot.', 'Mot-clé', 'Exemple : lune, chat, vitesse', 'Générer des pseudos', 'Saisissez un mot-clé.'],
  pt: ['Gerador de apelidos', 'Crie apelidos para jogos e perfis sociais usando uma palavra-chave.', 'Palavra-chave', 'Exemplo: lua, gato, velocidade', 'Gerar apelidos', 'Digite uma palavra-chave.'],
  vi: ['Trình tạo biệt danh', 'Tạo biệt danh cho game và mạng xã hội từ một từ khóa.', 'Từ khóa', 'Ví dụ: mặt trăng, mèo, tốc độ', 'Tạo biệt danh', 'Hãy nhập từ khóa.'],
  id: ['Generator nama panggilan', 'Buat nama panggilan untuk game dan profil sosial dari sebuah kata kunci.', 'Kata kunci', 'Contoh: bulan, kucing, cepat', 'Buat nama panggilan', 'Masukkan kata kunci.'],
  it: ['Generatore di soprannomi', 'Crea soprannomi per giochi e profili social partendo da una parola chiave.', 'Parola chiave', 'Esempio: luna, gatto, velocità', 'Genera soprannomi', 'Inserisci una parola chiave.'],
  nl: ['Bijnaamgenerator', 'Maak bijnamen voor games en sociale profielen met een trefwoord.', 'Trefwoord', 'Voorbeeld: maan, kat, snelheid', 'Bijnamen genereren', 'Voer een trefwoord in.'],
  ru: ['Генератор никнеймов', 'Создавайте ники для игр и социальных профилей по ключевому слову.', 'Ключевое слово', 'Пример: луна, кот, скорость', 'Создать никнеймы', 'Введите ключевое слово.'],
  ar: ['مولد الألقاب', 'أنشئ ألقاباً للألعاب والملفات الاجتماعية باستخدام كلمة مفتاحية.', 'الكلمة المفتاحية', 'مثال: قمر، قطة، سرعة', 'إنشاء ألقاب', 'أدخل كلمة مفتاحية.'],
  hi: ['निकनेम जनरेटर', 'कीवर्ड से गेम और सोशल प्रोफ़ाइल के लिए निकनेम बनाएं।', 'कीवर्ड', 'उदाहरण: चांद, बिल्ली, गति', 'निकनेम बनाएं', 'कीवर्ड लिखें।'],
  tr: ['Takma ad üretici', 'Bir anahtar kelimeden oyun ve sosyal profil takma adları oluşturun.', 'Anahtar kelime', 'Örnek: ay, kedi, hız', 'Takma ad üret', 'Bir anahtar kelime girin.'],
  pl: ['Generator pseudonimów', 'Twórz pseudonimy do gier i profili społecznościowych na podstawie słowa kluczowego.', 'Słowo kluczowe', 'Przykład: księżyc, kot, szybkość', 'Generuj pseudonimy', 'Wpisz słowo kluczowe.'],
  th: ['เครื่องสร้างชื่อเล่น', 'สร้างชื่อเล่นสำหรับเกมและโปรไฟล์โซเชียลจากคีย์เวิร์ด', 'คีย์เวิร์ด', 'ตัวอย่าง: พระจันทร์ แมว ความเร็ว', 'สร้างชื่อเล่น', 'กรุณาป้อนคีย์เวิร์ด'],
  sv: ['Smeknamnsgenerator', 'Skapa smeknamn för spel och sociala profiler från ett nyckelord.', 'Nyckelord', 'Exempel: måne, katt, snabbhet', 'Skapa smeknamn', 'Skriv ett nyckelord.'],
  uk: ['Генератор нікнеймів', 'Створюйте ніки для ігор і соціальних профілів за ключовим словом.', 'Ключове слово', 'Приклад: місяць, кіт, швидкість', 'Створити нікнейми', 'Введіть ключове слово.'],
  en: ['Nickname generator', 'Create nicknames for games and social profiles from a keyword.', 'Keyword', 'Example: moon, cat, speed', 'Generate nicknames', 'Enter a keyword.']
};
export function getStaticPaths() { return seoLocaleCodes.filter((locale) => locale !== 'ko').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props; const text = copy[locale as keyof typeof copy] ?? copy.en;
---
<Layout title={`${text[0]} | ManyTool`} description={text[1]} keywords={`${text[0]}, nickname generator, ManyTool`}><Header /><main class="mx-auto max-w-4xl px-4 py-8"><section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8"><h1 class="text-3xl font-black text-slate-950">{text[0]}</h1><p class="mt-3 text-sm leading-7 text-slate-600">{text[1]}</p><label class="mt-6 block text-sm font-bold text-slate-800">{text[2]}<input id="keyword" class="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3" placeholder={text[3]} /></label><button id="generate" class="mt-4 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">{text[4]}</button><p id="message" class="mt-4 min-h-6 text-sm text-rose-600"></p><div id="result" class="mt-5 grid gap-3 sm:grid-cols-2"></div></section></main><Footer /></Layout>
<script is:inline define:vars={{ text }}>
  const input = document.querySelector('#keyword'); const button = document.querySelector('#generate'); const result = document.querySelector('#result'); const message = document.querySelector('#message');
  button.addEventListener('click', () => { const word = input.value.trim(); if (!word) { message.textContent = text[5]; result.innerHTML = ''; return; } message.textContent = ''; const suffixes = ['Nova', 'Wave', 'Rush', 'Pixel', 'Fox', 'Zen', 'One', 'Vibe']; const values = suffixes.sort(() => Math.random() - .5).slice(0, 6).map((suffix) => `${word}${suffix}`); result.innerHTML = values.map((value) => `<button type="button" class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-left font-bold text-slate-800 hover:border-cyan-400" data-value="${value}">${value}</button>`).join(''); result.querySelectorAll('button').forEach((item) => item.addEventListener('click', () => navigator.clipboard?.writeText(item.dataset.value || ''))); });
</script>
