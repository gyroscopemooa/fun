---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Recommend from '../components/Recommend.astro';
import AdsterraBanner from '../components/ads/AdsterraBanner.astro';
---
<Layout title="유튜브 썸네일 다운로드·사이즈 확인 | ManyTool" description="유튜브 영상 주소를 입력해 썸네일을 확인하고 다운로드하세요. 표준 썸네일 사이즈도 안내합니다." keywords="유튜브 썸네일 다운로드, 유튜브 썸네일 추출, 유튜브 썸네일 사이즈"><Header /><main class="mx-auto max-w-3xl px-4 py-8"><section class="rounded-[28px] bg-slate-950 p-6 text-white sm:p-8"><p class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Creator Tool</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">유튜브 썸네일 도구</h1><p class="mt-3 text-sm leading-7 text-slate-300">유튜브 영상 URL에서 썸네일을 추출하고 권장 크기를 확인하세요.</p></section><AdsterraBanner placement="top" /><section class="mt-6 rounded-[28px] border border-slate-200 bg-white p-6 text-center shadow-sm"><input id="url" placeholder="https://www.youtube.com/watch?v=..." class="w-full rounded-2xl border border-slate-300 p-4"/><button id="run" class="mt-5 rounded-2xl bg-cyan-500 px-5 py-3 font-bold">썸네일 확인</button><div id="result" class="mt-6"></div></section><AdsterraBanner placement="bottom" /><Recommend /></main><Footer /></Layout>
<script is:inline>const u=document.getElementById('url'),o=document.getElementById('result');document.getElementById('run').onclick=()=>{try{const x=new URL(u.value);let id=x.searchParams.get('v');if(!id&&x.hostname.includes('youtu.be'))id=x.pathname.slice(1);if(!id)throw Error();const src=`https://img.youtube.com/vi/${id}/maxresdefault.jpg`;o.innerHTML=`<img src="${src}" alt="유튜브 썸네일" class="mx-auto w-full max-w-xl rounded-2xl border"/><p class="mt-4 text-sm text-slate-500">권장 크기: 1280 × 720px</p><a href="${src}" target="_blank" class="mt-3 inline-block rounded-xl bg-slate-950 px-4 py-3 text-sm font-bold text-white">이미지 열기</a>`}catch(e){o.textContent='유튜브 영상 주소를 확인해주세요.'}};</script>
